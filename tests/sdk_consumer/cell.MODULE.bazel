# What a consumer's upgrade changes: isomer's version, Isomer's Swift SDKs,
# the NDK's API level and rules_android. tools/ci/sdk_smoke writes this file
# for each cell it builds; as committed, the release consumers have now.
bazel_dep(name = "isomer", version = "0.57.1")

_swift = use_extension("@rules_swift//swift:extensions.bzl", "swift")
_swift.android_sdk(
    url = "https://github.com/AttilaTheFun/isomer_hermetic_toolchains/releases/download/isomer-6.4.2.3/swift-6.4.2-RELEASE_android-i18n.artifactbundle.tar.gz",
    sha256 = "b9d31edf5ea51a7a7756d9fbff2627364fac30ad6fd8f29c25abe8f00956cf2c",
)
_swift.wasm_sdk(
    url = "https://github.com/AttilaTheFun/isomer_hermetic_toolchains/releases/download/isomer-6.4.2.3/swift-6.4.2-RELEASE_wasm-i18n.artifactbundle.tar.gz",
    sha256 = "32d49aa8ef4a7f125b9ca24c976a557089c57d30e066881ba4f2edd1390fc19c",
)

_android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
_android.ndk(
    api_level = 23,
    version = "r30",
)

bazel_dep(name = "rules_android", version = "0.6.0")
single_version_override(
    module_name = "rules_android",
    version = "0.6.0",
)
