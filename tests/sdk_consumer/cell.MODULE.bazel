# What a consumer's upgrade changes: isomer's version, Isomer's Swift SDKs,
# the NDK's API level and rules_android. tools/ci/sdk_smoke writes this file
# for each cell it builds; as committed, the release consumers have now.
bazel_dep(name = "isomer", version = "0.57.1")

_swift = use_extension("@rules_swift//swift:extensions.bzl", "swift")
_swift.android_sdk(
    url = "https://github.com/AttilaTheFun/isomer_hermetic_toolchains/releases/download/isomer-6.4.2.4/swift-6.4.2-RELEASE_android-i18n.artifactbundle.tar.gz",
    sha256 = "dfe6095d83fe478590730ce5ce55cb25e7c6a99b97f868d2cde14702ea787907",
)
_swift.wasm_sdk(
    url = "https://github.com/AttilaTheFun/isomer_hermetic_toolchains/releases/download/isomer-6.4.2.4/swift-6.4.2-RELEASE_wasm-i18n.artifactbundle.tar.gz",
    sha256 = "f00bd04a717c7c8289bb0d4253d5c1a365a9fd71323b4d90b5eeb915211fe7fa",
)

_android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
_android.ndk(
    api_level = 23,
    version = "r30",
)

bazel_dep(name = "rules_android", version = "0.6.0")
single_version_override(
    module_name = "rules_android",
    version = "0.6.0",
)
