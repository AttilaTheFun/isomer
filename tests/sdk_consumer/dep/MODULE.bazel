"""A dependency of the consumer's with Swift packages of its own, resolved
in an isolated swift_deps usage (`isolate = True`): its graph apart from
the root's, as a feature module in a larger app's repository may keep."""

module(name = "sdk_consumer_dep", version = "0.0.0")

bazel_dep(name = "rules_swift", version = "4.3.0.isomer.1")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0.isomer.1")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
    isolate = True,
)
swift_deps.from_package(
    resolved = "//third_party/swift_packages:Package.resolved",
    swift = "//third_party/swift_packages:Package.swift",
)
use_repo(swift_deps, "swiftpkg_swift_algorithms")
