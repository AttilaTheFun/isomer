load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The SwiftMap module for Android: the shared core engine plus the swift_ffi
# host bridge. Built for Android through kt_swift_library's platform
# transition (see //swift_map/android/applications/example_opengl_android_application).
swift_library(
    name = "swift_map",
    srcs = [
        "AndroidBridge.swift",
        "//swift_map/swift_map/core:srcs",
        "//swift_map/swift_map/renderer:srcs",
    ],
    module_name = "SwiftMap",
    deps = [
        "//swift_ffi/swift_ffi",
        "//swift_gpu/android:swift_gpu",
    ],
)

# The Kotlin runtime (dev.swiftmap.runtime): GL surface + renderer, tile
# fetcher, gestures. Compiled per-app together with the generated bindings —
# the bindings' java_package is fixed to dev.swiftmap.runtime so these
# sources resolve the generated SwiftMapBridge/MapAndroidHost.
filegroup(
    name = "runtime_kotlin",
    srcs = glob(["kotlin/**/*.kt"]),
)

# The bridge-free engine variant lives in its own package
# (//swift_map/android/libraries/swift_map_engine): both variants are module `SwiftMap`, and
# equal module names in one package collide on the .swiftmodule output.
