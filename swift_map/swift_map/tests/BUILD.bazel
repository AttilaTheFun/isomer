load("@rules_swift//swift:swift.bzl", "swift_test")

swift_test(
    name = "core_tests",
    srcs = ["MapEngineTests.swift"],
    # The xctest bundle references libXCTestSwiftSupport/XCTest through
    # @rpath entries that resolve via the /var/db/xcode_select_link symlink,
    # which not every machine has (and DYLD_* fallbacks are stripped by SIP
    # when the test wrapper runs through /bin/bash). Point rpath at the
    # standard Xcode install directly.
    linkopts = [
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/usr/lib",
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/Frameworks",
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/PrivateFrameworks",
    ],
    deps = ["//swift_map/swift_map/core"],
)
