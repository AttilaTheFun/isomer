load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The SwiftMap module for Linux: the shared core + MapSceneRenderer over
# swift_gpu's desktop GL backend (core 3.3; the host owns the SDL window and
# context). The host half (window/input/fetch/decode) is the consumer's:
# see the example app here and isomer's Linux bridge.
swift_library(
    name = "swift_map",
    srcs = [
        "//swift_map/swift_map/core:srcs",
        "//swift_map/swift_map/renderer:srcs",
    ],
    module_name = "SwiftMap",
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//swift_gpu/linux:swift_gpu"],
)
