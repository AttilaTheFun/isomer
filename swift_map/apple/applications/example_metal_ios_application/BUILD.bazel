load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "example_metal_ios_application_lib",
    srcs = ["ExampleApp.swift"],
    deps = ["//swift_map/apple/libraries/swift_map"],
)

# Simulator-friendly (no provisioning profile): build with
#   bazel build //swift_map/apple/applications/example_metal_ios_application --ios_multi_cpus=sim_arm64
# then `xcrun simctl install` the Payload/*.app from the .ipa.
ios_application(
    name = "example_metal_ios_application",
    bundle_id = "dev.swiftmap.example.ios",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    visibility = ["//visibility:public"],
    deps = [":example_metal_ios_application_lib"],
)
