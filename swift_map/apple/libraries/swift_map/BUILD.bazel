load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# For the single-module XCFramework distribution (//swift_map/apple/xcframework).
filegroup(
    name = "srcs",
    srcs = [
        "MapView.swift",
        "TileDecoder.swift",
    ],
)

# The SwiftMap module for Apple platforms: the shared core engine, the
# SwiftGPU-based MapSceneRenderer, and the MapView host (a plain view over
# SwiftGPU's Metal surface). One module — the same shape consumers get from
# the XCFramework distribution.
swift_library(
    name = "swift_map",
    srcs = [
        "MapView.swift",
        "TileDecoder.swift",
        "//swift_map/swift_map/core:srcs",
        "//swift_map/swift_map/renderer:srcs",
    ],
    module_name = "SwiftMap",
    deps = ["//swift_gpu/apple:swift_gpu"],
)
