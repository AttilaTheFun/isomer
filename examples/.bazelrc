# Isomer EXAMPLES workspace options — mirrors the framework's root
# .bazelrc (a consumer needs most of these lines too; see MODULE.bazel).

common --enable_bzlmod

# swift_proto_library resolves protoc through toolchain resolution (the
# proto greeter).
build --incompatible_enable_proto_toolchain_resolution

# Release builds: optimized. (Until 0.38 this also lowered reactors to WAMR's
# native .aot; WasmKit, the engine since, interprets the .wasm.)
build:release -c opt

# Real OpenStreetMap tiles for the SwiftUI `Map` view: point isomer's
# per-platform map-engine label flags at this module's own swift_map dep
# (bazel_dep + git_override in MODULE.bazel). The examples are the showcase,
# so the map is ON by default here; a consumer without swift_map simply
# leaves the flags at their empty-stub default and `Map` renders a
# placeholder pane.
build --@isomer//shared:map_engine_apple=@isomer//swift_map/apple/libraries/swift_map
build --@isomer//shared:map_engine_wasm=@isomer//swift_map/wasm/libraries/swift_map_engine:engine
build --@isomer//shared:map_engine_android=@isomer//swift_map/android/libraries/swift_map_engine:engine
build --@isomer//shared:map_engine_linux=@isomer//swift_map/linux/libraries/swift_map
build --@isomer//shared:map_engine_windows=@isomer//swift_map/windows/libraries/swift_map

# Apple builds need the local Xcode; everything else is hermetic.
build --apple_platform_type=macos

# Keep actions sandboxed by default for hermeticity.
build --spawn_strategy=sandboxed,local

# The sandbox strategy isn't available on Windows; build natively there.
build --enable_platform_specific_config
build:windows --spawn_strategy=local

# Accept the Android NDK/SDK licenses for hermetic_android_toolchains' @androidndk
# (the NDK behind the Swift Android cross-compile toolchain). Only consulted when
# those repositories are fetched.
common --repo_env=ACCEPTED_ANDROID_NDK_LICENSE_VERSION=r30
common --repo_env=ACCEPTED_ANDROID_SDK_LICENSE_VERSION=35

# The emulator is arm64, so the example APK targets arm64-v8a. rules_android's
# `android_binary` reads this to drive its per-ABI native-lib split and names the
# APK's lib/<abi>/ directory after the platform (only consulted by android_binary).
common --android_platforms=@rules_android//:arm64-v8a

# Use rules_java's hermetic remote JDK 17 for rules_android's Java actions
# (aapt2/d8/apksigner wrappers) instead of requiring a host JDK (local_jdk).
# A consumer needs the two language versions too, at 17 or more: rules_android's
# own tools (the dexer) are Java with records, and built at a lower language
# level they fail with "records are not supported in -source 11".
common --java_language_version=17
common --java_runtime_version=remotejdk_17
common --tool_java_language_version=17
common --tool_java_runtime_version=remotejdk_17

# Native Linux host (e.g. SteamOS / Ubuntu): the swift.org standalone toolchain's
# `swift_toolchain` rule requires the configured CC toolchain to be clang (it
# rejects gcc), so point Bazel's C/C++ autoconfiguration at clang. Auto-applied
# on Linux hosts only (via --enable_platform_specific_config above); the
# macOS/Windows toolchains are unaffected.
build:linux --repo_env=CC=clang
build:linux --repo_env=CXX=clang++

# The embedded WebView (linux/libraries/swift_ui/webview_linux.c) needs GTK/GLib
# headers that live outside /usr/include (glibconfig.h in /usr/lib/glib-2.0,
# dbus-arch-deps.h in /usr/lib/dbus-1.0). Bazel rejects absolute `-I` paths
# outside the exec root and a builtin include dir, so register these as builtin
# C include dirs of the autodetected cc toolchain (the compiler reports
# C_INCLUDE_PATH dirs in its search paths). Harmless for the other C sources.
# Both layouts are listed — /usr/lib (Arch/SteamOS) and the Debian/Ubuntu
# multiarch /usr/lib/x86_64-linux-gnu (e.g. WSL) and /usr/lib/aarch64-linux-gnu
# (an ARM machine, a container on a Mac) — missing dirs are skipped.
build:linux --repo_env=C_INCLUDE_PATH=/usr/lib/glib-2.0/include:/usr/lib/dbus-1.0/include:/usr/lib/x86_64-linux-gnu/glib-2.0/include:/usr/lib/x86_64-linux-gnu/dbus-1.0/include:/usr/lib/aarch64-linux-gnu/glib-2.0/include:/usr/lib/aarch64-linux-gnu/dbus-1.0/include
build:linux --action_env=C_INCLUDE_PATH=/usr/lib/glib-2.0/include:/usr/lib/dbus-1.0/include:/usr/lib/x86_64-linux-gnu/glib-2.0/include:/usr/lib/x86_64-linux-gnu/dbus-1.0/include:/usr/lib/aarch64-linux-gnu/glib-2.0/include:/usr/lib/aarch64-linux-gnu/dbus-1.0/include

# No `build --features=swift.…` here, and none in a consumer's .bazelrc:
# --features apply to every repository in the build, isomer and every
# SwiftPM package and module beneath it included (swift-foundation's
# collections fail under swift.enable_v6/StrictConcurrency, its
# FoundationEssentials under swift.treat_warnings_as_errors, which conflicts
# with its own -suppress-warnings). Isomer's REPO.bazel turns the common
# ones off for its own packages, but it can't for the others. Scope Swift
# features to your own repository instead, in its REPO.bazel:
#   repo(features = ["swift.enable_v6", "swift.treat_warnings_as_errors"])
# (or per package with package(features = [...])). Don't turn on
# swift.enable_library_evolution for Android, wasm, Linux or Windows
# targets at all: there is no binary-stable system framework there for it to
# serve, and Isomer's modules are built without it (README, "Swift features").
#
# If your targets there must be resilient anyway (and warnings-as-errors
# fails each import on "module 'SwiftUI' was not compiled with library
# evolution support"), `--config=isomer_library_evolution` builds Isomer's
# Android and wasm modules resilient too, through rules_swift's per-target
# copts (keyed by the canonical label, hence `@@isomer+`). Off by default:
# resilience costs every access across those modules an indirection.
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//core_graphics:core_graphics=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//foundation:foundation=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//foundation/dispatch_time:dispatch_time=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//foundation/isomer_foundation:isomer_foundation=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//frameworks/core_transferable:core_transferable=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//frameworks/os_log:os_log=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//frameworks/os_log/os:os=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//frameworks/uniform_type_identifiers:uniform_type_identifiers=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//metal/isomer_metal:isomer_metal=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//metal/metal:metal=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//metal/web:web=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//shared/isomer_network_host:isomer_network_host=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//shared/isomer_swift_ui:isomer_swift_ui=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//shared/platform_services:platform_services=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//swift_ffi/swift_ffi:swift_ffi=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//swift_gpu/android:swift_gpu=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//swift_gpu/wasm:swift_gpu=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//swift_map/android/libraries/swift_map_engine:engine=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//swift_map/wasm/libraries/swift_map_engine:engine=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//android/libraries/swift_ui:image_io=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//android/libraries/swift_ui:isomer=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//android/libraries/swift_ui:photos_ui=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//android/libraries/swift_ui:sdk=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//android/libraries/swift_ui:swift_ui=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//wasm/libraries/swift_ui:image_io=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//wasm/libraries/swift_ui:isomer=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//wasm/libraries/swift_ui:photos_ui=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//wasm/libraries/swift_ui:sdk=-enable-library-evolution
build:isomer_library_evolution --@rules_swift//swift:per_module_swiftcopt=@@isomer+//wasm/libraries/swift_ui:swift_ui=-enable-library-evolution

# Nicer error output from Swift cross-compile actions.
build --show_progress_rate_limit=5
build --verbose_failures

# convenience: `bazel run //web/...` etc. inherit these.
test --test_output=errors

# Run Swift compiles unsandboxed. The swift_ffi macro plugin is built (exec
# config) by the Xcode `swiftlang` Swift toolchain, but the wasm / Android
# cross-compiles are driven by the swift.org 6.4.2 frontend. When that frontend
# loads the plugin inside a sandbox, the plugin can't reach the Swift runtime
# dylibs it was linked against, so macro expansion fails with "produced
# malformed response". (The Apple build requires a local Xcode anyway.)
build --strategy=SwiftCompile=local

# swift_ffi's `analyzer` / `generator` are swift.org-toolchain swift_binaries
# invoked as build actions (the analyzer aspect + ffi_generate). They need the
# Swift runtime, which the action sandbox doesn't stage — so each host resolves
# it its own way:
#   * Linux: rules_swift bakes a RUNPATH of `external/…/usr/lib/swift/linux`
#     (relative to the exec root) into the tools. It only resolves when the
#     action runs in the exec root, i.e. NOT sandboxed — so pin those two
#     mnemonics to the local strategy. No env or absolute path needed.
#   * Windows: there is no RUNPATH; swiftc/`analyzer.exe` find `swiftCore.dll`
#     (and the analyzer's own compile finds the stdlib) via the PATH, which
#     Bazel's strict action env scrubs. Pass the invoking shell's PATH through —
#     the swift.org installer already puts the toolchain + runtime dirs on it.
#     The variable is inherited under BOTH casings: Windows' canonical name is
#     `Path`, but the DLL loader / strict-env default can leave a scrubbed `PATH`
#     that wins the case-insensitive lookup, so we override both keys.
build:linux --strategy=SwiftFFIAnalyze=local
build:linux --strategy=SwiftFFIGenerate=local
build:windows --action_env=Path
build:windows --action_env=PATH

# No MODULE.bazel.lock: the lockfile churns across machines and Bazel versions
# and buys little here — deps are pinned explicitly (git_override commits /
# exact versions). Don't read or write it.
common --lockfile_mode=off

# Modules from the project's registry first (isomer's rules_swift and
# swift-foundation forks, by version), then the Bazel Central Registry.
common --registry=https://raw.githubusercontent.com/AttilaTheFun/bazel_registry/main
common --registry=https://bcr.bazel.build

# rules_swift_package_manager wraps every package target in a minimum-OS
# transition keyed on --apple_platform_type (macos here, even in the wasm
# configuration). With the flag already at the value the examples' SwiftPM
# manifest declares (macOS 15) the transition is a no-op, so the package and everything beneath
# it stay in the consumer's configuration; without it swift_ffi and
# isomer built twice under the fork and clang refused the second
# SwiftABI module map. rules_apple's own platform transitions set the iOS
# deployment target per app regardless.
build --minimum_os_version=15.0
build --macos_minimum_os=15.0


# The Apple targets built on Linux with rules_applecross (MODULE.bazel), on
# a builder that has Xcode 27.0's SDK archive: its .bazelrc.user says where
# (`--distdir`, or a `--downloader_config` to an OS Server) and turns this on
# with `build:linux --config=apple_on_linux`. Without it (GitHub's runners)
# Linux builds what runs on Linux alone, and nothing fetches the SDKs. Its
# toolchains (the clean-room Apple tools, LLD, the Swift that built the SDKs)
# take the Apple targets; the host's own C and Swift toolchains still build
# what runs on Linux (the Linux pieces link its system libraries);
# rules_apple's own actions find the staged tools by DEVELOPER_DIR and PATH.
# A Mac builds as before, with its own Xcode.
startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1
common --incompatible_repo_env_ignores_action_env
common:linux --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
build:apple_on_linux --extra_toolchains=@apple_cross_toolchain//:all
build:apple_on_linux --xcode_version_config=@apple_cross_toolchain//:host_xcodes
build:apple_on_linux --@build_bazel_rules_apple//apple:sdk_tool_files=@apple_cross_toolchain//:sdk_tool_files
build:apple_on_linux --action_env=DEVELOPER_DIR=external/rules_applecross++apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer
build:apple_on_linux --action_env=PATH=external/rules_applecross++apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:/bin:/usr/bin:/usr/local/bin
# Its clean-room tools make a near match to Xcode's output where they cannot
# make it byte for byte. An Icon Composer icon's layers are Xcode's (its
# appearances, groups and image stacks, so dark and tinted icons work); only
# its flattened images are this actool's, which macOS and iOS 26 and later
# don't draw.
build:apple_on_linux --action_env=RULES_APPLECROSS_RESOURCE_OUTPUT_MODE=relaxed
build:apple_on_linux --action_env=RULES_APPLECROSS_RELAX_ACTOOL_ICON_COMPOSER=1

# Windows on Arm (and x64) built on Linux (@isomer//tools/windows): the host's
# Swift with the Windows Swift SDK and Microsoft's SDK and MSVC libraries,
# both archives by placeholders (MODULE.bazel's swift_windows_sdk) each
# builder resolves as it does the Apple SDK's, and their toolchains turned on
# here alone, so no other build fetches them. Build a Windows target with
# `--config=windows_on_linux --platforms=@isomer//tools/platforms:windows_arm64`.
build:windows_on_linux --extra_toolchains=@swift_windows_sdk//:all

# Which of an app's builds (the private AttilaTheFun/applications' docs/VARIANTS.md):
# Alpha, the default (every main and pull request build), Beta (TestFlight's,
# for later), Production, which only CI's release job builds, on a release
# branch, or AdHoc, a pull request's branch built by hand. One bundle id,
# name and link scheme for all of them; the build says which it is in its
# Info.plist's BuildVariant (//tools/variant). The Storybook's and the
# Playground's iPhone, iPad and Mac apps alone so far: Android, the web,
# Linux and Windows are built the same whatever the config.
build:alpha --//tools/variant:variant=alpha
build:beta --//tools/variant:variant=beta
build:prod --//tools/variant:variant=production
build:adhoc --//tools/variant:variant=adhoc
# CI's iPhone and iPad apps: a device build, signed ad hoc with a placeholder
# profile (//tools/ci_device), which Applications Server signs again with the
# team's identity and the bundle id's profile when it is published.
build:ci_device --ios_multi_cpus=arm64
build:ci_device --ios_signing_cert_name=-

# Per-machine settings (untracked), e.g. --override_module for a fork checked
# out beside isomer.
try-import %workspace%/.bazelrc.user

# The SwiftPM packages (rules_swift_package_manager) build at the manifest's
# macOS 15 minimum; building everything at it keeps what they share with the
# rest of the build (@isomer//:foundation) in one configuration, one copy.
common --macos_minimum_os=15.0

# Android apps linked to ship (README, "Android release size"): optimized for
# size, each JNI library exporting its entry points alone (the rest local, so
# the linker drops what they don't reach), stripped, and no Swift module
# embedded in it for the debugger (.swift_ast).
build:android_release -c opt
build:android_release --@rules_swift//swift:copt=-Osize
build:android_release --features=swift.no_embed_debug_module
build:android_release --@isomer//swift_ffi/rules:jni_exports_only
