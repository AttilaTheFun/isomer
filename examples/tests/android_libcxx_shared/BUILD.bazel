load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@isomer_android//:defs.bzl", "isomer_android_aar", "isomer_android_app")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift.bzl", "swift_interop_hint", "swift_library")
load(":check.bzl", "libcxx_shared_check", "ndk_tools")

# An app whose Swift calls C++ (`libcxx_probe`, strings and vectors, an
# exception and a dynamic_cast) linked against the NDK's libc++_shared.so
# (`libcxx = "shared"`), as an app sharing C++ objects with a prebuilt
# library built with `c++_shared` is (README, "One C++ runtime with other
# libraries"). The check reads its APK: libc++_shared.so packaged, the
# app's library needing it and holding no libc++ of its own. The same app
# as an AAR (`isomer_android_aar(libcxx = "shared")`) is checked the same
# way, except that it leaves libc++_shared.so to its host. Built, never
# run: nothing is drawn.
swift_interop_hint(
    name = "probe_module",
    module_name = "LibcxxProbe",
)

cc_library(
    name = "probe",
    srcs = ["probe.cc"],
    hdrs = ["probe.h"],
    aspect_hints = [":probe_module"],
    tags = ["manual"],
    testonly = True,
)

swift_library(
    name = "app_swift",
    testonly = True,
    srcs = ["App.swift"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "LibcxxSharedApp",
    tags = ["manual"],
    deps = [
        ":probe",
        "@isomer//:foundation",
        "@isomer//:swift_ui",
        "@isomer//android/libraries/swift_ui",
    ],
)

isomer_android_app(
    name = "libcxx_shared_android_application",
    testonly = True,
    libcxx = "shared",
    package = "dev.isomer.libcxxshared",
    swift_library = ":app_swift",
    tags = ["manual"],
)

ndk_tools(
    name = "ndk_tools",
    tags = ["manual"],
)

sh_binary(
    name = "check",
    srcs = ["check.sh"],
)

libcxx_shared_check(
    name = "libcxx_shared_check",
    testonly = True,
    apk = ":libcxx_shared_android_application_apk.apk",
    library = "liblibcxx_shared_android_application_runtime_bindings.so",
    tags = ["manual"],
)

isomer_android_aar(
    name = "libcxx_shared_aar",
    testonly = True,
    libcxx = "shared",
    package = "dev.isomer.libcxxshared",
    swift_library = ":app_swift",
    tags = ["manual"],
)

libcxx_shared_check(
    name = "libcxx_shared_aar_check",
    testonly = True,
    apk = ":libcxx_shared_aar",
    library = "liblibcxx_shared_aar_runtime_bindings.so",
    tags = ["manual"],
)

build_test(
    name = "android_libcxx_shared_test",
    targets = [
        ":libcxx_shared_aar_check",
        ":libcxx_shared_check",
    ],
)
