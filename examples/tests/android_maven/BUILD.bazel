load("@rules_android//rules:rules.bzl", "android_library")

# An app's own AndroidX set, as docs/android_maven.md has an app make one,
# for --@isomer//android/maven:androidx: CI builds the Android Storybook
# against it (tools/ci/container_build.sh), so an app's override keeps
# working. Its artifacts are Isomer's here (the examples have no Compose of
# their own); what is checked is that Isomer builds through a set it doesn't
# own.
android_library(
    name = "androidx_for_isomer",
    exports = [
        "@isomer_maven//:androidx_activity_activity_compose",
        "@isomer_maven//:androidx_browser_browser",
        "@isomer_maven//:androidx_compose_foundation_foundation",
        "@isomer_maven//:androidx_compose_material3_material3",
        "@isomer_maven//:androidx_compose_runtime_runtime",
        "@isomer_maven//:androidx_compose_ui_ui",
        "@isomer_maven//:androidx_fragment_fragment",
        "@isomer_maven//:androidx_lifecycle_lifecycle_common",
        "@isomer_maven//:androidx_profileinstaller_profileinstaller",
        "@isomer_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@isomer_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
    ],
    visibility = ["//visibility:public"],
)
