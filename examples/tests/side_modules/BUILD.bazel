load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@isomer//tools/wasm:mixed.bzl", "wasm_mixed_native")
load("@isomer//tools/wasm:side_modules.bzl", "wasm_runtime_module", "wasm_side_module")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

# The Storybook's app as a feature over one runtime module
# (docs/side_modules.md): the runtime is what its reactor links but the app
# and its stories; the side module is the app and the stories alone, linked
# by the toolchain's wasm-ld and corrected (tools/wasm/side_module_fixup).

# Exporting what its side modules import (and what the host calls): every
# public symbol would be more exports than V8 loads.
wasm_runtime_module(
    name = "storybook_runtime",
    exports_for = [
        ":corpus_side",
        ":storybook_side",
    ],
    tags = ["manual"],
    deps = [
        "//shared/platform_services",
        "@isomer//wasm/libraries/swift_ui",
        "@isomer//wasm/libraries/swift_ui:hot_bridge",
        "@isomer//wasm/libraries/swift_ui:isomer",
    ],
)

wasm_side_module(
    name = "storybook_side",
    tags = ["manual"],
    deps = [
        "//storybook",
        "//wasm/example_full_feature:example_full_lib",
    ],
)

# Under WasmKit, the side module over the runtime renders what the
# self-contained reactor renders, byte for byte: the first frame and every
# first-frame tap after it (each story's page). Also as a host loads it:
# WasmFeatureRuntime given the runtime module once and the side module as a
# bundle, both read from their files.
swift_test(
    name = "side_module_render_test",
    size = "large",
    srcs = [
        "SideModuleRenderTests.swift",
        "TapTargets.swift",
    ],
    data = [
        ":storybook_runtime.wasm",
        ":storybook_side",
        "//wasm/example_full_feature:example_full.wasm",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@isomer//shared/wasm_host",
        "@isomer//shared/wasm_host:wasm_runtime",
        "@isomer//shared/wasm_host:wasmkit_runtime",
        "@isomer//swift_ffi/runtime/swift_wasm_host",
    ],
)

# Mixed mode's native set comes from a corpus, not from any app: the
# runtime's native code ships in the app, and a feature downloaded later
# can't bring its own. tools/wasm_mixed_corpus writes the corpus, an app of
# 88 screens made methodically from SwiftUI's pieces; :corpus_profile runs it
# under the interpreter, profiled; `wasm_mixed profile-set` keeps every
# runtime function that ran:
#
#   bazel test -c opt //tests/side_modules:corpus_profile
#   bazel run @isomer//tools/wasm_mixed -- profile-set --time 1.0 --calls 1 \
#     $PWD/<storybook_runtime.wasm> $PWD/tests/side_modules/corpus_native_set.txt \
#     $PWD/<bazel-testlogs>/tests/side_modules/corpus_profile/test.outputs/corpus_profile.txt
#
# (a set names functions, so it outlives the runtime build it came from).
# With it, every function of Isomer's own modules and everything those and
# the entry points call directly: interpreted code never calls native code,
# so one interpreted function on the way (MainActor.assumeIsolated, under
# every entry point) would leave everything beneath it interpreted. The
# Storybook isn't in the corpus.
genrule(
    name = "corpus_source",
    outs = ["corpus/Corpus.swift"],
    cmd = "$(location @isomer//tools/wasm_mixed_corpus) $@ > /dev/null",
    tags = ["manual"],
    tools = ["@isomer//tools/wasm_mixed_corpus"],
)

swift_library(
    name = "corpus_lib",
    srcs = ["corpus/Corpus.swift"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "Corpus",
    tags = ["manual"],
    deps = ["@isomer//wasm/libraries/swift_ui"],
)

wasm_side_module(
    name = "corpus_side",
    tags = ["manual"],
    deps = [":corpus_lib"],
)

swift_test(
    name = "corpus_profile",
    size = "enormous",
    srcs = ["CorpusProfile.swift"],
    data = [
        ":corpus_side",
        ":storybook_runtime.wasm",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@isomer//shared/wasm_host:wasm_runtime",
        "@isomer//shared/wasm_host:wasmkit_runtime",
    ],
)

wasm_mixed_native(
    name = "storybook_native",
    closure = True,
    modules = [
        "CoreGraphics",
        "HotBridge",
        "Isomer",
        "IsomerFFI",
        "IsomerSwiftUI",
        "IsomerTreeMessages",
        "Observation",
        "SwiftUI",
    ],
    native_set = ["corpus_native_set.txt"],
    routed = "storybook_routed.txt",
    runtime = ":storybook_runtime.wasm",
    tags = ["manual"],
)

# Twice: with native code, and with ISO_MIXED_NATIVE=0, the path
# MixedWasmKitRuntime takes when WasmKit can't reserve guard pages for the
# runtime's memory (an iPhone grants a process one such reservation, so a
# mixed runtime that isn't the first engine there gets none): the guest
# interpreted, rendering the same. The corpus's side module is the other
# feature a reload swaps in over the same runtime module.
[swift_test(
    name = name,
    size = "large",
    srcs = [
        "MixedRenderTests.swift",
        "TapTargets.swift",
    ],
    data = [
        "storybook_routed.txt",
        ":corpus_side",
        ":storybook_native_shim",
        ":storybook_native_slots",
        ":storybook_runtime.wasm",
        ":storybook_side",
        "//wasm/example_full_feature:example_full.wasm",
    ],
    env = env,
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":storybook_native",
        "@isomer//shared/wasm_host:mixed_runtime",
        "@isomer//shared/wasm_host:wasm_host",
        "@isomer//shared/wasm_host:wasm_runtime",
        "@isomer//shared/wasm_host:wasmkit_runtime",
        "@isomer//swift_ffi/runtime/swift_wasm_host",
    ],
) for name, env in [
    ("mixed_render_test", {}),
    ("mixed_interpreted_render_test", {"ISO_MIXED_NATIVE": "0"}),
]]

# The same in V8 (Node), with the web's linker
# (wasm/libraries/swift_ui/runtime/side_modules.js): what browsers and web
# views run. Against the shipped reactor (the development one exports every
# symbol: more than V8 loads).
genrule(
    name = "node_inputs",
    srcs = [
        "@isomer//wasm/libraries/swift_ui:runtime/side_modules.js",
        ":storybook_runtime.wasm",
        ":storybook_side",
        "//wasm/example_full_feature:example_full_release.wasm",
    ],
    outs = [
        "node/side_modules.js",
        "node/side_module_render_test.mjs",
        "node/storybook_runtime.wasm",
        "node/storybook_side.wasm",
        "node/example_full.wasm",
    ],
    cmd = " && ".join([
        "cp $(location @isomer//wasm/libraries/swift_ui:runtime/side_modules.js) $(RULEDIR)/node/side_modules.js",
        "cp $(location side_module_render_test.mjs) $(RULEDIR)/node/side_module_render_test.mjs",
        "cp $(location :storybook_runtime.wasm) $(RULEDIR)/node/storybook_runtime.wasm",
        "cp $(location :storybook_side) $(RULEDIR)/node/storybook_side.wasm",
        "cp $(location //wasm/example_full_feature:example_full_release.wasm) $(RULEDIR)/node/example_full.wasm",
    ]),
    tags = ["manual"],
    tools = ["side_module_render_test.mjs"],
)

js_test(
    name = "side_module_render_node_test",
    size = "large",
    data = [":node_inputs"],
    entry_point = "node/side_module_render_test.mjs",
)
