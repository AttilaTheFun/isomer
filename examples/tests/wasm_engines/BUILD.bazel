load("@rules_swift//swift:swift_test.bzl", "swift_test")

# The engine-seam conformance suite: every WasmRuntime engine runs the real
# tap-counter reactor (launch -> first frame -> tap -> updated tree). A new
# engine passes this or it isn't an engine: WasmKit (Isomer's engine since
# 0.38, when WAMR's place in this suite went with it), JSC and WasmEdge.
# macOS-only (WasmEdge's SDK is a macOS build; JSC's wasm tiers need a real
# JSC).
swift_test(
    name = "wasm_engine_tests",
    srcs = ["WasmEngineTests.swift"],
    data = [
        "//wasm/example_full_feature:example_full.wasm",
        "//wasm/network_probe_feature:network_probe.wasm",
        "//wasm/network_probe_feature:network_probe_threads.wasm",
        "//wasm/tap_counter_feature:tap_counter_release.wasm",
        "//wasm/tap_counter_feature:tap_counter_threads_release.wasm",
    ],
    linkopts = [
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/usr/lib",  # keep
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/Frameworks",  # keep
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/PrivateFrameworks",  # keep
    ],
    module_name = "WasmEngineTests",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "@isomer//shared/wasm_host:jsc_runtime",
        "@isomer//shared/wasm_host:wasmkit_runtime",
        "@isomer//shared/wasm_host:wasmedge_runtime",
        "@isomer//shared/wasm_host:wasm_runtime",
        "//apple/platform_services_host",
        "//shared/platform_services:platform_services_host",
        "@isomer//shared/isomer_network_host:wasm_host",
    ],
)

# The threaded reactor on WasmKit alone, wherever WasmKit runs natively (the
# Mac and Linux: CI's container): `canRunThreads`, and the tap counter built
# with the threads SDK (wasm32-unknown-wasip1-threads) running as the
# single-threaded build does, frame for frame.
swift_test(
    name = "wasmkit_threads_test",
    size = "small",
    srcs = ["WasmKitThreadsTests.swift"],
    data = [
        "//wasm/tap_counter_feature:tap_counter_release.wasm",
        "//wasm/tap_counter_feature:tap_counter_threads_release.wasm",
    ],
    module_name = "WasmKitThreadsTests",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@isomer//shared/wasm_host:wasm_runtime",
        "@isomer//shared/wasm_host:wasmkit_runtime",
    ],
)

# The parsed modules WasmKit keeps (WasmKitModules): kept while a view
# shows pages, dropped with the last view and when the system is short of
# memory. WasmKit alone, wherever it runs natively (the Mac and Linux).
swift_test(
    name = "wasmkit_modules_test",
    size = "small",
    srcs = ["WasmKitModulesTests.swift"],
    data = ["//wasm/tap_counter_feature:tap_counter_release.wasm"],
    module_name = "WasmKitModulesTests",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@isomer//shared/wasm_host:wasmkit_runtime"],
)
