load("@rules_swift//swift:swift.bzl", "swift_binary")

# Does SwiftNIO run under a given Wine? Its Windows event loop wakes itself
# through an AF_UNIX socket pair (SelectorWSAPoll), which Wine has only in
# Wine Staging (11.16 and later); the headful driver and its tests are NIO's
# on Windows. The probe starts an event loop, echoes a message over loopback
# TCP and shuts down, saying each step on standard error. Built for Windows
# on Arm in CI's container:
#   bazel build --config=windows_on_linux \
#     --platforms=@isomer//tools/platforms:windows_arm64 //tests/wine_nio:nio_probe
swift_binary(
    name = "nio_probe",
    srcs = ["main.swift"],
    tags = ["manual"],
    deps = [
        "@swiftpkg_swift_nio//:NIOCore",
        "@swiftpkg_swift_nio//:NIOPosix",
    ],
)
