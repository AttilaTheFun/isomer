load("@rules_swift//swift:swift_test.bzl", "swift_test")

# The compiled (in-process) half of the platform services' DI: the host
# installs the keychain, analytics, flags, a timer and OAuth into the swift_ffi
# dependency dictionary and PlatformDependencies resolves and round-trips
# through them — the same mechanism the wasm hosts drive through
# dependency_get (see //shared/wamr_host:iso_wamr_full_smoke for that half).
swift_test(
    name = "platform_services_di",
    srcs = ["PlatformServicesDITests.swift"],
    linkopts = [
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/usr/lib",  # keep
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/Frameworks",  # keep
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/PrivateFrameworks",  # keep
    ],
    module_name = "PlatformServicesDITests",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//shared/platform_services",
        "@isomer//swift_ffi/swift_ffi",
    ],
)
