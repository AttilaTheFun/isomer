load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@isomer//tools/android:defs.bzl", "isomer_android_app")
load("@rules_swift//swift:swift.bzl", "swift_library")

# isomer_android_app's attributes for a consumer's build: a debug key of the
# app's own, the APK and run target tagged manual (a wildcard build of a
# package holding other platforms' apps leaves them out), everything the
# macro makes testonly, and Isomer's own AndroidX label listed again (in
# services_deps and extra_binary_deps), which the macro takes once.
swift_library(
    name = "app_swift",
    testonly = True,
    srcs = ["App.swift"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "AttributesApp",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@isomer//:swift_ui",
        "@isomer//android/libraries/swift_ui",
    ],
)

isomer_android_app(
    name = "attributes_android_application",
    testonly = True,
    debug_key = "@rules_android//tools/android:debug_keystore",
    extra_binary_deps = ["@isomer//android/maven:androidx"],
    package = "dev.isomer.attributes",
    services_deps = ["@isomer//android/maven:androidx"],
    swift_library = ":app_swift",
    tags = ["manual"],
)

build_test(
    name = "android_app_attributes_test",
    targets = [":attributes_android_application_apk"],
)
