load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_swift//swift:swift.bzl", "swift_library")
load(":defs.bzl", "with_library_evolution")

# An app's own library built as a library meant for distribution is
# (Client.swift), against Isomer's modules built resilient by
# `--@isomer//:library_evolution` (docs/library_evolution.md): for Android
# and the web, with the flag on whatever the command line says. Without the
# flag the same library fails on its first public import of Isomer's
# ("module 'Combine' was not compiled with library evolution support"), an
# error in this configuration.
swift_library(
    name = "resilient_client",
    srcs = [
        "Client.swift",
        "Logging.swift",
        "Networking.swift",
        "OSLogging.swift",
    ],
    # A library for distribution's settings: Swift reports a public import
    # of a fragile module as an error under InternalImportsByDefault (or
    # AccessLevelOnImport) at library level api or spi, and only a warning
    # otherwise, one that Swift 6.4's -warnings-as-errors doesn't promote.
    copts = [
        "-library-level",
        "api",
    ],
    features = [
        "swift.enable_library_evolution",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.InternalImportsByDefault",
    ],
    module_name = "ResilientClient",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@isomer//:os_log",
        "@isomer//:swift_ui",
    ],
)

with_library_evolution(
    name = "resilient_client_android",
    library = ":resilient_client",
    platform = "@isomer//tools/platforms:android_arm64",
)

with_library_evolution(
    name = "resilient_client_wasm",
    library = ":resilient_client",
    platform = "@isomer//tools/platforms:wasm32",
)

build_test(
    name = "library_evolution_test",
    targets = [
        ":resilient_client_android",
        ":resilient_client_wasm",
    ],
)
