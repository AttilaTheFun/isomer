load("@rules_cc//cc:defs.bzl", "cc_test")

# Host smokes for the example reactors under WAMR — the C-host integration
# tests of the framework + example DI surface, living with the examples
# because their fixtures (the reactors, the generated platform_services adapters)
# are example artifacts. The engine itself is framework
# (@isomer//shared/wamr_host).

# Runs the hot_demo reactor and asserts the emitted tree contains the demo
# greeting + the dictionary-injected promo banner.
cc_test(
    name = "iso_wamr_smoke",
    srcs = ["iso_wamr_smoke.c"],
    args = ["$(location //wasm/hot_demo_feature:hot_demo.wasm)"],
    data = ["//wasm/hot_demo_feature:hot_demo.wasm"],
    deps = [
        "//shared/platform_services:platform_services_c_host",
        "@isomer//shared/wamr_host:iso_wamr",
    ],
)

# The peer for the FULL example app reactor: instantiates the whole multi-tab
# @main App and checks it renders a tree (its networking through the injected
# HTTP host is the Swift wasm_engines test's).
cc_test(
    name = "iso_wamr_full_smoke",
    srcs = ["iso_wamr_full_smoke.c"],
    args = ["$(location //wasm/example_full_feature:example_full.wasm)"],
    data = ["//wasm/example_full_feature:example_full.wasm"],
    deps = ["@isomer//shared/wamr_host:iso_wamr"],
)
