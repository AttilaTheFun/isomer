load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@isomer//tools/platforms:transition.bzl", "transition_binary")
load("@rules_swift//swift:swift.bzl", "swift_library")

# An app's code in Swift 6 language mode, as it builds against Apple's
# SwiftUI (Swift6App.swift): built for Android and the web against Isomer's.
swift_library(
    name = "swift6_app",
    srcs = ["Swift6App.swift"],
    copts = ["-swift-version", "6"],
    module_name = "Swift6App",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@isomer//:swift_ui",
    ],
)

transition_binary(
    name = "swift6_app_android",
    binary = ":swift6_app",
    platform = "@isomer//tools/platforms:android_arm64",
)

transition_binary(
    name = "swift6_app_wasm",
    binary = ":swift6_app",
    platform = "@isomer//tools/platforms:wasm32",
)

build_test(
    name = "swift6_app_test",
    targets = [
        ":swift6_app_android",
        ":swift6_app_wasm",
    ],
)
