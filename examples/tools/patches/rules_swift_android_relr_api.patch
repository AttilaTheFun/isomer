--- a/swift/toolchains/swift_toolchain.bzl
+++ b/swift/toolchains/swift_toolchain.bzl
@@ -635,6 +635,22 @@ def _c_compile_args(ctx, cc_toolchain):
         variables = compile_variables,
     )
 
+def _android_linkopts(linkopts, target_system_name):
+    """Drops RELR relocation packing below API 28, whose loader ignores it."""
+    api = ""
+    for char in target_system_name.elems():
+        api = api + char if char.isdigit() else ""
+    if not api or int(api) >= 28:
+        return linkopts
+    result = []
+    for opt in linkopts:
+        if opt == "-Wl,--use-android-relr-tags":
+            continue
+        if opt == "-Wl,--pack-dyn-relocs=android+relr":
+            opt = "-Wl,--pack-dyn-relocs=android"
+        result.append(opt)
+    return result
+
 def _android_target_system_name(ctx, cc_toolchain):
