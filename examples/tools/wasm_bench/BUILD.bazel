load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:private"])

# Console engine benchmark for the simulator/emulator passes (dev-only;
# results are reported ad hoc, not in docs/benchmarks.md): the WAMR bench,
# built through bazel for every platform.
cc_binary(
    name = "wamr_bench",
    srcs = ["wamr_bench.c"],
    deps = ["@isomer//shared/wamr_host:iso_wamr"],
)

# The iOS device bench app (//tools/wasm_bench/ios_app) compiles the same
# source in-app with `main` renamed.
exports_files(["wamr_bench.c"])
