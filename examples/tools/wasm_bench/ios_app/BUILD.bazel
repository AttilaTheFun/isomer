load("@build_bazel_rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@build_bazel_rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer_signing//:signing.bzl", "TEAM_ID")

# The on-device iOS engine benchmark app: the engine conformance suite's
# protocol, timed, for WasmKit and JSC over the Swift engine seam, on an
# iPhone via devicectl. (Its WAMR pass, the C console bench compiled in,
# went with WAMR in 0.38.)
# Everything here is `manual` and dev-only (a device build needs the
# Xcode-managed provisioning profile).

BUNDLE_ID = "com.LoganShire.IsomerExamples"

swift_library(
    name = "bench_app_lib",
    srcs = ["BenchApp.swift"],
    data = ["//wasm/tap_counter_feature:tap_counter_release.wasm"],
    tags = ["manual"],
    deps = [
        "@isomer//shared/wasm_host:jsc_runtime",
        "@isomer//shared/wasm_host:wasm_runtime",
        "@isomer//shared/wasm_host:wasmkit_runtime",
    ],
)

apple_bundle_version(
    name = "_version",
    build_version = "1",
    short_version_string = "1.0",
    tags = ["manual"],
)

local_provisioning_profile(
    name = "_xcode_managed_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = TEAM_ID,
)

# Reuses the example app's bundle id, so the bench app installs OVER the
# example app on the phone.
ios_application(
    name = "wasm_engine_bench_ios_application",
    bundle_id = BUNDLE_ID,
    families = ["iphone"],
    infoplists = ["Info.plist"],
    # iOS 18: WasmView runs reactors on WasmKit (Swift's Synchronization).
    minimum_os_version = "18.0",
    provisioning_profile = ":_xcode_managed_profile",
    tags = ["manual"],
    version = ":_version",
    visibility = ["//visibility:public"],
    deps = [":bench_app_lib"],
)
