load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//tools/wasm:defs.bzl", "isomer_web_app")

# The Metal triangle (//shared/metal_triangle_application) on the web:
# MetalView's canvas, drawn by Isomer's Metal on WebGPU. Opens under the
# React renderer; `?renderer=webgpu` draws it inside the GPU renderer's
# frame instead.
swift_library(
    name = "app_lib",
    srcs = ["//shared/metal_triangle_application:srcs"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "MetalTriangle",
    tags = ["manual"],
    deps = [
        "@isomer//:swift_ui",
        "@isomer//metal/metal",
        "@isomer//wasm/libraries/swift_ui:isomer",
    ],
)

isomer_web_app(
    name = "metal_triangle_web_application",
    index = "index.html",
    query = "renderer=react",
    swift_library = ":app_lib",
)
