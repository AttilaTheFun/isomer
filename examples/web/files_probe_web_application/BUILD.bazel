load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//tools/wasm:defs.bzl", "isomer_web_app")

# The web's app files (wasm/libraries/swift_ui/runtime/file_system.js),
# checked from the app's side across page loads; see FilesProbe.swift. The
# driver serves the site itself and runs it in headless Chrome (needs
# Chrome on the Mac, hence by hand):
#
#   bazel build //web/files_probe_web_application:files_probe_web_application_site
#   node ../tools/testing/run_files_check.js \
#     bazel-bin/web/files_probe_web_application/files_probe_web_application_site
swift_library(
    name = "app_lib",
    srcs = [
        "FilesProbe.swift",
        "SQLiteProbe.swift",
    ],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "FilesProbe",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@swiftpkg_swift_sql//:SwiftSQL",
        "@isomer//:swift_ui",
    ],
)

isomer_web_app(
    name = "files_probe_web_application",
    index = "index.html",
    query = "renderer=react",
    swift_library = ":app_lib",
)
