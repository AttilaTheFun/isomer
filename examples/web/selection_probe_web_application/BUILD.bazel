load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//tools/wasm:defs.bzl", "isomer_web_app")

# The selection probe (shared/selection_probe_application) on the web: the
# React renderer's text field reporting its selection and showing the app's.
# Drive it with tools/testing/cdp.py (click the field, type, ArrowLeft,
# click Complete) and read the page's text and the textarea's selection.
swift_library(
    name = "app_lib",
    srcs = ["//shared/selection_probe_application:srcs"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "SelectionProbe",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@isomer//:swift_ui",
    ],
)

isomer_web_app(
    name = "selection_probe_web_application",
    index = "index.html",
    query = "renderer=react",
    swift_library = ":app_lib",
)
