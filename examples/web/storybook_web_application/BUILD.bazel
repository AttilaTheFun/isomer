load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//tools/wasm:defs.bzl", "isomer_web_app", "web_server")

# Level 4 adoption (docs/adoption_levels.md): the whole app is the shared
# SwiftUI `@main App`; the macro generates the wasm reactor + JS runtime
# bundle and assembles the site around the one-page index.html.
swift_library(
    name = "app_lib",
    srcs = ["//shared/example_application:srcs"],
    # Whole-archive: the only reference to the app's synthesized @main is the
    # isoStart trampoline in the SwiftUI archive, which links *after* this one.
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "ExampleApplication",
    # Only meaningful through the web app's wasm transition: in the host
    # configuration `import SwiftUI` would resolve against Apple's SwiftUI
    # next to the reimplementation's module of the same name.
    tags = ["manual"],
    deps = [
        "//storybook",
        "//shared/platform_services",
        "@isomer//wasm/libraries/swift_ui",
        "@isomer//wasm/libraries/swift_ui:isomer",
    ],
)

# The Storybook on the web: `bazel run //web/storybook_web_application`
# serves the site and opens it under the ReactRenderer
# (docs/renderer_layers.md).
isomer_web_app(
    name = "storybook_web_application",
    assets = [
        "//storybook/artwork/storybook_icon:web_icon",
        "//shared/example_application:assets",
    ],
    # Font.custom's fonts (the text.custom story), served from fonts/.
    fonts = ["//storybook:fonts"],
    index = "index.html",
    query = "renderer=react",
    site_visibility = [
        "//electron/example_full_react_electron_application:__pkg__",
        "//electron/example_full_webgpu_electron_application:__pkg__",
        "//headless/storybook_headless_application:__pkg__",
        "//remote:__pkg__",
        "//shared/example_application:__pkg__",
        "//tests/platforms:__pkg__",
        "//web/example_full_webgpu_web_application:__pkg__",
    ],
    swift_library = ":app_lib",
)

# Compatibility alias: the Electron wrapper + run_all consume ":site".
alias(
    name = "site",
    actual = ":storybook_web_application_site",
    visibility = [
        "//electron/example_full_react_electron_application:__pkg__",
        "//electron/example_full_webgpu_electron_application:__pkg__",
        "//shared/example_application:__pkg__",
    ],
)

# Isomer's web site (https://attilathefun.github.io/isomer/): the Storybook
# at its root, as the alpha job builds it (-c opt: iOS Safari overflows its
# stack on an -Onone page), the asset a release carries and
# .github/workflows/pages.yml deploys (Pages from an Actions artifact runs
# no Jekyll). Its files dereferenced, so the archive stands alone.
genrule(
    name = "isomer_site",
    srcs = [":storybook_web_application_site"],
    outs = ["isomer-site.tar.gz"],
    cmd = "tar -czhf $@ -C $(location :storybook_web_application_site) .",
)
