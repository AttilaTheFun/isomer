load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

# iOS-compiled form of the SwiftProtobuf greeter (simulator build — no
# provisioning; the compiled tier "obviously works", this proves it end to
# end through the same RSPM + swift_proto_library chain as the other
# platforms).
swift_library(
    name = "app_lib",
    srcs = ["GreeterApp.swift"],
    module_name = "ProtoGreeterIOS",
    tags = ["manual"],
    deps = ["//proto_greeter:greeter_swift_proto"],
)

ios_application(
    name = "proto_greeter_ios",
    bundle_id = "com.LoganShire.Isomer.ProtoGreeter",
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = "16.0",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":app_lib"],
)
