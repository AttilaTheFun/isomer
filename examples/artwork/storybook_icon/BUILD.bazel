package(default_visibility = ["//visibility:public"])

# The Storybook's icon as an Icon Composer document: what the iOS and Mac
# apps compile through `app_icons` (the platform supplies the shape and the
# material treatment).
filegroup(
    name = "app_icon",
    srcs = glob(["Storybook.icon/**"]),
)

# The Android launcher icon: the 1024 px export at 192 px
# (sips -z 192 192 Storybook-1024.png --out ic_launcher.png).
exports_files(["ic_launcher.png"])

# The 1024 px export: the web Storybook's favicon and touch icon.
filegroup(
    name = "web_icon",
    srcs = ["Storybook-1024.png"],
)
