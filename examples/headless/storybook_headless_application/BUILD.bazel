load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

# The Storybook headless (@isomer//headless/libraries/swift_ui): its UI read
# and driven over standard input and output, nothing drawn, on the building
# machine (a Mac, or Linux in a container). Build with --@isomer//headless:
#
#   bazel run --@isomer//headless //headless/storybook_headless_application
#   {"cmd": "ls"}
swift_binary(
    name = "storybook_headless_application",
    srcs = ["//shared/example_application:srcs"],
    copts = ["-parse-as-library"],
    module_name = "ExampleApplication",
    deps = [
        "//storybook",
        "//shared/platform_services",
        "@isomer//headless/libraries/swift_ui",
        "@isomer//headless/libraries/swift_ui:isomer",
    ],
)

# The Storybook's headless tests (StorybookHeadlessTests.swift): in a
# container in seconds, nothing drawn. With the app's flag:
#
#   bazel test --@isomer//headless //headless/...
swift_test(
    name = "storybook_headless_test",
    srcs = ["StorybookHeadlessTests.swift"],
    data = [":storybook_headless_application"],
    module_name = "StorybookHeadlessTests",
    deps = [
        "@isomer//headless/isomer_headless",
        "@isomer//shared/wire/swift",
    ],
)

# The same tests against the web Storybook headful: drawn by the React
# renderer in headless Chrome (web_launcher.sh), the driver built into the
# page, which dials out to the test's hub. In an invocation of its own, with
# the driver's flag (manual: //headless/... takes --@isomer//headless; the
# two flags in one build shadow swift-crypto's modules, AGENTS.md):
#
#   bazel test --@isomer//drive:headful //headless/storybook_headless_application:storybook_headful_web_test
_HEADFUL_WEB_ENV = {
    "ISOMER_BROWSER_CHECK": "$(rootpath @isomer//tools/testing/browser_check)",
    "ISOMER_HEADFUL_LAUNCHER": "$(rootpath web_launcher.sh)",
    "ISOMER_WEB_SITE": "$(rootpath //web/storybook_web_application:storybook_web_application_site)",
}

swift_test(
    name = "storybook_headful_web_test",
    size = "medium",
    srcs = ["StorybookHeadlessTests.swift"],
    data = [
        "web_launcher.sh",
        "//web/storybook_web_application:storybook_web_application_site",
        "@isomer//tools/testing/browser_check",
    ] + select({
        "//tests/platforms:linux_arm64": [
            "@chrome_linux_arm64//:chrome",
            "@chrome_linux_arm64//:files",
        ],
        "//tests/platforms:linux_x86_64": [
            "@chrome_linux_x86_64//:chrome",
            "@chrome_linux_x86_64//:files",
        ],
        "//conditions:default": [],
    }),
    # Chrome for Testing in a Linux container; on a Mac, the installed
    # Chrome (CHROME, or browser_check's default).
    env = select({
        "//tests/platforms:linux_arm64": _HEADFUL_WEB_ENV | {"CHROME": "$(rootpath @chrome_linux_arm64//:chrome)"},
        "//tests/platforms:linux_x86_64": _HEADFUL_WEB_ENV | {"CHROME": "$(rootpath @chrome_linux_x86_64//:chrome)"},
        "//conditions:default": _HEADFUL_WEB_ENV,
    }),
    module_name = "StorybookHeadfulTests",
    # Chrome starts its own sandbox (or, as root in a container, none):
    # not inside Bazel's.
    tags = [
        "manual",
        "no-sandbox",
    ],
    deps = [
        "@isomer//headless/isomer_headless",
        "@isomer//shared/wire/swift",
    ],
)
