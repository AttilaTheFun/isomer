load("@build_bazel_rules_apple//apple:ios.bzl", "ios_unit_test")
load("@build_bazel_rules_apple//apple/testing/default_runner:ios_test_runner.bzl", "ios_test_runner")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

# The Storybook headless (@isomer//headless/libraries/swift_ui): its UI read
# and driven over standard input and output, nothing drawn, on the building
# machine (a Mac, or Linux in a container). Build with --@isomer//headless:
#
#   bazel run --@isomer//headless //headless/storybook_headless_application
#   {"cmd": "ls"}
swift_binary(
    name = "storybook_headless_application",
    srcs = ["//shared/example_application:srcs"],
    copts = ["-parse-as-library"],
    module_name = "ExampleApplication",
    deps = [
        "//storybook",
        "//shared/platform_services",
        "@isomer//headless/libraries/swift_ui",
        "@isomer//headless/libraries/swift_ui:isomer",
    ],
)

# The Storybook's headless tests (StorybookHeadlessTests.swift): in a
# container in seconds, nothing drawn. With the app's flag:
#
#   bazel test --@isomer//headless //headless/...
swift_test(
    name = "storybook_headless_test",
    srcs = ["StorybookHeadlessTests.swift"],
    data = [":storybook_headless_application"],
    module_name = "StorybookHeadlessTests",
    deps = [
        "@isomer//headless/isomer_headless",
        "@isomer//shared/wire/swift",
    ],
)

# The same tests against the Storybook headful: each app built with
# --@isomer//drive:headful (its driver dials out to the test's hub), started
# by isomer's launcher for its platform (@isomer//drive/launchers), which
# also takes the tests' pictures. In invocations of their own, with the
# driver's flag (manual: //headless/... takes --@isomer//headless; the two
# flags in one build shadow swift-crypto's modules, AGENTS.md).
#
# The web's and Linux's run where they are built (CI's container: headless
# Chrome, Xvfb):
#
#   bazel test --@isomer//drive:headful :storybook_headful_web_test :storybook_headful_linux_test
#
# The iPhone's, the Mac's and Android's where the app runs, which the run's
# --test_env names (GitHub's VMs in a run by hand, tools/ci/hosted_headful_test.sh):
#
#   bazel test --test_env=ISOMER_SIMULATOR=<booted udid> :storybook_headful_ios_test
#   bazel test --test_env=ISOMER_MAC_APP=<Storybook.app> :storybook_headful_macos_test
#   bazel test --test_env=ANDROID_SERIAL=<serial> --test_env=ADB=<adb> :storybook_headful_android_test
#
# Windows': the test cross-built in CI's container for Windows on Arm
# (--config=windows_on_linux, which takes Bazel's legacy test toolchain:
# no execution platform there can run a Windows test), with the app, then
# run on GitHub's windows-11-arm (tools/ci/hosted_windows_test.ps1), which
# names the app and Git's bash:
#
#   storybook_headful_windows_test.exe, with ISOMER_HEADFUL_LAUNCHER=<windows_launcher.sh>
#   ISOMER_WINDOWS_APP=<storybook_windows_application.exe> ISOMER_BASH=<bash.exe>
_STORYBOOK = "com.LoganShire.IsomerStorybook"

_HEADFUL_WEB_ENV = {
    "ISOMER_BROWSER_CHECK": "$(rootpath @isomer//tools/testing/browser_check)",
    "ISOMER_HEADFUL_LAUNCHER": "$(rootpath @isomer//drive/launchers:web_launcher.sh)",
    "ISOMER_WEB_SITE": "$(rootpath //web/storybook_web_application:storybook_web_application_site)",
}

swift_test(
    name = "storybook_headful_web_test",
    size = "medium",
    srcs = ["StorybookHeadlessTests.swift"],
    data = [
        "//web/storybook_web_application:storybook_web_application_site",
        "@isomer//drive/launchers:web",
        "@isomer//drive/launchers:web_launcher.sh",
        "@isomer//tools/testing/browser_check",
    ] + select({
        "//tests/platforms:linux_arm64": [
            "@chrome_linux_arm64//:chrome",
            "@chrome_linux_arm64//:files",
        ],
        "//tests/platforms:linux_x86_64": [
            "@chrome_linux_x86_64//:chrome",
            "@chrome_linux_x86_64//:files",
        ],
        "//conditions:default": [],
    }),
    # Chrome for Testing in a Linux container; on a Mac, the installed
    # Chrome (CHROME, or browser_check's default).
    env = select({
        "//tests/platforms:linux_arm64": _HEADFUL_WEB_ENV | {"CHROME": "$(rootpath @chrome_linux_arm64//:chrome)"},
        "//tests/platforms:linux_x86_64": _HEADFUL_WEB_ENV | {"CHROME": "$(rootpath @chrome_linux_x86_64//:chrome)"},
        "//conditions:default": _HEADFUL_WEB_ENV,
    }),
    module_name = "StorybookHeadfulTests",
    # Chrome starts its own sandbox (or, as root in a container, none):
    # not inside Bazel's.
    tags = [
        "manual",
        "no-sandbox",
    ],
    deps = [
        "@isomer//headless/isomer_headless",
        "@isomer//shared/wire/swift",
    ],
)

swift_test(
    name = "storybook_headful_linux_test",
    size = "medium",
    srcs = ["StorybookHeadlessTests.swift"],
    data = [
        "//linux/storybook_linux_application",
        "@isomer//drive/launchers:linux",
        "@isomer//drive/launchers:linux_launcher.sh",
    ],
    env = {
        "ISOMER_HEADFUL_LAUNCHER": "$(rootpath @isomer//drive/launchers:linux_launcher.sh)",
        "ISOMER_LINUX_APP": "$(rootpath //linux/storybook_linux_application)",
    },
    module_name = "StorybookHeadfulLinuxTests",
    tags = [
        "manual",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@isomer//headless/isomer_headless",
        "@isomer//shared/wire/swift",
    ],
)

[
    swift_test(
        name = "storybook_headful_%s_test" % platform,
        size = "medium",
        srcs = ["StorybookHeadlessTests.swift"],
        data = [
            "@isomer//drive/launchers:%s" % platform,
            "@isomer//drive/launchers:%s_launcher.sh" % platform,
        ],
        env = {
            "ISOMER_ANDROID_PACKAGE": _STORYBOOK,
            "ISOMER_BUNDLE_ID": _STORYBOOK,
            "ISOMER_HEADFUL_LAUNCHER": "$(rootpath @isomer//drive/launchers:%s_launcher.sh)" % platform,
        },
        module_name = "StorybookHeadful%sTests" % platform.capitalize(),
        tags = [
            "manual",
            "no-sandbox",
        ],
        deps = [
            "@isomer//headless/isomer_headless",
            "@isomer//shared/wire/swift",
        ],
    )
    for platform in ["ios", "macos", "android"]
]

# Its tests listed by hand rather than discovered: rules_swift's discovery
# extracts a symbol graph, which the Windows cross-build can't (the
# extractor isn't given the Windows SDK's headers), so XCTMain runs what
# the test file's `func test…()` lines name.
genrule(
    name = "windows_test_main",
    srcs = ["StorybookHeadlessTests.swift"],
    outs = ["windows_test_main/main.swift"],
    cmd = """
{
  echo 'import XCTest'
  echo 'extension StorybookHeadlessTests {'
  echo '    static let allTests: [(String, (StorybookHeadlessTests) -> () throws -> Void)] = ['
  sed -n 's/^[[:space:]]*func \\(test[A-Za-z0-9_]*\\)() throws {.*/        ("\\1", \\1),/p' $<
  echo '    ]'
  echo '}'
  echo 'XCTMain([testCase(StorybookHeadlessTests.allTests)])'
} > $@
""",
)

swift_test(
    name = "storybook_headful_windows_test",
    size = "medium",
    srcs = [
        "StorybookHeadlessTests.swift",
        ":windows_test_main",
    ],
    discover_tests = False,
    module_name = "StorybookHeadfulWindowsTests",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "@isomer//headless/isomer_headless",
        "@isomer//shared/wire/swift",
    ],
)

# The same tests hosted in the app (the plan's fourth way): an XCTest bundle
# whose host is the iPhone Storybook built with --@isomer//drive:headful,
# driving it in its own process, synchronously, with no network, as an
# XCUITest drives its app (HeadlessApp.hosted, IsomerLocalServer). A story
# opens in-process (a notification the Storybook takes), with no launch
# between tests and nothing in the environment, which a runner such as
# `oss machine xctest` doesn't pass on.
#
#   bazel test --@isomer//drive:headful --ios_multi_cpus=sim_arm64 :storybook_hosted_ios_test
swift_library(
    name = "storybook_hosted_tests",
    testonly = True,
    srcs = ["StorybookHeadlessTests.swift"],
    module_name = "StorybookHostedTests",
    tags = ["manual"],
    deps = [
        "@isomer//headless/isomer_headless",
        "@isomer//shared/wire/swift",
    ],
)

# rules_apple's default runner makes an iPhone 15, which iOS 27 doesn't run:
# an iPhone 17 of the newest iOS the Xcode has, as hosted_apple_test.sh's.
ios_test_runner(
    name = "iphone_17",
    device_type = "iPhone 17",
    tags = ["manual"],
)

ios_unit_test(
    name = "storybook_hosted_ios_test",
    minimum_os_version = "17.0",
    runner = ":iphone_17",
    tags = ["manual"],
    test_host = "//apple/storybook_ios_application:storybook_test_host",
    deps = [":storybook_hosted_tests"],
)
