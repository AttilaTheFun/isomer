load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# The Linux **wasm** cell: the same shared example app, but delivered as an
# `example_full.wasm` reactor run under the WAMR interpreter instead of compiled
# into the binary. This ELF is just a loader — it reads the reactor bytes and
# runs them through `LinuxWasmApp` (SDL2 window + GL SwiftGPU renderer +
# `FlatTreeDecoder`), the wasm peer of `example_full_opengl_linux_application`.
#
# It links `swift_ui_wasm` (which adds the WAMR C host) rather than `swift_ui`,
# so the compiled cell never pulls in the interpreter.
swift_binary(
    name = "example_full_opengl_wasm_linux_application_bin",
    srcs = ["WasmMain.swift"],
    copts = ["-parse-as-library"],
    data = [
        "//shared/example_application:assets",
        "//wasm/example_full_feature:example_full_x86",
    ],
    module_name = "ExampleFullWasmCell",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@isomer//linux/libraries/swift_ui_wasm:host",
        "@isomer//linux/libraries/swift_ui_wasm:swift_ui_wasm",
    ],
)

# `bazel run …` launches the wasm cell on this machine. Like the compiled
# runner it points LD_LIBRARY_PATH at the swift.org runtime; additionally it
# resolves the reactor's runfiles path and passes it as the first argument.
sh_binary(
    name = "example_full_opengl_wasm_linux_application",
    srcs = ["run_linux_wasm.sh"],
    data = [
        ":example_full_opengl_wasm_linux_application_bin",
        "//shared/example_application:assets",
        "//wasm/example_full_feature:example_full_x86",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
