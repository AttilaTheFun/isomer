load("@rules_swift//swift:swift.bzl", "swift_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# The shared SwiftUI application as a native Linux (x86_64 ELF) executable. Like
# the native Windows target — and unlike the wasm/Android targets, which
# cross-compile via a platform transition and are driven by an external host —
# this builds on the Linux host with the swift.org toolchain registered in
# MODULE.bazel: the app owns `main`, creating the SDL2 window and running the
# OpenGL render loop itself (see `App.main()` -> `LinuxApp.run()`).
#
# `target_compatible_with` makes it cleanly skipped in `//...` builds on
# non-Linux hosts rather than failing to configure.
swift_binary(
    name = "storybook_linux_application_bin",
    srcs = ["//shared/example_application:srcs"],
    copts = ["-parse-as-library"],
    data = ["//shared/example_application:assets"],
    module_name = "ExampleApplication",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@isomer//storybook",
        "//shared/platform_services",
        "@isomer//linux/libraries/swift_ui",
        "@isomer//linux/libraries/swift_ui:isomer",
    ],
)

# `bazel run //linux/storybook_linux_application` launches the app on this
# machine. The wrapper points LD_LIBRARY_PATH at the swift.org Swift runtime
# (whose runfiles-relative RUNPATH doesn't resolve under `bazel run`) and execs
# the real binary — mirroring the Android/wasm runner targets.
sh_binary(
    name = "storybook_linux_application",
    srcs = ["run_linux.sh"],
    data = [
        ":storybook_linux_application_bin",
        "//shared/example_application:assets",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
