<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The simulator's: no team (its builds name none), so the keychain
	     group is the bundle id alone -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(CFBundleIdentifier)</string>
	</array>
	<!-- Applications' container, where the app writes the build it is
	     (ApplicationUpdates) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.LoganShire.Applications</string>
	</array>
</dict>
</plist>
