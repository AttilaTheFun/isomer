load("@rules_swift//swift:swift.bzl", "swift_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# The Playground on Linux: the shared shell (shared/app) against Isomer's
# Linux SwiftUI (SwiftGPU over OpenGL in an SDL2 window), with the desktop
# host (shared/desktop_host). A project compiles with the compiler beside
# the app (shared/compiler:toolchain, swift-frontend and wasm-ld run as
# processes) against the Playground SDK, and its build runs in the WasmKit
# loader's window (:playground_wasm_loader). Built in a container on a Mac (isomer's
# tools/linux/build.sh), run on a Linux desktop:
#
#   bazel run //playground/linux/playground_linux_application
#   linux/playground_linux_application/package.sh <out dir>   # one directory to copy to a machine

swift_binary(
    name = "playground_linux_application_bin",
    srcs = [
        "//playground/shared/app:srcs",
        "//playground/shared/compiler:srcs",
        "//playground/shared/desktop_host:srcs",
    ],
    copts = ["-parse-as-library"],
    data = [
        ":playground_wasm_loader",
        "//playground/apple/playground_ios_application:playground_sdk",
        "//playground/shared/compiler:toolchain",
    ],
    module_name = "PlaygroundLinux",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@isomer//linux/libraries/swift_ui",
        "@isomer//linux/libraries/swift_ui:isomer",
        "@isomer//shared/platform_services",
        "@swiftpkg_agent_ui//:AgentUI",
    ],
)

# A build's window (LinuxWasmApp: WasmKit, SwiftGPU over OpenGL).
swift_binary(
    name = "playground_wasm_loader",
    srcs = ["//playground/shared/desktop_host:PlaygroundWasmLoader.swift"],
    copts = ["-parse-as-library"],
    module_name = "PlaygroundWasmLoader",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@isomer//linux/libraries/swift_ui_wasm:host",
        "@isomer//linux/libraries/swift_ui_wasm:swift_ui_wasm",
    ],
)

# `bazel run`: the Swift runtime on LD_LIBRARY_PATH, the app's files in its
# runfiles.
sh_binary(
    name = "playground_linux_application",
    srcs = ["run.sh"],
    data = [":playground_linux_application_bin"],
    target_compatible_with = ["@platforms//os:linux"],
)
