load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@isomer//tools/wasm:defs.bzl", "isomer_web_app")

# The web Playground — the iOS Playground's concept as a static site: the app
# itself is Isomer SwiftUI compiled to wasm, and it compiles + runs the
# user's Swift in the browser (docs/playground_web.md).
# The web app's @main, for the Android app too (it builds the same shell
# against Isomer's Android SwiftUI, with its host in Kotlin).
exports_files(
    ["WebApp.swift"],
    visibility = ["//visibility:public"],
)

swift_library(
    name = "app_lib",
    srcs = [
        "WebApp.swift",
        "//playground/shared/app:srcs",
    ],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "PlaygroundWeb",
    tags = ["manual"],
    deps = [
        "@isomer//shared/platform_services",
        "@swiftpkg_agent_ui//:AgentUI",
        "@isomer//wasm/libraries/swift_ui",
        "@isomer//wasm/libraries/swift_ui:isomer",
    ],
)

# The bundled sample apps (the same sources the iOS Playground seeds), served
# under assets/ for the New Project template picker.
# What the iOS and Android apps' web-run site takes from this app's compiled
# bridge: the swift_ffi runtime (the WASI shim hot_host.js imports) and the
# bindings whose `Dependencies` builders for the platform services the page
# injects into a project it runs.
filegroup(
    name = "swift_ffi_runtime_js",
    srcs = [":app_bridge_runtime_js"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "app_bridge_js_files",
    srcs = [":app_bridge_js"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "templates",
    # The Android Playground's templates too.
    visibility = ["//visibility:public"],
    srcs = [
        "//playground/apple/playground_ios_application:counter_sample",
        "//playground/apple/playground_ios_application:game2048_sample",
        "//playground/apple/playground_ios_application:hackernews_sample",
        "//playground/apple/playground_ios_application:meme_sample",
        "//playground/apple/playground_ios_application:pokedex_sample",
        "//playground/apple/playground_ios_application:date_planner_sample",
        "//playground/apple/playground_ios_application:map_explorer_sample",
        "//playground/apple/playground_ios_application:floating_menu_sample",
        # The site's front page, editable in the Playground ("This website"),
        # with the example screens it embeds.
        "//playground/apple/playground_ios_application:splash_sample",
    ],
)

isomer_web_app(
    name = "playground_web_application",
    assets = [
        ":templates",
        "//playground/artwork/playground_icon:web_icon",
    ],
    extra_pages = [
        "compiler_worker.js",
        "hot_runner.js",
        "toolchain_driver.js",
    ],
    index = "index.html",
    query = "renderer=react",
    site_visibility = ["//visibility:public"],
    swift_library = ":app_lib",
)

# Local smoke (needs Chrome + the host toolchain; `bazel test --test_output=streamed`):
# serves the site with the dev compile server, then drives the page's host
# hook headlessly — compile the Counter sample, run it, tap, read the tree.
sh_test(
    name = "smoke",
    srcs = ["smoke_test.sh"],
    args = [
        "$(rootpath :playground_web_application_site)",
        "$(rootpath //playground/apple/playground_ios_application:playground_sdk)",
        "$(rootpath //playground/tools/playground:dev_compile_server.py)",
        "$(rootpath //playground/tools/playground:cdp_eval.js)",
    ],
    data = [
        ":playground_web_application_site",
        "//playground/apple/playground_ios_application:playground_sdk",
        "//playground/tools/playground:cdp_eval.js",
        "//playground/tools/playground:dev_compile_server.py",
    ],
    tags = ["local", "manual", "requires-network"],
)
