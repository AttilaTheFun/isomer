# The Playground's host on Linux and Windows (DesktopHost.swift), its @main
# (DesktopApp.swift), and the WasmKit loader a project's build runs in
# (PlaygroundWasmLoader.swift): compiled by linux/playground_linux_application
# and windows/playground_windows_application.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = [
        "DesktopApp.swift",
        "DesktopHost.swift",
    ],
)

exports_files(["PlaygroundWasmLoader.swift"])
