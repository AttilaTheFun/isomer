diff --git a/cmake/modules/AddPureSwift.cmake b/cmake/modules/AddPureSwift.cmake
index 72bcabb921a..aa0f83415df 100644
--- a/cmake/modules/AddPureSwift.cmake
+++ b/cmake/modules/AddPureSwift.cmake
@@ -66,6 +66,21 @@ function(_add_host_swift_compile_options name)
       swift_android_tools_path(${SWIFT_HOST_VARIANT_ARCH} tools_path)
       target_compile_options(${name} PRIVATE $<$<COMPILE_LANGUAGE:Swift>:-tools-directory;${tools_path};>)
     endif()
+    if(SWIFT_HOST_VARIANT_SDK STREQUAL "WASI")
+      # The C++ these libraries import (LLVM's headers) needs WASI's emulations
+      # and the threading shims, as SwiftCompilerSources gets them.
+      # In pairs ("-Xcc -D…"), each as one SHELL: option: CMake drops a
+      # repeated single option, which would split -Xcc from its argument.
+      set(pending "")
+      foreach(flag ${SWIFT_COMPILER_SOURCES_SDK_FLAGS})
+        if(pending)
+          target_compile_options(${name} PRIVATE "$<$<COMPILE_LANGUAGE:Swift>:SHELL:${pending} ${flag}>")
+          set(pending "")
+        else()
+          set(pending "${flag}")
+        endif()
+      endforeach()
+    endif()
   endif()
 
   target_compile_options(${name} PRIVATE
