 using namespace swift;
 
+#if defined(__wasi__)
+// A compiler built for WebAssembly runs no processes: an executable plugin is a
+// WASI module (a macro plugin built for wasm32-wasip1, which serves requests
+// through swift-syntax's `swift_wasm_macro_v1_pump`) that the host
+// instantiates beside the compiler. These imports are the plugin's pipes:
+// `write` gives it bytes (the host pumps it once a whole message has come),
+// `read` takes back what it wrote. A handle stands for both pipes.
+extern "C" {
+__attribute__((import_module("iso_plugin"), import_name("open")))
+int iso_plugin_open(const char *path, size_t length);
+__attribute__((import_module("iso_plugin"), import_name("write")))
+long iso_plugin_write(int plugin, const void *bytes, size_t length);
+__attribute__((import_module("iso_plugin"), import_name("read")))
+long iso_plugin_read(int plugin, void *bytes, size_t length);
+__attribute__((import_module("iso_plugin"), import_name("close")))
+void iso_plugin_close(int plugin);
+}
+#endif
