diff --git a/include/swift/Basic/PointerIntPairCompat.h b/include/swift/Basic/PointerIntPairCompat.h
new file mode 100644
index 00000000000..73686bd474a
--- /dev/null
+++ b/include/swift/Basic/PointerIntPairCompat.h
@@ -0,0 +1,48 @@
+//===--- PointerIntPairCompat.h - PointerIntPair for 32-bit hosts -*- C++ -*-===//
+//
+// llvm::PointerIntPair packs its integer into a pointer's spare low bits;
+// on a 32-bit host (wasm32) a 4-byte-aligned pointee leaves only two, and
+// a few compiler data structures need three. SWIFT_WIDE_POINTER_INT_PAIR is
+// llvm::PointerIntPair on 64-bit hosts and this side-by-side pair otherwise.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef SWIFT_BASIC_POINTERINTPAIRCOMPAT_H
+#define SWIFT_BASIC_POINTERINTPAIRCOMPAT_H
+
+#include "llvm/ADT/PointerIntPair.h"
+
+namespace swift {
+
+template <typename PointerTy, unsigned IntBits, typename IntType = unsigned>
+class PointerIntPairCompat {
+  PointerTy Ptr = PointerTy();
+  IntType Int = IntType();
+
+public:
+  constexpr PointerIntPairCompat() = default;
+  PointerIntPairCompat(PointerTy PtrVal, IntType IntVal) : Ptr(PtrVal), Int(IntVal) {}
+  explicit PointerIntPairCompat(PointerTy PtrVal) : Ptr(PtrVal) {}
+
+  PointerTy getPointer() const { return Ptr; }
+  IntType getInt() const { return Int; }
+  void setPointer(PointerTy PtrVal) { Ptr = PtrVal; }
+  void setInt(IntType IntVal) { Int = IntVal; }
+  void setPointerAndInt(PointerTy PtrVal, IntType IntVal) { Ptr = PtrVal; Int = IntVal; }
+  PointerTy const *getAddrOfPointer() const { return &Ptr; }
+  PointerTy *getAddrOfPointer() { return &Ptr; }
+
+  bool operator==(const PointerIntPairCompat &RHS) const { return Ptr == RHS.Ptr && Int == RHS.Int; }
+  bool operator!=(const PointerIntPairCompat &RHS) const { return !(*this == RHS); }
+  bool operator<(const PointerIntPairCompat &RHS) const { return Ptr < RHS.Ptr || (Ptr == RHS.Ptr && Int < RHS.Int); }
+};
+
+} // namespace swift
+
+#if __SIZEOF_POINTER__ == 4
+#define SWIFT_WIDE_POINTER_INT_PAIR swift::PointerIntPairCompat
+#else
+#define SWIFT_WIDE_POINTER_INT_PAIR llvm::PointerIntPair
+#endif
+
+#endif
