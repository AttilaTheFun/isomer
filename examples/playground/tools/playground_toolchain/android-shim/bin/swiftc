#!/bin/bash
# swiftc for the compiler's own Swift sources (SwiftCompilerSources), built
# for the Android host: the base swiftc (swift.org's of the sources' release,
# as build_phase_c2_android_swift.sh finds it) with the Android sysroot,
# Swift resources and NDK tools added, which the build's plain
# `-target aarch64-unknown-linux-android` invocations leave out. The
# resource dir is android-swift-resources (build_phase_c2_android_swift.sh):
# the bundle's, plus a `clang` link to this NDK's builtin headers (the
# bundle's own link points at a Linux NDK).
HERE="$(cd "$(dirname "$0")/../.." && pwd)"
SWIFT_RELEASE=6.4.2
NDK="${ISO_NDK:-$(grep -l "Pkg.Revision = 30\." ~/Library/Caches/bazel/_bazel_*/*/external/hermetic_android_toolchains++android+androidndk_darwin/source.properties 2>/dev/null | head -1 | xargs dirname 2>/dev/null)}"
BASE_TC="${ISO_BASE_TC:-}"
if [ -z "$BASE_TC" ]; then
  for version in ~/Library/Caches/bazel/_bazel_*/*/external/rules_swift++swift+swift_toolchain_xcode/.swift-version; do
    [ "$(cat "$version" 2>/dev/null)" = "$SWIFT_RELEASE" ] && { BASE_TC="$(dirname "$version")/usr/bin"; break; }
  done
fi
# NDK r30's headers refuse a triple without an API level (sys/cdefs.h), which
# the build's SwiftCompilerSources pass: give it the build's (ISO_ANDROID_API).
args=()
for arg in "$@"; do
    case "$arg" in
        *-linux-android) args+=("$arg${ISO_ANDROID_API:-28}") ;;
        *) args+=("$arg") ;;
    esac
done
exec "$BASE_TC/swiftc" \
    -sdk "$HERE/android-sysroot" \
    -resource-dir "$HERE/android-swift-resources" \
    -tools-directory "$NDK/toolchains/llvm/prebuilt/darwin-x86_64/bin" \
    "${args[@]}"
