load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_library")
load("@isomer//swift_ffi/rules:swift_wasm_reactor.bzl", "transition_binary")
load("@isomer//tools/wasm:defs.bzl", "reactor_artifact")

package(default_visibility = ["//visibility:public"])

# The minimal counter app as a `iso_hot` wasm reactor — the wasm-delivery cell of
# the cross-framework benchmark (interpreted by the host's WasmKit).
# Same shared TapCounter.swift the compiled Android cell builds; the reactor glue
# (HotReloadBridge) is the standard app-agnostic iso_hot ABI. Mirrors
# hot_demo_feature but with the minimal counter and no extra deps.

swift_library(
    name = "tap_counter_lib",
    srcs = ["//shared/tap_counter_application:srcs"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "TapCounterApp",
    tags = ["manual"],
    deps = ["@isomer//wasm/libraries/hot_swift_ui"],
)

# PRODUCTION reactor: ABI-only exports, --gc-sections, stripped (the shape the
# APK ships). Matches hot_demo_reactor_release.
swift_binary(
    name = "tap_counter_reactor_release",
    copts = [
        "-enable-experimental-feature",
        "Extern",
    ],
    linkopts = [
        "-Xlinker",
        "--gc-sections",
        "-Xlinker",
        "--strip-all",
        "-Xlinker",
        "--export=_initialize",
        "-Xlinker",
        "--export=iso_hot_start",
        "-Xlinker",
        "--export=iso_hot_render",
        "-Xlinker",
        "--export=iso_hot_resize",
        "-Xlinker",
        "--export=iso_hot_configure",
        "-Xlinker",
        "--export=iso_hot_set_color_scheme",
        "-Xlinker",
        "--export=iso_hot_event",
        "-Xlinker",
        "--export=iso_hot_alloc",
        "-Xlinker",
        "--export=iso_hot_free",
        "-Xlinker",
        "--export=iso_hot_shutdown",
        "-Xlinker",
        "--export=iso_hot_pending_tasks",
        "-Xlinker",
        "-z",
        "-Xlinker",
        "stack-size=16777216",
    ],
    linkshared = True,
    module_name = "tap_counter_reactor",
    tags = ["manual"],
    deps = [
        # The framework-owned iso_hot bridge (exports can't drift per app).
        "@isomer//wasm/libraries/hot_swift_ui:hot_bridge",
        ":tap_counter_lib",
        "@isomer//wasm/libraries/hot_swift_ui",
    ],
)

transition_binary(
    name = "tap_counter_release.wasm",
    binary = ":tap_counter_reactor_release",
    platform = "@isomer//swift_ffi/rules:wasm32-wasip1",
    tags = ["manual"],
)

# The reactor the Android APK packages.
reactor_artifact(
    name = "tap_counter_release",
    wasm = ":tap_counter_release.wasm",
)

# The desktop (Linux/Windows) flavour: the same reactor bytes, under the name
# the Linux wasm benchmark cell loads.
reactor_artifact(
    name = "tap_counter_x86",
    wasm = ":tap_counter_release.wasm",
)

# ---- GPU reactor: the SAME app, self-drawing. SwiftGPURenderer runs inside
# the module over swift_gpu's GLES backend; its gl* calls surface as "env"
# imports (hence `--allow-undefined`) that the host binds to native OpenGL ES.
# Only measurement/rasterization cross out (iso_gpu imports). ----

swift_library(
    name = "tap_counter_gpu_lib",
    srcs = ["//shared/tap_counter_application:srcs"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "TapCounterAppGpu",
    tags = ["manual"],
    deps = ["@isomer//wasm/libraries/hot_swift_ui_gpu"],
)

swift_binary(
    name = "tap_counter_gpu_reactor_release",
    copts = [
        "-enable-experimental-feature",
        "Extern",
    ],
    linkopts = [
        "-Xlinker",
        "--gc-sections",
        "-Xlinker",
        "--strip-all",
        # The swift_gpu GLES backend's @_extern(c) gl* symbols intentionally
        # stay undefined: wasm-ld turns them into "env" imports a host binds
        # to real native GL (Android's GLES shim did, with WAMR, until 0.38;
        # no host runs this reactor now: it keeps hot_swift_ui_gpu building).
        "-Xlinker",
        "--allow-undefined",
        "-Xlinker",
        "--export=_initialize",
        "-Xlinker",
        "--export=iso_hot_start",
        "-Xlinker",
        "--export=iso_hot_render",
        "-Xlinker",
        "--export=iso_hot_resize",
        "-Xlinker",
        "--export=iso_hot_configure",
        "-Xlinker",
        "--export=iso_hot_set_color_scheme",
        "-Xlinker",
        "--export=iso_hot_surface_changed",
        "-Xlinker",
        "--export=iso_hot_pointer",
        "-Xlinker",
        "--export=iso_hot_alloc",
        "-Xlinker",
        "--export=iso_hot_free",
        "-Xlinker",
        "-z",
        "-Xlinker",
        "stack-size=16777216",
    ],
    linkshared = True,
    module_name = "tap_counter_gpu_reactor",
    tags = ["manual"],
    deps = [
        # The framework-owned iso_hot bridge (exports can't drift per app).
        "@isomer//wasm/libraries/hot_swift_ui_gpu:gpu_reactor_bridge",
        ":tap_counter_gpu_lib",
        "@isomer//wasm/libraries/hot_swift_ui_gpu",
    ],
)

transition_binary(
    name = "tap_counter_gpu_release.wasm",
    binary = ":tap_counter_gpu_reactor_release",
    platform = "@isomer//swift_ffi/rules:wasm32-wasip1",
    tags = ["manual"],
)

reactor_artifact(
    name = "tap_counter_gpu_release",
    wasm = ":tap_counter_gpu_release.wasm",
)

# ---- The threaded twin (wasm32-unknown-wasip1-threads): the same reactor
# built with the threads SDK, its memory imported and shared (every guest
# thread's instance maps the one memory) with the maximum wasi-threads needs.
# WasmKitRuntime runs it with guest threads where WasmKit can (the engine
# tests). ----

swift_binary(
    name = "tap_counter_threads_reactor_release",
    copts = [
        "-enable-experimental-feature",
        "Extern",
    ],
    linkopts = [
        "-Xlinker",
        "--gc-sections",
        "-Xlinker",
        "--strip-all",
        "-Xlinker",
        "--import-memory",
        "-Xlinker",
        "--export-memory",
        "-Xlinker",
        "--shared-memory",
        "-Xlinker",
        "--max-memory=268435456",
        "-Xlinker",
        "--export=_initialize",
        "-Xlinker",
        "--export=iso_hot_start",
        "-Xlinker",
        "--export=iso_hot_render",
        "-Xlinker",
        "--export=iso_hot_resize",
        "-Xlinker",
        "--export=iso_hot_configure",
        "-Xlinker",
        "--export=iso_hot_set_color_scheme",
        "-Xlinker",
        "--export=iso_hot_event",
        "-Xlinker",
        "--export=iso_hot_alloc",
        "-Xlinker",
        "--export=iso_hot_free",
        "-Xlinker",
        "--export=iso_hot_shutdown",
        "-Xlinker",
        "--export=iso_hot_pending_tasks",
        "-Xlinker",
        "-z",
        "-Xlinker",
        "stack-size=16777216",
    ],
    linkshared = True,
    module_name = "tap_counter_threads_reactor",
    tags = ["manual"],
    deps = [
        "@isomer//wasm/libraries/hot_swift_ui:hot_bridge",
        ":tap_counter_lib",
        "@isomer//wasm/libraries/hot_swift_ui",
    ],
)

transition_binary(
    name = "tap_counter_threads_release.wasm",
    binary = ":tap_counter_threads_reactor_release",
    platform = "@isomer//swift_ffi/rules:wasm32-wasip1-threads",
    tags = ["manual"],
)
