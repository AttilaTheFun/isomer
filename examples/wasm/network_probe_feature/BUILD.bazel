load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_library")
load("@isomer//swift_ffi/rules:swift_wasm_reactor.bzl", "transition_binary")

package(default_visibility = ["//visibility:public"])

# The network probe (//shared/network_probe_application) as an `iso_hot`
# reactor on the full SwiftUI, for a WasmView: its URLSession goes through
# the network hosts WasmView injects (Apple's URLSession). Run by
# //apple/network_probe_wasm_ios_application.

swift_library(
    name = "network_probe_lib",
    srcs = ["//shared/network_probe_application:srcs"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "NetworkProbe",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@isomer//wasm/libraries/swift_ui",
    ],
)

# The reactor: the framework's iso_hot bridge (which installs the injected
# network hosts before the app's @main) + the probe. Exported whole, as the
# other development reactors are; the 16 MiB stack matches them.
swift_binary(
    name = "network_probe_reactor",
    copts = [
        "-enable-experimental-feature",
        "Extern",
    ],
    linkopts = [
        "-Xlinker",
        "--export-all",
        "-Xlinker",
        "--no-gc-sections",
        "-Xlinker",
        "-z",
        "-Xlinker",
        "stack-size=16777216",
    ],
    linkshared = True,
    module_name = "network_probe_reactor",
    tags = ["manual"],
    deps = [
        "@isomer//wasm/libraries/swift_ui:hot_bridge",
        ":network_probe_lib",
        "@isomer//wasm/libraries/swift_ui",
    ],
)

transition_binary(
    name = "network_probe.wasm",
    binary = ":network_probe_reactor",
    platform = "@isomer//swift_ffi/rules:wasm32-wasip1",
    tags = ["manual"],
)

# The same probe threaded (wasm32-unknown-wasip1-threads: its memory
# imported, exported and shared, with a maximum), as example_full's threaded
# reactor was: the engine tests' networking check on WasmKit's WASI Threads.
swift_binary(
    name = "network_probe_threads_reactor",
    copts = [
        "-enable-experimental-feature",
        "Extern",
    ],
    linkopts = [
        "-Xlinker",
        "--export-all",
        "-Xlinker",
        "--no-gc-sections",
        "-Xlinker",
        "--import-memory",
        "-Xlinker",
        "--export-memory",
        "-Xlinker",
        "--shared-memory",
        "-Xlinker",
        "--max-memory=268435456",
        "-Xlinker",
        "-z",
        "-Xlinker",
        "stack-size=16777216",
    ],
    linkshared = True,
    module_name = "network_probe_threads_reactor",
    tags = ["manual"],
    deps = [
        "@isomer//wasm/libraries/swift_ui:hot_bridge",
        ":network_probe_lib",
        "@isomer//wasm/libraries/swift_ui",
    ],
)

transition_binary(
    name = "network_probe_threads.wasm",
    binary = ":network_probe_threads_reactor",
    platform = "@isomer//swift_ffi/rules:wasm32-wasip1-threads",
    tags = ["manual"],
)
