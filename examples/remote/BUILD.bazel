load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

# An app built headless, served and driven over isomer's drive/ transports
# (docs/drive_plan.md): the Storybook listening on gRPC, a WebSocket and a
# Unix socket, with tokens; a head's session; the app dialling out to the
# `isomer` CLI's hub. With the app's flag:
#
#   bazel test --@isomer//headless //remote/...
swift_test(
    name = "remote_test",
    srcs = ["RemoteTests.swift"],
    data = [
        "//headless/storybook_headless_application",
        "@isomer//xplat/iso",
    ],
    env = {"ISOMER_CLI": "$(rootpath @isomer//xplat/iso)"},
    module_name = "RemoteTests",
    deps = [
        "@isomer//drive/remote",
        "@isomer//drive/serving",
        "@isomer//headless/isomer_headless",
        "@isomer//shared/isomer_swift_ui",
        "@isomer//shared/wire/swift",
    ],
)

# The `iso` CLI driving the Storybook: an exec: application added,
# selected, driven a command at a time (the app kept running between them on
# a Unix socket), and stopped (cli_test.sh).
sh_test(
    name = "cli_test",
    size = "small",
    srcs = ["cli_test.sh"],
    args = [
        "$(rootpath @isomer//xplat/iso)",
        "$(rootpath //headless/storybook_headless_application)",
    ],
    data = [
        "//headless/storybook_headless_application",
        "@isomer//xplat/iso",
    ],
)

# The web's thin client (isomer's //web/remote_client) in headless Chrome,
# drawing the app over its WebSocket and clicking in it (web_test.sh): Chrome
# for Testing on Linux, the Mac's own Chrome on a Mac.
sh_test(
    name = "web_test",
    size = "medium",
    srcs = ["web_test.sh"],
    args = [
        "$(rootpath //headless/storybook_headless_application)",
        "$(rootpath @isomer//tools/testing/browser_check)",
        "$(rootpath @isomer//web/remote_client)",
    ] + select({
        "//tests/platforms:linux_arm64": ["$(rootpath @chrome_linux_arm64//:chrome)"],
        "//tests/platforms:linux_x86_64": ["$(rootpath @chrome_linux_x86_64//:chrome)"],
        "//conditions:default": ["''"],
    }),
    data = [
        "//headless/storybook_headless_application",
        "@isomer//tools/testing/browser_check",
        "@isomer//web/remote_client",
    ] + select({
        "//tests/platforms:linux_arm64": [
            "@chrome_linux_arm64//:chrome",
            "@chrome_linux_arm64//:files",
        ],
        "//tests/platforms:linux_x86_64": [
            "@chrome_linux_x86_64//:chrome",
            "@chrome_linux_x86_64//:files",
        ],
        "//conditions:default": [],
    }),
    # Chrome starts its own sandbox (or, as root in a container, none):
    # not inside Bazel's.
    tags = ["no-sandbox"],
)

# A headful app driven from the command line (headful_web_test.sh): the web
# Storybook in headless Chrome dials out to the `isomer` CLI's hub
# (ISO_DRIVER), which the CLI drives it through. The site needs the driver
# built in, in an invocation of its own (manual: not in //remote/..., whose
# other tests take --@isomer//headless; the two flags in one build shadow
# swift-crypto's modules, as builds of the package's modules in two
# configurations can, AGENTS.md):
#
#   bazel test --@isomer//drive:headful //remote:headful_web_test
sh_test(
    name = "headful_web_test",
    size = "medium",
    srcs = ["headful_web_test.sh"],
    args = [
        "$(rootpath @isomer//xplat/iso)",
        "$(rootpath @isomer//tools/testing/browser_check)",
        "$(rootpath //web/storybook_web_application:storybook_web_application_site)",
    ] + select({
        "//tests/platforms:linux_arm64": ["$(rootpath @chrome_linux_arm64//:chrome)"],
        "//tests/platforms:linux_x86_64": ["$(rootpath @chrome_linux_x86_64//:chrome)"],
        "//conditions:default": ["''"],
    }),
    data = [
        "//web/storybook_web_application:storybook_web_application_site",
        "@isomer//xplat/iso",
        "@isomer//tools/testing/browser_check",
    ] + select({
        "//tests/platforms:linux_arm64": [
            "@chrome_linux_arm64//:chrome",
            "@chrome_linux_arm64//:files",
        ],
        "//tests/platforms:linux_x86_64": [
            "@chrome_linux_x86_64//:chrome",
            "@chrome_linux_x86_64//:files",
        ],
        "//conditions:default": [],
    }),
    # Chrome starts its own sandbox (or, as root in a container, none):
    # not inside Bazel's.
    tags = [
        "manual",
        "no-sandbox",
    ],
)
