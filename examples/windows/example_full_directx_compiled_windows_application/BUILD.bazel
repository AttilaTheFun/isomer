load("@rules_swift//swift:swift.bzl", "swift_binary")

package(default_visibility = ["//visibility:public"])

# The shared SwiftUI application as a native Windows `.exe`. Unlike the wasm and
# Android targets (which cross-compile via a platform transition and are driven
# by an external host), this builds on the Windows host with rules_swift's
# Windows host toolchain: the app owns `main`, creating the window and running
# the Direct2D render loop itself (see `App.main()` / `WindowsApp.run()`).
#
# `target_compatible_with` makes it cleanly skipped in `//...` builds on
# non-Windows hosts rather than failing to configure.
swift_binary(
    name = "example_full_directx_compiled_windows_application",
    srcs = ["//shared/example_application:srcs"],
    copts = ["-parse-as-library"],
    data = ["//shared/example_application:assets"],
    # Build as a GUI app (no console window). `/ENTRY:mainCRTStartup` keeps the
    # console-style CRT entry that runs Swift's `@main` `main`, but the WINDOWS
    # subsystem means no console is allocated.
    #
    # `/STACK` gives the main thread a 64 MiB stack. The render loop runs on the
    # main thread, and Swift's deeply recursive view-tree build / generic-
    # metadata instantiation overflows the default 1 MiB stack on complex views
    # (the wasm build raises its stack for the same reason). A stack overflow
    # can't be reported by the unhandled-exception filter, so it looks like a
    # silent crash.
    linkopts = [
        "/SUBSYSTEM:WINDOWS",
        "/ENTRY:mainCRTStartup",
        "/STACK:16777216",
    ],
    module_name = "ExampleApplication",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//shared/platform_services",
        "@isomer//windows/libraries/swift_ui",
        "@isomer//windows/libraries/swift_ui:isomer",
    ],
)
