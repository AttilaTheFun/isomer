load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcodeproj")

BUNDLE_ID = "com.LoganShire.IsomerExamples"

# The shared SwiftUI application, compiled against the real SwiftUI.
swift_library(
    name = "example_full_compiled_macos_application_lib",
    srcs = ["//shared/example_application:srcs"],
    data = ["//shared/example_application:xcassets"],
    deps = [
        "@isomer//gallery",
        "//shared/platform_services",
        "@isomer//apple/libraries/swift_ui",
        "@isomer//apple/libraries/swift_ui:isomer",
    ],
)

# `bazel run //apple/example_application` launches the app.
macos_application(
    name = "example_full_compiled_macos_application",
    bundle_id = BUNDLE_ID,
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    visibility = ["//visibility:public"],
    deps = [":example_full_compiled_macos_application_lib"],
)

# `bazel run //apple/example_full_compiled_macos_application:example_full_compiled_macos_application_project`
# generates ExampleMacosApplication.xcodeproj in this directory (gitignored).
xcodeproj(
    name = "example_full_compiled_macos_application_project",
    project_name = "ExampleMacosApplication",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(":example_full_compiled_macos_application"),
    ],
)
