load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcodeproj")
load("//tools/signing:defs.bzl", "shared_signin_entitlements", "stamped_infoplist")
load("//tools/variant:defs.bzl", "variant_infoplist")

# What the apps tell UpdateKit (the distributor's app group and, on a Mac,
# its bundle ids) and the builder's other keys (ShakeKit's, the shared GitHub
# sign-in's), from the builder's environment (tools/signing).
stamped_infoplist(name = "stamped_plist")

# The Storybook on the Mac: the Storybook's own app, which releases hand out.
# One bundle id for every build and for the iPhone's
# (the private AttilaTheFun/applications' docs/VARIANTS.md).
BUNDLE_ID = "com.LoganShire.IsomerStorybook"

# BuildVariant and the name under its icon (//tools/variant), as the
# iPhone's. No entitlements of its own: Applications' app group comes with the
# Developer ID profile CI signs it with (build_tools' `sign apple`, for an app
# built with none), as Reviews' Mac app's; without it AppUpdates.start() logs
# that there is no container. Where the builder sets the shared GitHub
# sign-in, the app is built with entitlements naming its keychain group and
# the app groups (tools/signing), which that profile must allow; otherwise
# ShakeKit signs in on its own.
variant_infoplist(
    name = "variant_plist",
    display_name = "Storybook",
    # Its link scheme: how Applications opens it, and links into it.
    url_scheme = "storybook",
)

# The Storybook (//shared/example_application), compiled against Apple's
# SwiftUI for macOS.
swift_library(
    name = "storybook_macos_application_lib",
    srcs = ["//shared/example_application:srcs"],
    data = ["//shared/example_application:xcassets"],
    deps = [
        "//storybook",
        "//shared/platform_services",
        "@isomer//apple/libraries/swift_ui",
        "@isomer//apple/libraries/swift_ui:isomer",
        # The build it is, written for Applications at launch (ExampleApp.swift).
        "@swiftpkg_update_kit//:UpdateKit",
        # Shake (or Help › Report a Bug…) to file an issue, where the build opts in.
        "@swiftpkg_shake_kit//:ShakeKit",
    ],
)

# `bazel run //apple/storybook_macos_application` launches the app.
macos_application(
    name = "storybook_macos_application",
    app_icons = ["//storybook/artwork/storybook_icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Storybook",
    infoplists = [
        "Info.plist",
        ":stamped_plist",
        ":variant_plist",
    ],
    entitlements = shared_signin_entitlements(
        name = "shared_signin_entitlements",
        bundle_id = BUNDLE_ID,
    ),
    minimum_os_version = "14.0",
    # Font.custom's fonts (the text.custom story): ATSApplicationFontsPath
    # names the bundle's Resources.
    resources = ["//storybook:fonts"],
    visibility = ["//visibility:public"],
    deps = [":storybook_macos_application_lib"],
)

# `bazel run //apple/storybook_macos_application:storybook_macos_application_project`
# generates StorybookMacos.xcodeproj in this directory (gitignored).
xcodeproj(
    name = "storybook_macos_application_project",
    project_name = "StorybookMacos",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(":storybook_macos_application"),
    ],
)
