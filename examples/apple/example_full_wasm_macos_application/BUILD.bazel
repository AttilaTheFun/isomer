load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The "full x wasm" cell of the Apple matrix: the WHOLE shared example app
# (//wasm/example_full_feature) delivered as a wasm bundle and
# rendered full-screen with real SwiftUI via `WasmView`. The runtime-updatable
# twin of example_full_compiled_macos_application (same app, compiled Swift).

swift_library(
    name = "host_lib",
    srcs = ["HostApp.swift"],
    module_name = "FullWasmHost",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//apple/platform_services_host",
        "@isomer//apple/libraries/wasm_view",
    ],
)

macos_application(
    name = "example_full_wasm_macos_application",
    bundle_id = "com.LoganShire.Isomer.FullWasm",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    resources = ["//wasm/example_full_feature:example_full"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":host_lib"],
)
