load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

# The driver probe (//headless/driver_probe: views shaped as an app's are) on
# Apple's SwiftUI for the Mac: the app its tests drive through Apple's driver
# (drive/apple, the Mac's accessibility client) when it is built with
# --@isomer//drive:headful, as the iPhone's probe
# (//apple/driver_probe_ios_application) is driven on a simulator
# (//headless/driver_probe:driver_probe_headful_apple_runner, with
# ISOMER_MAC_APP and drive/launchers/macos_launcher.sh).
#
#   bazel build --@isomer//drive:headful //apple/driver_probe_macos_application
swift_library(
    name = "driver_probe_macos_lib",
    srcs = [
        "//headless/driver_probe:DriverProbe.swift",
        "//headless/driver_probe:PlacementsMac.swift",
    ],
    module_name = "DriverProbeMac",
    tags = ["manual"],
    deps = [
        "@isomer//apple/libraries/swift_ui",
        "@isomer//apple/libraries/swift_ui:isomer",
    ],
)

macos_application(
    name = "driver_probe_macos_application",
    bundle_id = "com.LoganShire.IsomerExamples.DriverProbe",
    bundle_name = "DriverProbe",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":driver_probe_macos_lib"],
)
