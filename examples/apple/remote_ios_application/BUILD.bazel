load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

# An app whose SwiftUI runs elsewhere, drawn on an iPhone by Isomer's tree
# renderer over the app's session (RemoteApp.swift; docs/modes.md). The
# simulator's: no provisioning profile. Build with --ios_multi_cpus=sim_arm64.
swift_library(
    name = "remote_ios_application_lib",
    srcs = ["RemoteApp.swift"],
    module_name = "RemoteApp",
    tags = ["manual"],
    deps = ["@isomer//apple/libraries/remote_head"],
)

ios_application(
    name = "remote_ios_application",
    bundle_id = "com.LoganShire.IsomerExamples.Remote",
    bundle_name = "Remote",
    families = [
        "ipad",
        "iphone",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "18.0",
    tags = ["manual"],
    deps = [":remote_ios_application_lib"],
)
