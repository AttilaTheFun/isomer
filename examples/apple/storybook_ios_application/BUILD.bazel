load("@build_bazel_rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcode_provisioning_profile", "xcodeproj")
load("@isomer_signing//:signing.bzl", "TEAM_ID")
load("//tools/variant:defs.bzl", "variant_infoplist")

# The Storybook on iOS: the Storybook's own app, which releases hand out.
# One bundle id for every build, Alpha, Beta, Production and AdHoc, and for
# the Mac's (the private AttilaTheFun/applications' docs/VARIANTS.md).
BUNDLE_ID = "com.LoganShire.IsomerStorybook"

# What this build of the Storybook is, BuildVariant (Alpha, Beta, Production
# or AdHoc, by --config=alpha|beta|prod|adhoc), and its name under its icon,
# "Storybook" for all of them (Info.plist leaves those keys out).
variant_infoplist(
    name = "variant_plist",
    display_name = "Storybook",
    # Its link scheme: how Applications opens it, and links into it.
    url_scheme = "storybook",
)

# The Storybook (//shared/example_application), compiled against Apple's
# SwiftUI for iOS.
swift_library(
    name = "storybook_ios_application_lib",
    srcs = ["//shared/example_application:srcs"],
    data = ["//shared/example_application:xcassets"],
    deps = [
        "//storybook",
        "//shared/platform_services",
        "@isomer//apple/libraries/swift_ui",
        "@isomer//apple/libraries/swift_ui:isomer",
        # The build it is, written for Applications at launch (ExampleApp.swift).
        "@swiftpkg_update_kit//:UpdateKit",
    ],
)

# The version is the Info.plist's (CFBundleShortVersionString MAJOR.MINOR.0,
# stamped per build by tools/stamp_storybook.py; CFBundleVersion 1).

# The Xcode-managed development profile for the bundle id, found in the local
# Xcode provisioning profile store.
local_provisioning_profile(
    name = "_xcode_managed_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = TEAM_ID,
)

xcode_provisioning_profile(
    name = "_development_profile",
    managed_by_xcode = True,
    provisioning_profile = ":_xcode_managed_profile",
    tags = ["manual"],
)

# `bazel run //apple/storybook_ios_application` installs and
# launches the app in the iOS simulator; add `--ios_multi_cpus=arm64` to
# install and launch on an attached device instead.
ios_application(
    name = "storybook_ios_application",
    app_icons = ["//storybook/artwork/storybook_icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Storybook",
    # Its own app ID and keychain group: a wildcard profile's entitlements
    # would otherwise be copied as-is (application-identifier TEAM.*), which
    # the release server refuses. And Applications' app group, which CI's
    # build carries (the bundle id's own profile grants it when Applications
    # Server signs it again); a local device build under the wildcard
    # profile, which can grant no app group, goes without.
    entitlements = select({
        "//tools/ci_device": "Storybook.entitlements",
        "@apple_support//constraints:device": "Storybook.wildcard.entitlements",
        "//conditions:default": "Storybook.entitlements",
    }),
    families = [
        "ipad",
        "iphone",
    ],
    infoplists = [
        "Info.plist",
        ":variant_plist",
    ],
    minimum_os_version = "17.0",
    # CI's device build (--config=ci_device) signs ad hoc with a placeholder
    # profile, which Applications Server replaces with the bundle id's own.
    provisioning_profile = select({
        "//tools/ci_device": "//tools/ci_device:ci_placeholder_profile",
        "//conditions:default": ":_development_profile",
    }),
    # Font.custom's fonts (the text.custom story), named in UIAppFonts.
    resources = ["//storybook:fonts"],
    visibility = ["//visibility:public"],
    deps = [":storybook_ios_application_lib"],
)

# Simulator-only variant: no provisioning profile, so it builds on machines
# without the Xcode-managed profile above. Build with
# --ios_multi_cpus=sim_arm64, then `xcrun simctl install` the Payload .app.
ios_application(
    name = "storybook_ios_sim_application",
    app_icons = ["//storybook/artwork/storybook_icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Storybook",
    # The bundle id's keychain group and Applications' app group, no team.
    entitlements = "Storybook.simulator.entitlements",
    families = [
        "ipad",
        "iphone",
    ],
    infoplists = [
        "Info.plist",
        ":variant_plist",
    ],
    minimum_os_version = "17.0",
    resources = ["//storybook:fonts"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":storybook_ios_application_lib"],
)

# `bazel run //apple/storybook_ios_application:storybook_ios_application_project`
# generates StorybookIos.xcodeproj in this directory (gitignored).
xcodeproj(
    name = "storybook_ios_application_project",
    project_name = "StorybookIos",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            ":storybook_ios_application",
            target_environments = [
                "device",
                "simulator",
            ],
        ),
    ],
)

# The hosted tests' host (examples/headless:storybook_hosted_ios_test): the
# simulator variant again, its bundle named as the target is, because rules_apple's
# test runner looks for Payload/<the host target's name>.app.
ios_application(
    name = "storybook_test_host",
    app_icons = ["//storybook/artwork/storybook_icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "storybook_test_host",
    entitlements = "Storybook.simulator.entitlements",
    families = [
        "ipad",
        "iphone",
    ],
    infoplists = [
        "Info.plist",
        ":variant_plist",
    ],
    minimum_os_version = "17.0",
    resources = ["//storybook:fonts"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":storybook_ios_application_lib"],
)
