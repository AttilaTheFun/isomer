load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//apple/compiled:defs.bzl", "isomer_compiled_feature")

# The tap counter compiled against Isomer's frameworks inside an iOS app
# (apple/compiled): the feature (the shared source, `import SwiftUI` being
# Isomer's) and the host that draws it (WasmView over the native engine).
# The feature builds for iOS 16: its SwiftUI, Observation and Synchronization
# are Isomer's (iOS 15 waits for Isomer's CoreTransferable, which PhotosUI
# stands on). The app is iOS 18 since 0.38: its host, WasmView, links WasmKit,
# which stands on Swift's Synchronization.
# Simulator builds need no provisioning:
#   bazel build //apple/tap_counter_compiled_isomer_ios_application --ios_multi_cpus=sim_arm64
swift_library(
    name = "feature_lib",
    srcs = ["//shared/tap_counter_application:srcs"],
    module_name = "TapCounter",
    tags = ["manual"],
    deps = [
        "@isomer//:swift_ui",
        "@isomer//apple/libraries/compiled_swift_ui:hot_bridge",
    ],
)

isomer_compiled_feature(
    name = "feature",
    tags = ["manual"],
    deps = [":feature_lib"],
)

swift_library(
    name = "app_lib",
    srcs = ["iOSApp.swift"],
    module_name = "TapCounterCompiledIsomerApp",
    tags = ["manual"],
    deps = [
        "@isomer//apple/libraries/native_runtime",
        "@isomer//apple/libraries/wasm_view",
    ],
)

ios_application(
    name = "tap_counter_compiled_isomer_ios_application",
    bundle_id = "com.LoganShire.IsomerCompiledTapCounter",
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = "18.0",
    tags = ["manual"],
    deps = [
        ":app_lib",
        ":feature",
    ],
)
