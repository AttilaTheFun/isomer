load("@build_bazel_rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcode_provisioning_profile")
load("@isomer_signing//:signing.bzl", "TEAM_ID")

# The WASM iOS cell of the counter benchmark (docs/benchmarks.md#ios): the
# SAME shared TapCounter.swift as a wasm reactor, rendered as real SwiftUI by
# `WasmView` (WasmKit interprets it). One shared bundle id across the iOS
# cells — install one at a time.
# Bench mode: launch with `-bench`.

BUNDLE_ID = "com.LoganShire.IsomerExamples"


swift_library(
    name = "app_lib",
    srcs = [
        "iOSApp.swift",
        "@isomer//apple/libraries/bench:harness",
        "@isomer//apple/libraries/bench:signpost_harness",
    ],
    module_name = "TapCounterWasmIOS",
    tags = ["manual"],
    deps = [
        "@isomer//apple/libraries/bench:boot",
        "@isomer//apple/libraries/wasm_view",
    ],
)

local_provisioning_profile(
    name = "_xcode_managed_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = TEAM_ID,
)

xcode_provisioning_profile(
    name = "_development_profile",
    managed_by_xcode = True,
    provisioning_profile = ":_xcode_managed_profile",
    tags = ["manual"],
)

ios_application(
    name = "tap_counter_wasm_ios_application",
    bundle_id = BUNDLE_ID,
    families = ["iphone"],
    infoplists = ["Info.plist"],
    # iOS 18: WasmView runs reactors on WasmKit (Swift's Synchronization).
    minimum_os_version = "18.0",
    provisioning_profile = ":_development_profile",
    resources = ["//wasm/tap_counter_feature:tap_counter_release.wasm"],
    visibility = ["//visibility:public"],
    deps = [":app_lib"],
)
