load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Foundation's networking in a WasmView: the network probe
# (//shared/network_probe_application) as a reactor, whose URLSession runs
# over Apple's (the network hosts WasmView injects; the app injects nothing
# of its own). Simulator build (no provisioning profile). The probe's server
# is ISO_NETWORK_SERVER (WasmKitRuntime hands the reactor the host's ISO_*
# variables); each check is a line of the list, which ISO_DUMP_TREE writes
# out (the guest's stdout reaches a launch's --stdout file only in part):
#
#   node ../tools/testing/network_server.js &          # prints its URL
#   bazel build //apple/network_probe_wasm_ios_application --ios_multi_cpus=sim_arm64
#   xcrun simctl install <your simulator> <the .ipa's Payload/…app>
#   SIMCTL_CHILD_ISO_NETWORK_SERVER=http://127.0.0.1:<port> \
#   SIMCTL_CHILD_ISO_DUMP_TREE=/tmp/network_probe_tree.txt \
#     xcrun simctl launch <your simulator> com.LoganShire.Isomer.NetworkProbe
#   grep -oE "(ok |FAIL |done: )[^\"']*" /tmp/network_probe_tree.txt
swift_library(
    name = "app_lib",
    srcs = ["NetworkProbeApp.swift"],
    module_name = "NetworkProbeWasmIOS",
    tags = ["manual"],
    deps = ["@isomer//apple/libraries/wasm_view"],
)

ios_application(
    name = "network_probe_wasm_ios_application",
    bundle_id = "com.LoganShire.Isomer.NetworkProbe",
    families = ["iphone"],
    infoplists = ["Info.plist"],
    # iOS 18: WasmView runs reactors on WasmKit (Swift's Synchronization).
    minimum_os_version = "18.0",
    resources = ["//wasm/network_probe_feature:network_probe.wasm"],
    deps = [":app_lib"],
)
