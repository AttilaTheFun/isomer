load("@build_bazel_rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@build_bazel_rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcode_provisioning_profile", "xcodeproj")
load("@isomer_signing//:signing.bzl", "TEAM_ID")

BUNDLE_ID = "com.LoganShire.IsomerExamples"


# The shared SwiftUI application, compiled against the real SwiftUI for iOS.
swift_library(
    name = "example_full_compiled_ios_application_lib",
    srcs = ["//shared/example_application:srcs"],
    data = ["//shared/example_application:xcassets"],
    deps = [
        "//shared/platform_services",
        "@isomer//apple/libraries/swift_ui",
        "@isomer//apple/libraries/swift_ui:isomer",
    ],
)

apple_bundle_version(
    name = "_version",
    build_version = "1",
    short_version_string = "1.0",
    tags = ["manual"],
)

# The Xcode-managed development profile for the bundle id, found in the local
# Xcode provisioning profile store.
local_provisioning_profile(
    name = "_xcode_managed_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = TEAM_ID,
)

xcode_provisioning_profile(
    name = "_development_profile",
    managed_by_xcode = True,
    provisioning_profile = ":_xcode_managed_profile",
    tags = ["manual"],
)

# `bazel run //apple/example_full_compiled_ios_application` installs and
# launches the app in the iOS simulator; add `--ios_multi_cpus=arm64` to
# install and launch on an attached device instead.
ios_application(
    name = "example_full_compiled_ios_application",
    bundle_id = BUNDLE_ID,
    families = [
        "ipad",
        "iphone",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "17.0",
    provisioning_profile = ":_development_profile",
    version = ":_version",
    visibility = ["//visibility:public"],
    deps = [":example_full_compiled_ios_application_lib"],
)

# Simulator-only variant: no provisioning profile, so it builds on machines
# without the Xcode-managed profile above. Build with
# --ios_multi_cpus=sim_arm64, then `xcrun simctl install` the Payload .app.
ios_application(
    name = "example_full_compiled_ios_sim_application",
    bundle_id = BUNDLE_ID,
    families = [
        "ipad",
        "iphone",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "17.0",
    tags = ["manual"],
    version = ":_version",
    visibility = ["//visibility:public"],
    deps = [":example_full_compiled_ios_application_lib"],
)

# `bazel run //apple/example_full_compiled_ios_application:example_full_compiled_ios_application_project`
# generates ExampleIosApplication.xcodeproj in this directory (gitignored).
xcodeproj(
    name = "example_full_compiled_ios_application_project",
    project_name = "ExampleIosApplication",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            ":example_full_compiled_ios_application",
            target_environments = [
                "device",
                "simulator",
            ],
        ),
    ],
)
