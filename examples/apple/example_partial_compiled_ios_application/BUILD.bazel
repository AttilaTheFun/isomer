load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The `IsomerView` demo on iOS: a native SwiftUI host embedding the shared
# OrderStatusCard feature (//shared/embedded_example) through the
# engine-agnostic `IsomerView` — compiled engine by default, overridden to
# the bundled wasm reactor with ISO_ENGINE=wasm (the hot-reload / dynamic
# hotfix path). Simulator build (no provisioning profile).

# The shared feature compiled NATIVELY against the IsomerCore
# reimplementation (`import SwiftUI` in the source resolves to the core via
# -module-alias) so `IsomerView`'s compiled engine can run it in-process,
# emitting the same tree.fbs Patch stream as the wasm twin.
swift_library(
    name = "feature_lib",
    srcs = ["//shared/embedded_example:card"],
    copts = [
        "-module-alias",
        "SwiftUI=IsomerCore",
    ],
    module_name = "EmbeddedExample",
    deps = ["@isomer//apple/libraries/isomer_core"],
)

swift_library(
    name = "ios_lib",
    srcs = ["iOSApp.swift"],
    module_name = "PartialCompiledIOSHost",
    deps = [
        ":feature_lib",
        # The engine-override demo (ISO_JSC=1 -> JavaScriptCore runs the wasm).
        "@isomer//shared/wasm_host:jsc_runtime",
        "@isomer//apple/libraries/isomer_view",
    ],
)

ios_application(
    name = "example_partial_compiled_ios_application",
    bundle_id = "com.LoganShire.Isomer.PartialCompiled",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "17.0",
    resources = ["//wasm/embedded_example_feature:embedded_example.wasm"],
    deps = [":ios_lib"],
)
