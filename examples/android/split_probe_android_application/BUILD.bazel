load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//tools/android:defs.bzl", "isomer_android_app")

# The consumers' shapes (web/split_probe_web_application) on the Compose
# renderer: the same screens, compiled for Android, for the emulator.

swift_library(
    name = "app_swift",
    srcs = ["//web/split_probe_web_application:srcs"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "SplitProbe",
    tags = ["manual"],
    deps = [
        "@isomer//:swift_ui",
        "@isomer//android/libraries/swift_ui",
        "@isomer//android/libraries/swift_ui:isomer",
    ],
)

isomer_android_app(
    name = "split_probe_android_application",
    default_renderer = "jetpackCompose",
    label = "Split Probe",
    package = "dev.isomer.splitprobe",
    swift_library = ":app_swift",
    visibility = ["//visibility:public"],
)
