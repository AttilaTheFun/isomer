load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//tools/android:defs.bzl", "isomer_android_app")

# Bundle's resources on Android: strings tables in .lproj folders and a
# plain file, packaged by isomer_android_app's `resources` and read through
# Bundle.main (BundleProbe.swift).
swift_library(
    name = "app_swift",
    srcs = ["BundleProbe.swift"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "BundleProbe",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@isomer//:swift_ui",
        "@isomer//android/libraries/swift_ui",
    ],
)

isomer_android_app(
    name = "bundle_probe_android_application",
    label = "Bundle Probe",
    package = "dev.isomer.bundleprobe",
    resources = [
        "en.lproj/Localizable.strings",
        "fr.lproj/Localizable.strings",
        "probe.txt",
    ],
    swift_library = ":app_swift",
)
