load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@isomer//tools/android:defs.bzl", "apk_install_run", "flat_assets")

# The wasm+GPU cell of the counter benchmark (docs/benchmarks.md): the SAME
# shared TapCounter.swift as every other cell, shipped as a GPU wasm reactor —
# SwiftGPURenderer runs INSIDE the module and draws through native OpenGL ES
# (its env.gl* imports, bound by the WAMR host). The APK carries NO compiled
# Swift and NO Jetpack Compose: just the GLSurfaceView host, the reactor asset,
# and libiso_wamr_jni.so (WAMR + the GLES natives).

# assets/: the GPU reactor (RELEASE build). Config-selected:
# `tap_counter_gpu_release.wasm` (interp) by default, `.aot` under
# `--config=release`.
flat_assets(
    name = "app_assets",
    srcs = ["//wasm/tap_counter_feature:tap_counter_gpu_release"],
)

kt_android_library(
    name = "host_app",
    srcs = glob(["kotlin/**/*.kt"]) + [
        "@isomer//android/libraries/swift_ui:host_services_kotlin",
        "@isomer//android/libraries/wasm_view:gpu_runtime_kotlin",
    ],
    custom_package = "dev.isomer.tapcounter.wasmgpu",
    manifest = "AndroidManifest.xml",
    tags = ["manual"],
)

android_binary(
    name = "tap_counter_wasm_gpu_android_application_apk",
    assets = [":app_assets"],
    assets_dir = "app_assets",
    manifest = "AndroidManifest.xml",
    deps = [
        ":host_app",
        # The ONLY native library: WAMR + the env.gl* natives (no compiled Swift).
        "@isomer//android/libraries/wasm_view:wamr_jni",
    ],
)

apk_install_run(
    name = "tap_counter_wasm_gpu_android_application",
    activity = "dev.isomer.tapcounter.wasmgpu/.MainActivity",
    apk = ":tap_counter_wasm_gpu_android_application_apk.apk",
)
