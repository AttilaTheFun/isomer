# The Android WASM cells' platform services (shared/platform_services) as
# blob dispatchers over the generic engine runtime — one source file every wasm
# Android example compiles into its own Kotlin library (the runtime's Kotlin
# targets are source sets, not JVM libraries).

package(default_visibility = ["//visibility:public"])

exports_files(["kotlin/dev/isomer/platform/PlatformServicesWasm.kt"])

filegroup(
    name = "srcs",
    srcs = ["kotlin/dev/isomer/platform/PlatformServicesWasm.kt"],
)
