load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@isomer//tools/android:defs.bzl", "apk_install_run", "flat_assets")

# Level 4 adoption, the "full x wasm" cell of the Android [full|partial] x
# [compiled|wasm] matrix: the WHOLE shared SwiftUI @main App shipped as a wasm
# bundle and hosted full-screen by `WasmView`. Its compiled twin (SAME app,
# Swift built into the APK) is
# //android/storybook_android_application.
#
# Like example_partial_wasm, none of the app's Swift is compiled into the APK:
# the only native library is the engine's (libwasm_engine_bindings.so:
# WasmKit, a Swift interpreter with its runtime). The app's entire UI is the
# reactor //wasm/example_full_feature, run in-process on WasmKit and drawn by
# the Swift-free Compose interpreter.

# assets/: the whole-app reactor (RELEASE build — gc'd, ABI-only exports,
# stripped) PLUS the shared image PNGs flattened to the basenames the tree's
# image nodes open (HostServices.loadBitmap → assets.open("iso-logo.png")).
flat_assets(
    name = "app_assets",
    srcs = [
        "//shared/example_application:assets",
        # The release reactor, `example_full_release.wasm`.
        "//wasm/example_full_feature:example_full_release",
    ],
)

# The host as ONE Kotlin/Compose library: the full-screen host (MainActivity),
# the Swift-free Compose interpreter (interpreter_kotlin), and the wasm engine
# glue (WasmView / WasmKitRuntime from //android/libraries/wasm_view, over the
# engine's generated bindings). No swift_library of the app's own.
kt_android_library(
    name = "host_app",
    srcs = glob(["kotlin/**/*.kt"]) + [
        "//android/platform_services_wasm:srcs",
        "@isomer//android/libraries/swift_ui:interpreter_kotlin",
        "@isomer//android/libraries/wasm_view:runtime_kotlin",
    ],
    custom_package = "dev.isomer.wasmfull",
    manifest = "AndroidManifest.xml",
    plugins = ["@isomer//android/libraries/swift_ui:compose_compiler_plugin"],
    tags = ["manual"],
    deps = [
        "@isomer//android/libraries/wasm_view:wasm_engine_bindings",
        "@isomer//tools/android:maven_androidx_activity_activity_compose",
        "@isomer//tools/android:maven_androidx_compose_foundation_foundation",
        "@isomer//tools/android:maven_androidx_compose_material3_material3",
        "@isomer//tools/android:maven_androidx_compose_runtime_runtime",
        "@isomer//tools/android:maven_androidx_compose_ui_ui",
        "@isomer//tools/android:maven_org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@isomer//tools/android:maven_org_jetbrains_kotlinx_kotlinx_coroutines_core",
    ],
)

android_binary(
    name = "example_full_wasm_android_application_apk",
    assets = [":app_assets"],
    assets_dir = "app_assets",
    manifest = "AndroidManifest.xml",
    deps = [
        ":host_app",
        # The ONLY native library: the engine (WasmKit, libwasm_engine_bindings.so).
        "@isomer//android/libraries/wasm_view:engine_native",
    ],
)

# `bazel run` installs + launches on the connected device / hermetic emulator.
apk_install_run(
    name = "example_full_wasm_android_application",
    activity = "dev.isomer.wasmfull/.MainActivity",
    apk = ":example_full_wasm_android_application_apk.apk",
)
