load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//tools/android:defs.bzl", "isomer_android_app")

# The selection probe (shared/selection_probe_application) on Android: the
# Compose text field reporting its selection and showing the app's. Run it
# on the emulator (`bazel run` installs and launches it) and drive it with
# adb input (tap the field, type, DPAD_LEFT, tap Complete), reading the
# probe's text with uiautomator.
swift_library(
    name = "app_swift",
    srcs = ["//shared/selection_probe_application:srcs"],
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "SelectionProbe",
    tags = ["manual"],
    deps = [
        "@isomer//:foundation",
        "@isomer//:swift_ui",
        "@isomer//android/libraries/swift_ui",
        "@isomer//android/libraries/swift_ui:isomer",
    ],
)

isomer_android_app(
    name = "selection_probe_android_application",
    default_renderer = "jetpackCompose",
    label = "Selection Probe",
    package = "dev.isomer.selectionprobe",
    swift_library = ":app_swift",
)
