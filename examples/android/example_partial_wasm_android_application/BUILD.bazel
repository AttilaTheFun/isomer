load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@isomer//tools/android:defs.bzl", "apk_install_run", "flat_assets")

# Level 3 adoption, the "wasm" cell of the Android [full|partial] x
# [compiled|wasm] matrix: a plain Kotlin/Compose app that embeds one wasm
# feature BUNDLE with the `WasmView` @Composable. The reactor runs in-process
# under the WAMR interpreter (a C engine) and its render tree is drawn by the
# same Swift-free Compose interpreter the compiled path uses.
#
# The whole point of this cell: it carries NO compiled Swift. The only native
# library is libiso_wamr_jni.so (WAMR + the C host + JNI shim, ~344 KB) — no
# SwiftUIBridge .so, no Swift stdlib. Choosing wasm trades some runtime
# performance for runtime-updatable code and smaller app size (the compiled twin
# is //android/example_partial_compiled_android_application).

# The wasm reactor to embed, packaged into the APK's assets/. The RELEASE build
# (--gc-sections, ABI-only exports, -c opt, --strip-all) — smaller and faster to
# instantiate than the fastbuild wasm, which matters for a shipped bundle.
flat_assets(
    name = "wasm_assets",
    srcs = ["//wasm/hot_demo_feature:hot_demo_release"],
)

# The whole app as ONE Kotlin/Compose library: the host screen (MainActivity),
# the Swift-free Compose interpreter (//android/libraries/swift_ui:
# interpreter_kotlin), and the wasm engine glue (WasmView / WamrRuntime /
# WasmBundleProvider from //android/libraries/wasm_view). No swift_library, no
# generated JNI bindings — nothing pulls compiled Swift.
kt_android_library(
    name = "host_app",
    srcs = glob(["kotlin/**/*.kt"]) + [
        "//android/platform_services_wasm:srcs",
        "@isomer//android/libraries/swift_ui:interpreter_kotlin",
        "@isomer//android/libraries/wasm_view:runtime_kotlin",
    ],
    custom_package = "dev.isomer.wasmexample",
    manifest = "AndroidManifest.xml",
    plugins = ["@isomer//android/libraries/swift_ui:compose_compiler_plugin"],
    tags = ["manual"],
    deps = [
        "@isomer//tools/android:maven_androidx_activity_activity_compose",
        "@isomer//tools/android:maven_androidx_compose_foundation_foundation",
        "@isomer//tools/android:maven_androidx_compose_material3_material3",
        "@isomer//tools/android:maven_androidx_compose_runtime_runtime",
        "@isomer//tools/android:maven_androidx_compose_ui_ui",
        "@isomer//tools/android:maven_org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@isomer//tools/android:maven_org_jetbrains_kotlinx_kotlinx_coroutines_core",
    ],
)

android_binary(
    name = "example_partial_wasm_android_application_apk",
    assets = [":wasm_assets"],
    assets_dir = "wasm_assets",
    manifest = "AndroidManifest.xml",
    deps = [
        ":host_app",
        # The ONLY native library: the WAMR C engine (no compiled Swift).
        "@isomer//android/libraries/wasm_view:wamr_jni",
    ],
)

# `bazel run` installs + launches on the connected device / hermetic emulator.
apk_install_run(
    name = "example_partial_wasm_android_application",
    activity = "dev.isomer.wasmexample/.MainActivity",
    apk = ":example_partial_wasm_android_application_apk.apk",
)
