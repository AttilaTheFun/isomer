# Foundation off Apple's platforms is the Swift SDK's (since 0.56): on Android
# and the web Isomer's Swift SDKs carry Isomer's Foundation, FoundationNetworking,
# IsomerFoundation, CoreGraphics and Combine in place of corelibs'
# (AttilaTheFun/isomer_hermetic_toolchains, whose Isomer/Sources were this
# directory's; docs/hermetic_toolchains.md), so every `import Foundation` there
# is Isomer's with no dependency declared. Linux and Windows keep the
# toolchain's corelibs Foundation. Apple platforms use Apple's.
#
# What is left here: the build settings below, the rule every isomer Swift
# package module is reached through (defs.bzl's one_configuration), and
# Foundation's tests, run against the SDK's Foundation (tests/).
#
#   --@isomer//foundation:internationalization   (default false)
#
# asked for Isomer's Foundation with FoundationInternationalization (dates,
# numbers and lists formatted as on Apple's platforms) and ICU when isomer
# built Foundation from source. With Foundation the SDK's, the SDK chosen
# says so: the -i18n SDK's Foundation has FoundationInternationalization,
# the plain one's hasn't (README, "Upgrading isomer"). The setting stays, and
# on Android and the web checks that the SDK registered is the -i18n one
# (internationalization/), so a build that asks for it can't quietly get
# the plain SDK.

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "internationalization",
    build_setting_default = False,
)

# Which build of isomer's Swift package's modules this is (defs.bzl's
# one_configuration sets it): "" for the one applications link.
string_flag(
    name = "configuration",
    build_setting_default = "",
)

config_setting(
    name = "with_internationalization",
    flag_values = {":internationalization": "true"},
)

# What @isomer//:foundation is where Foundation is Isomer's (Android, the
# web): the SDK's, so nothing to link, and with
# --@isomer//foundation:internationalization the check that the SDK is the
# -i18n one.
swift_library_group(
    name = "from_sdk",
    deps = select({
        ":with_internationalization": ["//foundation/internationalization"],
        "//conditions:default": [],
    }),
)

# The label isomer's Foundation had before 0.56, for BUILD files that named it.
alias(
    name = "foundation",
    actual = "//:foundation",
)
