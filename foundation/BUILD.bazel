# Isomer's `Foundation` (see Foundation.swift). Apple platforms use Apple's.
#
#   --@isomer//foundation:internationalization   (default false)
#
# adds FoundationInternationalization (formatting, locales, calendars and
# time zones beyond the Gregorian/UTC basics) and ICU with it.

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")
load(":defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "internationalization",
    build_setting_default = False,
)

config_setting(
    name = "with_internationalization",
    flag_values = {":internationalization": "true"},
)

swift_library(
    name = "foundation",
    # swift-foundation's package: the string API here (StringProtocol+NSString.swift)
    # searches with Essentials' own `package` helpers. Nothing here is
    # Isomer's `package` plumbing.
    package_name = "swift-foundation",
    # Apple platforms have the real one; this one would shadow it.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "@platforms//os:ios": ["@platforms//:incompatible"],
        "@platforms//os:tvos": ["@platforms//:incompatible"],
        "@platforms//os:watchos": ["@platforms//:incompatible"],
        "@platforms//os:visionos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    srcs = glob(["*.swift"]),
    copts = select({
        ":with_internationalization": ["-DISOMER_FOUNDATION_INTERNATIONALIZATION"],
        "//conditions:default": [],
    }),
    module_name = "Foundation",
    deps = [
        # Isomer's Combine, beneath Foundation: its ObservableObject and
        # Published named from here too (Combine.swift), as Apple's.
        "//frameworks/combine",
        "//core_graphics",
        # What hosts install beneath Foundation (URLSession's transports,
        # UserDefaults' store), read through `internal import`.
        "//foundation/isomer_foundation",
        "@swiftpkg_swift_foundation//:FoundationEssentials",
    ] + select({
        # Dispatch's NSEC_PER_SEC family, which these platforms lack.
        "@platforms//os:android": ["//foundation/dispatch_time"],
        "@platforms//os:wasi": ["//foundation/dispatch_time"],
        "//conditions:default": [],
    }) + select({
        # Thread.isMainThread in a threaded (wasip1-threads) build.
        "@platforms//os:wasi": ["//foundation/wasi_thread_identity"],
        "//conditions:default": [],
    }) + select({
        ":with_internationalization": ["@swiftpkg_swift_foundation//:FoundationInternationalization"],
        "//conditions:default": [],
    }),
)

# What dependents use (through @isomer//:foundation): built in one
# configuration whatever theirs (defs.bzl). FoundationNetworking with it
# (networking/: Isomer's Foundation under corelibs' other name), so code
# that imports both sees one URLSession.
swift_library_group(
    name = "foundation_and_networking",
    deps = [
        ":foundation",
        "//foundation/networking",
    ],
)

one_configuration(
    name = "for_dependents",
    actual = ":foundation_and_networking",
)

# FileWrapper, compiled into the SwiftUI of Linux and Windows too (their
# Foundation, the toolchain's, has none): what FileDocument hands over.
exports_files(["FileWrapper.swift"], visibility = [
    "//linux/libraries/swift_ui:__pkg__",
    "//linux/libraries/swift_ui_wasm:__pkg__",
    "//tests/snapshot:__pkg__",
    "//windows/libraries/swift_ui:__pkg__",
    "//windows/libraries/swift_ui_wasm:__pkg__",
])
