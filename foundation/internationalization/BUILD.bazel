# What `--@isomer//foundation:internationalization` adds on Android and the
# web, whose Foundation is the Swift SDK's (since 0.56): a module that
# compiles only against the -i18n SDK's Foundation (it has
# FoundationInternationalization, re-exported through
# IsomerFoundationInternationalization), and fails with what to register
# otherwise. Before 0.56 this was the module that added
# FoundationInternationalization to the Foundation isomer built from source.

load("@rules_swift//swift:swift.bzl", "swift_library", "swift_library_group")
load("//foundation:defs.bzl", "one_configuration")

alias(
    name = "internationalization",
    actual = select({
        "//foundation:with_internationalization": ":check",
        "//conditions:default": ":none",
    }),
    visibility = ["//visibility:public"],
)

# Built once, whatever its dependents' configurations (a package's minimum
# OS: defs.bzl).
one_configuration(
    name = "check",
    actual = ":check_module",
)

swift_library(
    name = "check_module",
    package_name = "isomer",
    srcs = ["SDKInternationalization.swift"],
    module_name = "IsomerSDKInternationalizationCheck",
)

swift_library_group(name = "none")
