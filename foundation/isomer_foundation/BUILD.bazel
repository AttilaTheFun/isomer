# IsomerFoundation: what a platform's host gives Isomer's Foundation, the
# API Apple's Foundation has no place for (docs/isomer_031_plan.md, phase
# 10). The transports `URLSession` sends its requests through
# (IsomerNetwork) and the store `UserDefaults` keeps its suites in
# (IsomerUserDefaults). Foundation reads them through an `internal import`,
# so nothing of this module reaches an app through `import Foundation`; a
# host imports it by name.

load("@rules_swift//swift:swift.bzl", "swift_library")
load("//foundation:defs.bzl", "one_configuration")

package(
    default_visibility = ["//visibility:public"],
    features = [
        # Swift 6, strict and warning-free: hosts on many threads (Android)
        # and on one (the web) install these from wherever they start.
        "swift.enable_v6",
        "treat_warnings_as_errors",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.ExistentialAny",
    ],
)

swift_library(
    name = "isomer_foundation",
    # Beneath Isomer's Foundation, which Apple platforms do not use.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "@platforms//os:ios": ["@platforms//:incompatible"],
        "@platforms//os:tvos": ["@platforms//:incompatible"],
        "@platforms//os:watchos": ["@platforms//:incompatible"],
        "@platforms//os:visionos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    srcs = glob(["*.swift"]),
    module_name = "IsomerFoundation",
    deps = ["@swift-foundation//:FoundationEssentials"],
)

# What a host outside //foundation depends on (through
# @isomer//:isomer_foundation): built in the one configuration Foundation's
# copy is (//foundation:defs.bzl), so the two are one library.
one_configuration(
    name = "for_dependents",
    actual = ":isomer_foundation",
)
