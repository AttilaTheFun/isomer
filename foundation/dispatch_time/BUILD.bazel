load("@rules_swift//swift:swift.bzl", "swift_library")

# Dispatch's NSEC_PER_SEC family for Android and WASI (DispatchTime.swift),
# re-exported by Isomer's Foundation there.
swift_library(
    name = "dispatch_time",
    package_name = "isomer",
    srcs = ["DispatchTime.swift"],
    module_name = "IsomerDispatchTime",
    visibility = ["//foundation:__pkg__"],
)
