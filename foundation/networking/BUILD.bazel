load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# `import FoundationNetworking` on the platforms whose Foundation is Isomer's
# (FoundationNetworking.swift): part of //foundation:for_dependents there.
swift_library(
    name = "networking",
    package_name = "isomer",
    srcs = ["FoundationNetworking.swift"],
    module_name = "FoundationNetworking",
    target_compatible_with = select({
        "@platforms//os:android": [],
        "@platforms//os:wasi": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//foundation"],
)
