load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")

package(default_visibility = ["//visibility:public"])

# `import FoundationNetworking` on the platforms whose Foundation is Isomer's
# (FoundationNetworking.swift): part of //foundation:for_dependents there.
swift_library_group(
    name = "networking",
    target_compatible_with = select({
        "@platforms//os:android": [],
        "@platforms//os:wasi": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@swiftpkg_isomer//:FoundationNetworking"],
)
