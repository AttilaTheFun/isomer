# IsomerMetal: what Isomer's `Metal` module stands on. The shader
# translator (Metal Shading Language to WGSL, written in Swift), and the
# backend interface a `Metal` device records its work for (WebGPU in a
# browser today). Pure Swift with no Foundation, so it builds and tests on
# the Mac as on wasm.

load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "isomer_metal",
    package_name = "isomer",
    srcs = glob([
        "backend/*.swift",
        "translator/*.swift",
    ]),
    module_name = "IsomerMetal",
)
