# The shared Kotlin half of the bridge runtime (package `swiftffi`): its
# sources. The library over them, and kt_swift_library, are the
# isomer_android module's (@isomer_android//swift_ffi:kotlin): isomer itself
# asks for no Kotlin rules (docs/platform_modules.md).
filegroup(
    name = "srcs",
    srcs = [
        "BridgeBlob.kt",
        "NativeLibraries.kt",
        "SwiftClosure.kt",
        "SwiftError.kt",
        "SwiftLazy.kt",
    ],
    visibility = ["//visibility:public"],
)
