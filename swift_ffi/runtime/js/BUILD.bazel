package(
    features = [
        # swift_ffi's own code is Swift 6, strict, and warning-free (this was
        # the repository-wide REPO.bazel setting when it was a repo of its own).
        "swift.enable_v6",
        "treat_warnings_as_errors",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.ExistentialAny",
        "swift.upcoming.StrictConcurrency",
    ],
)

# The shared JavaScript half of the bridge runtime (an ES module) and its
# TypeScript declarations. `js_swift_wasm_library` stages a copy of each next
# to each generated module (`<name>_runtime_js`, `<name>_runtime_dts`), which
# imports it as "./swift_ffi_runtime.js". It was TypeScript until 0.54
# (runtime/ts), compiled by tsc in every app's build.
exports_files(
    [
        "swift_ffi_runtime.d.ts",
        "swift_ffi_runtime.js",
    ],
    visibility = ["//visibility:public"],
)
