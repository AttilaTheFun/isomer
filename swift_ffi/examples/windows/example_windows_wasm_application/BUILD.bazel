load("@rules_cc//cc:defs.bzl", "cc_binary")

package(
    features = [
        # swift_ffi's own code is Swift 6, strict, and warning-free (this was
        # the repository-wide REPO.bazel setting when it was a repo of its own).
        "swift.enable_v6",
        "treat_warnings_as_errors",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.ExistentialAny",
        "swift.upcoming.StrictConcurrency",
    ],
)

# The Windows "wasm mode" cell of the example matrix: the shared greeter, run as
# a WebAssembly reactor under WAMR by a plain C host with NO compiled Swift. The
# driver lives in //swift_ffi/examples/shared/greeter_wasm_host (shared with the Linux
# cell). Unlike Linux, the reactor is a committed prebuilt (greeter_reactor.wasm)
# — the SwiftWasm cross-compile toolchain isn't registered on Windows. See
# swift_ffi's README matrix and the compiled peer
# (../example_windows_compiled_application).
cc_binary(
    name = "example_windows_wasm_application",
    srcs = ["main.c"],
    # Bazel passes the reactor's runfiles path as argv[1] so `bazel run` needs no
    # arguments.
    args = ["$(rootpath greeter_reactor.wasm)"],
    data = ["greeter_reactor.wasm"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["//swift_ffi/examples/shared/greeter_wasm_host"],
)
