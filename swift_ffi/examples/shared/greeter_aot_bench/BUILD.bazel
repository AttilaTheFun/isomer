load("@rules_cc//cc:defs.bzl", "cc_binary")

# AOT-vs-interp cold-start benchmark (macOS or Linux host). Compares loading the greeter
# reactor as a .wasm (fast interpreter) vs a wamrc-produced native .aot, over the
# same swift_ffi_wamr C host. Requires --define wamr_aot=1 so the host links the
# AOT loader; the .aot genrule also needs it (so wamrc is built).
package(
    default_visibility = ["//visibility:private"],
    features = [
        # swift_ffi's own code is Swift 6, strict, and warning-free (this was
        # the repository-wide REPO.bazel setting when it was a repo of its own).
        "swift.enable_v6",
        "treat_warnings_as_errors",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.ExistentialAny",
        "swift.upcoming.StrictConcurrency",
    ],
)

# Lower the greeter reactor to a native .aot with the pluggable AOT compiler
# (//swift_ffi:wasm_aot_compiler — wamrc by default; swap with
# --//swift_ffi:wasm_aot_compiler=...). wamrc defaults to the host triple
# (arm64-apple-darwin / x86_64-linux), so the .aot matches the build host
# (and any same-cpu host, e.g. an arm64 Android device for a macOS-built .aot).
genrule(
    name = "greeter_reactor_aot",
    srcs = ["//swift_ffi/examples/shared/greeter:greeter_reactor.wasm"],
    outs = ["greeter_reactor.aot"],
    cmd = "$(location //swift_ffi:wasm_aot_compiler) -o $@ $(location //swift_ffi/examples/shared/greeter:greeter_reactor.wasm)",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = ["//swift_ffi:wasm_aot_compiler"],
)

cc_binary(
    name = "greeter_aot_bench",
    srcs = ["bench.c"],
    data = [
        ":greeter_reactor.aot",
        "//swift_ffi/examples/shared/greeter:greeter_reactor.wasm",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//swift_ffi/examples/shared/greeter_wasm_host"],
)
