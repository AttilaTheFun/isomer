load("@rules_swift//swift:swift_library.bzl", "swift_library")

package(
    features = [
        # swift_ffi's own code is Swift 6, strict, and warning-free (this was
        # the repository-wide REPO.bazel setting when it was a repo of its own).
        "swift.enable_v6",
        "treat_warnings_as_errors",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.ExistentialAny",
        "swift.upcoming.StrictConcurrency",
    ],
)

# The macro implementations, as protocols with default expansions: the
# compiler-plugin target declares one conforming struct per
# macro and stays a thin shell, so the logic here is unit-testable without
# loading a plugin executable.
swift_library(
    name = "swift_ffi_plugin_library",
    srcs = [
        "ABIEmitter.swift",
        "ABIEmitter+Interface.swift",
        "ABIModel.swift",
        "BridgeTypes.swift",
        "BridgeValueType.swift",
        "ExportedEnumMacroProtocol.swift",
        "ExportedFunctionMacroProtocol.swift",
        "ExportedInterfaceMacroProtocol.swift",
        "ExportedStructMacroProtocol.swift",
        "MacroError.swift",
    ],
    module_name = "SwiftFFIPluginLibrary",
    visibility = ["//visibility:public"],
    deps = [
        "@swift-syntax//:SwiftSyntax",
        "@swift-syntax//:SwiftSyntaxMacros",
    ],
)
