load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load(":libcxx.bzl", "ndk_libcxx_shared")
load(":utils.bzl", "transition_binary")

# The swift_ffi rule definitions — one file per public macro:
#   bridge_cc_library.bzl / cc_swift_library.bzl / kt_swift_library.bzl /
#   js_swift_wasm_library.bzl / swift_wasm_reactor.bzl / swift_wasm_library.bzl /
#   c_host_library.bzl / rs_swift_library.bzl
# (utils.bzl is internal; ts_swift_wasm_library.bzl is js_swift_wasm_library's
# name before 0.54). Target platforms for the cross-compiled bridges
# live here too; the Swift-SDK toolchains registered in MODULE.bazel match
# these constraints.
package(
    default_visibility = ["//visibility:public"],
    features = [
        # swift_ffi's own code is Swift 6, strict, and warning-free (this was
        # the repository-wide REPO.bazel setting when it was a repo of its own).
        "swift.enable_v6",
        "treat_warnings_as_errors",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.ExistentialAny",
        "swift.upcoming.StrictConcurrency",
    ],
)

exports_files(glob(["*.bzl"]) + ["jni_exports.lds", "reactor_stub.swift"])

# A JNI library linked to ship (kt_swift_library.bzl): only its JNI entry
# points exported (jni_exports.lds), everything else local, unreached code
# dropped and the symbol tables stripped. With -c opt, `-Osize` and the
# `swift.no_embed_debug_module` feature it is .bazelrc's
# `--config=android_release` (README, "Android release size").
bool_flag(
    name = "jni_exports_only",
    build_setting_default = False,
)

config_setting(
    name = "jni_exports_only_on",
    flag_values = {":jni_exports_only": "True"},
)

# The C++ runtime a JNI library links (libcxx.bzl): `static`, the NDK
# toolchain's default, libc++ inside the library and local to it; or
# `shared`, the NDK's libc++_shared.so, which the library needs and the app
# ships, for an app whose Swift shares C++ objects (exceptions, RTTI,
# standard library types) with another shared library built with the same
# NDK and `c++_shared` (README, "One C++ runtime with other libraries").
string_flag(
    name = "libcxx",
    build_setting_default = "static",
    values = [
        "shared",
        "static",
    ],
)

config_setting(
    name = "libcxx_shared",
    flag_values = {":libcxx": "shared"},
)

# The NDK's libc++_shared.so for the configuration's Android target (built
# in an Android configuration: a JNI library's link, an android_binary's
# native dependencies).
ndk_libcxx_shared(
    name = "ndk_libcxx_shared",
    tags = ["manual"],
)

# What an APK ships beside its JNI libraries for their C++ runtime, as
# cc_libraries for android_binary's deps beside the libraries' own:
# `cxx_runtime` follows the flag (the NDK's libc++_shared.so with
# `libcxx=shared`, nothing otherwise), `cxx_runtime_shared` is the
# libc++_shared.so a library with `libcxx = "shared"` of its own needs.
cc_library(
    name = "cxx_runtime",
    srcs = select({
        ":libcxx_shared": [":ndk_libcxx_shared"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

cc_library(
    name = "cxx_runtime_shared",
    srcs = [":ndk_libcxx_shared"],
    tags = ["manual"],
)

# The same file built for Android from any configuration (aarch64, or
# x86_64 under an x86_64 split), named as it ships: for an AAR's jni/<abi>/.
transition_binary(
    name = "libc++_shared.so",
    binary = ":ndk_libcxx_shared",
    platform = ":android-aarch64",
    tags = ["manual"],
)

# A reactor's host entries, read from a link of it exporting everything
# (swift_wasm_reactor.bzl's wasm_export_list): export_list/main.swift.
alias(
    name = "export_list",
    actual = "//swift_ffi/rules/export_list",
)

platform(
    name = "wasm32-wasip1",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)

# wasm32-unknown-wasip1-threads: shared memory, atomics and wasi-threads,
# built with the threads SDK a module declares beside the single-threaded
# one (`swift.wasm_sdk(threads = True, ...)`; see isomer's MODULE.bazel).
platform(
    name = "wasm32-wasip1-threads",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_swift//swift/toolchains/wasm:threaded",
    ],
)

platform(
    name = "android-aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

platform(
    name = "android-x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:android",
    ],
)

swift_library(
    name = "rules",
    srcs = ["reactor_stub.swift"],
    module_name = "Rules",
)
