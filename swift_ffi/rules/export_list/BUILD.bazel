load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

package(
    features = [
        # swift_ffi's own code is Swift 6, strict, and warning-free (this was
        # the repository-wide REPO.bazel setting when it was a repo of its own).
        "swift.enable_v6",
        "swift.treat_warnings_as_errors",
        "swift.upcoming.ExistentialAny",
        "swift.upcoming.StrictConcurrency",
    ],
)

# A reactor's host entries as a link response file, read from a link of it
# exporting everything (swift_wasm_reactor.bzl's wasm_export_list). Run by
# every reactor shipped dead-stripped (an Isomer web app's), so Swift and
# Foundation alone: a consumer's build needs no Python for it (it was
# export_list.py until 0.54, and writes what that wrote).
swift_binary(
    name = "export_list",
    srcs = ["main.swift"],
    module_name = "ExportList",
    visibility = ["//visibility:public"],
)
