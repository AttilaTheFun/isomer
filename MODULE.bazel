"""Isomer — SwiftUI for every platform, and the layers under it, as one module.

One Bazel module builds the same SwiftUI application code for:
  * web/     — Swift compiled to wasm32-unknown-wasip1 (React or WebGPU)
  * apple/   — the real SwiftUI via rules_apple / rules_swift
  * android/ — Swift cross-compiled to Android (Jetpack Compose or OpenGL ES)
  * linux/, windows/ — native binaries drawn with SwiftGPU

and carries the libraries it is built on, which were repositories of their
own until 2026-10-02 (each still usable alone, by label):
  * //swift_ffi/...       — the Swift <-> Kotlin/TypeScript/C bridge generator
  * //swift_gpu/...       — the GPU abstraction (Metal, WebGPU, GL, D3D11)
  * //swift_map/...       — the OpenStreetMap renderer behind `Map`
(SQLite is swift_sql's since 0.34: see "SQLite" below.)

Layering still only points downward (rules_swift < swift_ffi < swift_gpu <
swift_map < the SwiftUI libraries); a package under swift_ffi/ must not
depend on anything outside it, and so on up.

Only `examples/` is a module of its own: it consumes this one the way an
application outside the repository does.

Cross-compilation to WebAssembly and Android uses rules_swift's Swift-SDK
toolchains (see the `swift` extension below); the wasm/android targets are plain
`swift_library`/`swift_binary` built through `//tools/platforms`.
"""

module(
    name = "isomer",
    version = "0.49.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Apple platform (uses the locally installed Xcode, as all Bazel apple builds do).
# rules_swift from this project's registry (AttilaTheFun/bazel_registry,
# listed before the BCR in .bazelrc): 4.2.2.isomer.3 is upstream's 4.2.2 with
# six rules_swift pull requests until a release has them, each a patch in
# the registry entry, taken from the PR's head:
#   * #1989 (merged after 4.2.2): C compiled for wasm gets the Swift SDK's
#     clang resource directory, so <stdarg.h> and <stddef.h> come from the
#     SDK, among the action's inputs; C such as SQLite's amalgamation builds
#     as is;
#   * #1860: a metadata-driven wasm SDK and its wasip1-threads variant;
#   * #1990: a single-threaded and a threads wasm SDK side by side (two
#     `swift.wasm_sdk` tags), chosen by a platform's
#     `@rules_swift//swift/toolchains/wasm:threaded` constraint;
#   * #1995: Swift/C++ interop on Android (the SDK's clang headers copied
#     from the paired toolchain, swiftCxx and swiftCxxStdlib linked from
#     beside the shared runtime, -lc++ the static libc++).
#   * #1985 (merged after 4.2.2): swift.org's release metadata through 6.4.2;
#   * #2000: Android targets down to the Swift SDK's own minimum (6.4's: API
#     23), without RELR relocations below 28.
# It sorts above the 4.2.2 rules_applecross asks for, so no override holds
# it, here or in a consumer. A change is a new entry (4.2.2.isomer.4) made
# with the registry's tools/add_version.py --fork; back to a plain BCR
# version at the release that has them all.
bazel_dep(name = "rules_swift", version = "4.2.2.isomer.3")
# rules_apple and apple_support at rules_applecross's versions, from this
# project's registry: rules_apple 5.3.1.applecross.6 is rules_apple 5.3.1
# with rules_applecross's patches (bundling and signing on Linux), asking
# for rules_applecross 0.0.3.382f8c3, which asks for it back (a preset
# pair: no override, and no copies of the patches, in any root);
# apple_support is the BCR's 2.11.0, which has the fix it was patched for.
bazel_dep(name = "rules_apple", version = "5.3.1.applecross.6", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "apple_support", version = "2.11.0")
# Declared after apple_support so apple_support's apple cc toolchain keeps
# resolution priority over rules_cc's local_config_cc darwin toolchain (which
# lacks CC_TARGET_TRIPLE and breaks the Xcode Swift toolchain). Needed as a
# direct dep so the native linux/windows BUILD files can load @rules_cc//cc:defs.
bazel_dep(name = "rules_cc", version = "0.2.18")

# Hermetic Android NDK for the Swift Android cross-compile toolchain. rules_swift
# consumes the stock @androidndk (only targets it already exposes), so no
# override is needed here.
# The project registry's 0.5.0.isomer.1: upstream 0.5.0 with
# keith/hermetic_android_toolchains#110, so any Linux takes Google's x86_64
# SDK and NDK tools (an arm64 Linux, a container on a Mac, runs them under
# Rosetta, with x86_64 glibc beside its own). A version above 0.5.0, so MVS
# gives it to every consumer with no override (one was root-only, and each
# consumer carried its own copy of the patch until 0.42).
bazel_dep(name = "hermetic_android_toolchains", version = "0.5.0.isomer.1")

# --- swift_ffi (//swift_ffi/...) ---------------------------------------------
# The idiomatic Swift <-> Kotlin/TypeScript/C bridge layer. The wasm and
# Android host bridges are @ExportedInterface/@ExportedFunction surfaces;
# kt/ts/c_swift_library generate the JNI .so + Kotlin bindings and the wasm
# reactor + TypeScript bindings.

# The macro plugins (swift_ffi's, SwiftUI's) and the source analyzer use
# swift-syntax from the SwiftPM graph (use_repo below): the one release/6.4.x
# swift-foundation takes, matching the toolchain.

# --- Isomer's Swift package (Foundation and the frameworks off Apple) -------
# Isomer's Swift libraries are a Swift package too (Package.swift, at the
# root): Foundation, CoreGraphics, Combine and what they stand on.
# rules_swift_package_manager builds them from it, as @swiftpkg_isomer, in
# the application's one SwiftPM graph: an application lists isomer in its
# Package.swift (by revision: the release's tag or a commit) beside its
# bazel_dep here, so swift-foundation and swift-collections resolve once,
# for its packages and Isomer's alike. This module's own graph, used when it
# is the root (third_party/swift_packages), takes the package by path.
#
# Isomer's Foundation is built over swift-foundation's FoundationEssentials
# (and FoundationInternationalization when an app asks for it,
# //foundation:internationalization), adding what corelibs gives Swift code
# elsewhere (CharacterSet, NSString's string API, String(format:) and the
# rest of foundation/). Apple platforms use Apple's Foundation.
#
# swift-foundation's patches: swift-foundation#2409 (merged upstream; in its
# next release), Android's fts_open (the Android SDK's apinotes would make it
# unneeded, but rules_swift compiles with the static resource directory,
# which has none), Apple's signatures where swift-foundation's differ and its
# extra declarations made internal, and `package` on the Essentials helpers
# Foundation searches strings with (it is built in swift-foundation's package
# for that).
#
# The registry's 1.25.0.isomer.1: upstream 1.25.0 with three pull requests to
# cgrindel/rules_swift_package_manager, until a release has them (MVS gives
# it to every consumer): #2638
# (a local package that is a Bazel module too, isomer's taken by path in its
# own graph, is copied without its Bazel files), #2639 (no Apple minimum OS
# versions off Apple: isomer declares iOS 16 and macOS 13 over
# swift-foundation's 26) and #2640 (a Swift target's cSettings defines reach
# its Clang importer, as SwiftPM passes them: swift-foundation's WASI
# emulation macros).
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0.isomer.1")

# rules_swift_package_manager's own extension, so an application's graph and
# this module's packages are one: what isomer declares here (its patches, a
# dependency of its Foundation) applies to the application's graph, and the
# repositories isomer uses are that graph's. Its graph is declared only when
# it is the root (dev_dependency, below): every module's from_package is
# resolved, and two graphs would declare the same repositories.
swift_deps = use_extension("@rules_swift_package_manager//:extensions.bzl", "swift_deps")
swift_deps.configure_package(
    name = "swift-foundation",
    patch_args = ["-p1"],
    patches = [
        "//tools/patches:swift_foundation_create_directory_root.patch",
        "//tools/patches:swift_foundation_apple_interface.patch",
        "//tools/patches:swift_foundation_package_helpers.patch",
        "//tools/patches:swift_foundation_sdk_icu.patch",
    ],
)

# FoundationInternationalization, re-exported by Foundation when the build
# asks for it (`--@isomer//foundation:internationalization`, which no
# SwiftPM condition can express): a module Foundation can import, or
# nothing (foundation/internationalization). The generated repositories see
# @isomer by the application's inject_repo (README: "Consuming isomer").
swift_deps.configure_package(
    name = "isomer",
    # And the wire protos' Swift, which the package generates with
    # swift-protobuf's build plugin, a plugin rules_swift_package_manager
    # doesn't run: swift_proto_library's modules, which IsomerSwiftUI and
    # IsomerWire re-export (//shared/wire).
    target_deps = {
        "Foundation": ["@isomer//foundation/internationalization"],
        "IsomerSwiftUI": ["@isomer//shared/wire:tree_messages"],
        "IsomerWire": ["@isomer//shared/wire:wire_messages"],
    },
)
# SwiftProtobuf (the render tree's wire format, shared/wire/tree.proto):
# where Isomer's Foundation is the Foundation (the web, Android), its
# `import Foundation` is Isomer's, as every package an application links
# there (README).
swift_deps.configure_package(
    name = "swift-protobuf",
    target_deps = {"SwiftProtobuf": ["@isomer//foundation:for_swift_packages"]},
)
# gRPC Swift 2 and SwiftNIO (driving an app: drive/): in every application's
# graph, as isomer's package depends on them; built only where an app is
# served or driven from (a Mac, Linux), never for the web or Android.
use_repo(
    swift_deps,
    "swiftpkg_grpc_swift_2",
    "swiftpkg_grpc_swift_nio_transport",
    "swiftpkg_grpc_swift_protobuf",
    "swiftpkg_isomer",
    "swiftpkg_swift_foundation",
    "swiftpkg_swift_nio",
    "swiftpkg_swift_protobuf",
    "swiftpkg_swift_syntax",
)

swift_deps_root = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
    dev_dependency = True,
)
swift_deps_root.from_package(
    resolved = "//third_party/swift_packages:Package.resolved",
    swift = "//third_party/swift_packages:Package.swift",
)
inject_repo(swift_deps_root, "isomer")

# CLI parsing for the analyzer / generator tools.
bazel_dep(name = "swift_argument_parser", version = "1.7.0")

# WasmKit (AttilaTheFun/WasmKit, a fork of swiftwasm/WasmKit) — the Swift
# WebAssembly interpreter behind `WasmKitRuntime` (//shared/wasm_host),
# Isomer's engine on every native host (Apple, Android, Linux, Windows) since
# 0.38, when it replaced WAMR. The fork's commits are the engine
# work measured in a private harness (interpreted, against WAMR on the same
# reactor): the one accepted there (0de40a7), shared memory and WASI Threads
# enabled on iOS (285def1), then the harness's dispatch fusions (5fbb9db,
# branch hillclimb/add-branch-dispatch: 6.6% lower latency in aggregate, no
# workload's median slower), pinned for 0.33 (9) on request before
# the harness's per-workload confidence gates closed. Nothing of Isomer's is in the
# fork: the Bazel build is ours (tools/wasmkit/BUILD.wasmkit.bazel, after its
# Package.swift). Not in the BCR.
wasmkit_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

wasmkit_archive(
    name = "wasmkit",
    build_file = "//tools/wasmkit:BUILD.wasmkit.bazel",
    # Android is Linux to WasmKit's C (guard pages, `__linux__`) and not to
    # its Swift (`os(Linux)` is false there): its guard-page bounds checks
    # would be half on. Android checks bounds in software, as Windows does.
    # And MSVC's C compiler (Windows) has no clang atomic builtins: its C
    # goes without the atomics only Swift uses.
    patch_args = ["-p1"],
    patches = [
        "//tools/patches:wasmkit_android_software_bounds.patch",
        "//tools/patches:wasmkit_msvc_c.patch",
    ],
    sha256 = "4618c7d55c0fe0d8756e2e29c557ad52d8ff8ef7fafe96ec7e53da9242748958",
    strip_prefix = "WasmKit-5fbb9db8a130edf2971fc57b25186a62b689a693",
    url = "https://github.com/AttilaTheFun/WasmKit/archive/5fbb9db8a130edf2971fc57b25186a62b689a693.tar.gz",
)

# TypeScript: ts_swift_library wraps a real ts_project, so aspect_rules_ts
# (+ rules_js and the hermetic node toolchain) are full dependencies.
bazel_dep(name = "aspect_rules_js", version = "3.2.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.11")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

# The tsc that ts_project runs. Pins @npm_typescript (the tsc ts_swift_library
# compiles bridges with) in this module's own repo mapping, so consumers need
# no rules_ts setup. The version is given here rather than read from a
# package.json: nothing in the module uses npm packages.
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version = "5.8.3")
use_repo(rules_ts_ext, "npm_typescript")

# Rust (dev-only: swift_ffi's rs_dependent_library example cells; consumers
# who want Rust bindings add rules_rust themselves and load
# //swift_ffi/rules:rs.bzl).
bazel_dep(name = "rules_rust", version = "0.71.3", dev_dependency = True)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all", dev_dependency = True)

# --- SQLite (swift_sql) ------------------------------------------------------
# An app's SQLite is swift_sql's (AttilaTheFun/swift_sql, public: the C
# API as CSwiftSQL, the Swift layer SwiftSQL), a Swift package an app takes
# through rules_swift_package_manager; it left isomer at 0.34. The
# examples consume it, and check SQLite's WebAssembly builds under WasmKit
# (examples' //tests/sqlite_wasi, through //tools/wasm/wasi_run). C compiled for wasm needs the rules_swift
# patch above (the SDK's clang resource directory).

# protoc and proto_library: the wire protos' Swift (shared/wire) is generated
# as it builds, by swift_proto_library (rules_swift), for every application
# that links IsomerSwiftUI or IsomerWire (a SwiftPM build generates it with
# swift-protobuf's plugin instead).
bazel_dep(name = "protobuf", version = "34.0.bcr.1")

# swift_map (//swift_map/...) backs the SwiftUI `Map` view on Apple (Metal) and
# on every SwiftGPURenderer platform; the platform SwiftUI modules reference
# it behind `//shared:map` (`--config=map`) and every SwiftMap use is
# `#if canImport(SwiftMap)`-gated, so an application that shows no map links
# none of it. swift_gpu (//swift_gpu/...) is the GPU abstraction behind the
# single self-drawing renderer; all direct GPU calls live there.

# Bundles the web runtime (boot.js + the generated TypeScript bindings) into
# one plain-JS file for the browser.
bazel_dep(name = "aspect_rules_esbuild", version = "0.26.0")

# Generates Xcode projects for the Apple example applications
# (`bazel run //apple/storybook_ios_application:storybook_ios_application_project` in examples/).
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

# Hermetic Python used to serve the web application from `bazel run`.
bazel_dep(name = "rules_python", version = "2.0.2")

# Shell rules for the adb install/run wrapper.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Real-world Android APK assembly for the example app: rules_android's
# `android_binary` + rules_kotlin's `kt_android_library` (what people actually
# ship with), replacing the bespoke hermetic kotlinc/d8/aapt2 pipeline in
# //tools/android. rules_jvm_external resolves rules_android's own Maven graph.
bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_kotlin", version = "2.2.2")
bazel_dep(name = "rules_jvm_external", version = "7.1")

# rules_java's host JDK + java tools (needed by rules_android's Java actions).
rules_java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(rules_java_toolchains, "remote_java_tools")

# rules_android's Maven dependencies (resolved + pinned to a checked-in lock).
#   REPIN=1 bazel run @rules_android_maven//:pin
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "rules_android_maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    # Jetpack Compose for the high-level Android renderer
    # (Renderer.bind(.jetpackCompose)); the embeddable compose compiler must
    # match rules_kotlin's kotlinc release (2.2.21).
    artifacts = [
        # Pinned to satisfy coursier's strict version-range resolution.
        "androidx.collection:collection:1.4.0",
        # The real ListenableFuture (androidx pulls the empty
        # 9999.0-empty-to-avoid-conflict-with-guava marker by default).
        "com.google.guava:listenablefuture:1.0",
        "androidx.lifecycle:lifecycle-common:2.8.7",
        "androidx.lifecycle:lifecycle-runtime:2.8.7",
        "androidx.activity:activity-compose:1.9.3",
        "androidx.compose.foundation:foundation:1.7.8",
        "androidx.fragment:fragment:1.8.5",
        "androidx.compose.material3:material3:1.3.2",
        "androidx.compose.runtime:runtime:1.7.8",
        "androidx.compose.ui:ui:1.7.8",
        # Chrome Custom Tabs: the Playground's "Run on the web" opens its
        # in-app server's page in one (the SFSafariViewController of Android).
        "androidx.browser:browser:1.8.0",
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.2.21",
        # Jetpack Macrobenchmark: the platform-native perf harness
        # (//tools/benchmark/android_macrobenchmark) - StartupTimingMetric +
        # TraceSectionMetric instrumentation APK driven over adb.
        "androidx.benchmark:benchmark-macro-junit4:1.3.4",
        "androidx.test.uiautomator:uiautomator:2.3.0",
        "androidx.test:runner:1.6.2",
        "androidx.test.ext:junit:1.2.1",
        "androidx.tracing:tracing:1.2.0",
        # benchmark-common's perfetto proto classes extend wire's runtime;
        # coursier resolves the KMP root (metadata-only jar) - pin the -jvm
        # artifact that actually carries the classes.
        "com.squareup.wire:wire-runtime-jvm:4.9.7",
        # ProfileInstaller's ProfileInstallReceiver in each cell APK: macro's
        # per-iteration DROP_SHADER_CACHE broadcast targets it.
        "androidx.profileinstaller:profileinstaller:1.4.1",
        "androidx.startup:startup-runtime:1.1.1",
        "junit:junit:4.13.2",
    ],
    known_contributing_modules = ["rules_android"],
    lock_file = "//:rules_android_maven_install.json",
    # Compose's androidx graph mixes exact-pin ranges with old floors;
    # resolve to the pinned/highest versions instead of failing.
    version_conflict_policy = "pinned",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "rules_android_maven")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Swift-SDK cross-compilation to WebAssembly and Android, provided by the
# overridden rules_swift (above). Downloads the swift.org 6.4.2 host toolchain
# and the matching WebAssembly / Android Swift SDK artifact bundles; the Apple
# build is unaffected (it uses the system Xcode toolchain).
#
# DEV-ONLY, with the two registrations below: rules_swift's `swift` extension
# belongs to the root module ("packages meant to be used as deps should use
# dev_dependency = True") — it takes its tags from the LAST module that uses
# it, so a non-dev use here would silently replace a consumer's own SDK choice
# (a wasi-threads build, say, picks a different wasm SDK). Every
# consumer therefore declares these tags and registers these toolchains itself;
# examples/MODULE.bazel is the block to copy.
swift = use_extension("@rules_swift//swift:extensions.bzl", "swift", dev_dependency = True)
swift.toolchain(
    name = "swift_toolchain",
    swift_version = "6.4.2",
)
swift.wasm_sdk()
# No wasi-threads SDK beside it since 0.41: Isomer's was a build of
# Swift 6.3.2 with swiftlang/swift#92018, which reaches a release in 6.5;
# reactors built for `@isomer//swift_ffi/rules:wasm32-wasip1-threads` wait
# for it (TODO.md).
swift.android_sdk()
use_repo(
    swift,
    # Aggregator repo: holds the registered toolchains and a host-independent
    # `:libcxx_shared_{arch}` alias for the NDK's libc++_shared.so (bundled into
    # the APK alongside the app's .so).
    "swift_toolchain",
    "swift_toolchain_xcode",
)

# macOS host: register the `_xcode` Swift-SDK toolchains. They carry os:wasi /
# os:android *target* constraints, so they never compete with the Xcode Swift
# toolchain that the Apple build resolves.
register_toolchains(
    "@swift_toolchain//:cc_toolchain_wasm32_xcode",
    "@swift_toolchain//:swift_toolchain_wasm32_xcode",
    # SPIKE: android C/C++ + linking now go through @androidndk//:all (registered
    # below); only the Swift toolchain comes from rules_swift.
    "@swift_toolchain//:swift_toolchain_android_aarch64_xcode",
    "@swift_toolchain//:swift_toolchain_android_x86_64_xcode",
    dev_dependency = True,
)

# Linux host (e.g. SteamOS / Ubuntu): register the swift.org `ubuntu24.04`
# standalone toolchain as the host *exec* Swift toolchain, so the native Linux
# target (`//linux/...`) builds with `swift_library`/`swift_binary` the same way
# the native Windows target builds on a Windows host. The downloads are lazy —
# only fetched when a toolchain is actually resolved (i.e. on a Linux host) —
# and their `exec_compatible_with = [os:linux, cpu:...]` constraints mean they
# are simply ignored on the macOS/Windows hosts. Both architectures: x86_64
# (SteamOS, most desktops) and aarch64 (ARM machines, and the arm64 Shireworks
#  containers tools/linux/build.sh and CI build in). The wasm/Android
# *cross* SDK toolchains paired with this host are registered too, so
# `bazel build //...` from a Linux host can target those as well. C++ (the GL
# renderer) and final linking use Bazel's autoconfigured host cc toolchain
# (system gcc).
register_toolchains(
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04",
    # SPIKE: android C/C++ via @androidndk//:all; only Swift from rules_swift.
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04-aarch64",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04-aarch64",
    dev_dependency = True,
)

# The Apple targets built on Linux (a container, a VM): rules_applecross (its
# clean-room actool, ibtool, codesign and swift-stdlib-tool, LLD), the Swift
# that built Xcode 27.0's SDKs (6.4.0: the Apple targets only; the others
# are on 6.4.2 above), and Xcode 27.0's SDKs, pinned by version and SHA-256. A
# Mac reads its own Xcode (local_xcode); elsewhere the SDK archive is fetched
# by its name below, a placeholder: each builder's .bazelrc.user says where
# it is, with `--distdir=<folder holding apple-sdks-27.0.tar.gz>` or a
# `--downloader_config` rewriting apple-sdks.invalid to where it is served
# (a Shireworks server's /files/sha256/<hex>, its read token in .netrc). The
# toolchains are registered for Linux alone, by the builder that has the SDK
# (.bazelrc's apple_on_linux, turned on in .bazelrc.user), so a Mac builds as
# before. Dev-only: a consumer brings its own (its root's overrides too).
# rules_applecross's graph raises rules_go to 0.62 and gazelle to 0.51,
# whose repo tooling needs Go >= 1.24.12; a hermetic Go SDK of that version
# (as the examples have), so the host's Go is never consulted.
bazel_dep(name = "rules_go", version = "0.62.0", dev_dependency = True)
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.24.12")
# From the project's registry: 0.0.3.382f8c3 is rules_applecross's main at
# 382f8c3 (its module() version set to the entry's, and rules_apple asked
# for as the preset 5.3.1.applecross.6), until it has a release in the BCR.
bazel_dep(name = "rules_applecross", version = "0.0.3.382f8c3", dev_dependency = True)
apple_cross_toolchain = use_extension("@rules_applecross//toolchain:extensions.bzl", "apple_cross_toolchain", dev_dependency = True)
apple_cross_toolchain.swift(
    name = "applecross_swift",
    platform_sha256 = {
        "ubuntu24.04": "69f7b2b4dbce6090b6c92194b71149a057e16269093b5a9dded38afc4a05094e",
        "ubuntu24.04-aarch64": "21eacfe571194717d269cc1e0030533bbee6131dfde82cd4f9cfbc2512e354a9",
        # Only fetched for Swift compiles on a macOS execution platform.
        "xcode": "8fd03185b98fe27f54a54631c2449decf75d5b466ce8e34abbd414141063c6aa",
    },
    swift_version = "6.4.0",
)
apple_cross_toolchain.configure(
    name = "apple_cross_toolchain",
    apple_sdk_urls = ["https://apple-sdks.invalid/apple-sdks-27.0.tar.gz"],
    local_xcode = True,
    # Its ported tools from its main, ahead of a release (tools/applecross).
    ported_tools_manifest = "//tools/applecross:ported_tools.sha256",
    ported_tools_urls = ["https://ported-tools.invalid/sha256/{sha256}"],
    swift_tools = {
        "aarch64": "@applecross_swift_ubuntu24.04-aarch64//:tools",
        "x86_64": "@applecross_swift_ubuntu24.04//:tools",
    },
    swift_tools_macos = "@applecross_swift_xcode//:tools",
    xcode_version = "27.0",
)
use_repo(apple_cross_toolchain, "apple_cross_toolchain")
# Where Apple products are bundled: on Linux with the clean-room tools, on a
# Mac with its Xcode.
register_toolchains(
    "@rules_applecross//toolchain:apple_bundling_on_linux",
    "@rules_applecross//toolchain:apple_bundling_on_macos",
    dev_dependency = True,
)

# @androidndk: the hermetic Android NDK that provides the C/C++ cc toolchains for
# the Swift→Android cross-compile. rules_swift's Swift Android toolchain links
# through these and reads the sysroot from them. The extension also requires an
# android.sdk tag, but isomer packages its APK with its own `android_tools`
# (below), so @androidsdk is never fetched.
# A dev dependency (hermetic_android_toolchains 0.5.0 reports its repositories
# so; it reads the root module's tags alone): each root declares its own.
android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "35.0.0",
    version = "35",
)
android.ndk(
    api_level = 28,
    version = "r30",
)

# @androidndk supplies the Swift→Android C/C++ cc toolchains; @androidsdk is the
# Android SDK that rules_android's `android_binary`/aapt2/resource pipeline uses.
use_repo(android, "androidndk", "androidsdk")

# Point rules_android at the hermetic @androidsdk (instead of $ANDROID_HOME).
rules_android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
    dev_dependency = True,
)
override_repo(rules_android_sdk, "androidsdk")

# Register @androidndk's cc toolchains (Swift→Android C/C++ + linking) and
# @androidsdk's Android toolchains (used by rules_android).
register_toolchains(
    "@androidndk//:all",
    "@androidsdk//:all",
    dev_dependency = True,
)

# Hermetic Electron for the desktop wrapper around the wasm app (and the
# win32-x64 runtime used to package a Windows-runnable build from macOS).
wasm_tools = use_extension("//tools/wasm:extensions.bzl", "wasm_tools")
use_repo(wasm_tools, "electron", "electron_win64")

android_tools = use_extension("//tools/android:extensions.bzl", "android_tools")
use_repo(
    android_tools,
    "android_build_tools",
    "android_emulator",
    "android_platform_jar",
    "android_platform_tools",
    "android_system_image",
    "hermetic_jdk",
    "kotlin_compiler",
)

# --- Experimental wasm engine (dev-only): WasmEdge ---------------------------
#
# The prebuilt macOS arm64 C-API SDK for the pluggable-engine experiment
# (//shared/wasm_host:wasmedge_runtime). It conforms to the same WasmRuntime
# seam as WasmKit and JSC; the engine conformance suite
# (examples' //tests/wasm_engines) drives all of them through the real reactor. A static
# lib, so tests link hermetically. Never referenced by shipping targets.
engine_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
engine_archive(
    name = "wasmedge_static",
    build_file_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "wasmedge",
    srcs = ["lib/libwasmedge.a"],
    hdrs = glob(["include/**/*.h", "include/**/*.inc"]),
    includes = ["include"],
    linkopts = [
        "-lc++",
        "-lz",
    ],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "ca319dc10e0aaa70535b5b3023dc74763efe3fbecb37aff609bdb48a4d2653e9",
    urls = ["https://github.com/WasmEdge/WasmEdge/releases/download/0.17.1/WasmEdge-0.17.1-darwin_arm64_static.tar.gz"],
)

