load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# IsomerHeadless: the client tests and agents drive a headless Isomer app
# with (HeadlessApp.swift), over any of drive/'s transports: an app it starts,
# one served at a URL, one attached to a hub, a server in the same process,
# or a headful app a launcher starts, attached to a hub of its own.
swift_library(
    name = "isomer_headless",
    srcs = [
        "HeadlessApp.swift",
        "HostedPicture.swift",
    ],
    module_name = "IsomerHeadless",
    deps = [
        "//drive/serving",
        "//drive/websocket",
        "//shared/wire/swift",
    ] + select({
        # Not on Windows (HeadlessApp.swift): the process transport, and
        # IsomerRemote, whose gRPC brings swift-nio-ssl.
        "@platforms//os:windows": [],
        "//conditions:default": [
            "//drive/process",
            "//drive/remote",
        ],
    }),
)
