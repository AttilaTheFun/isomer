load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")

load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# The headless platform module: the shared core and renderers compiled for the
# building machine (macOS, or Linux in a container) with HeadlessHost.swift,
# whose `App.main()` reads and drives the app's UI over standard input and
# output with nothing drawn (HeadlessHost.swift says the protocol). An app
# builds against it with --@isomer//headless, which points @isomer//:swift_ui
# and @isomer//:isomer here.
#
# Its own package, as the other platform SwiftUI twins: the
# `SwiftUI.swiftmodule` output must not collide with another module of the
# same name in one build.
one_configuration(
    name = "swift_ui",
    actual = "@swiftpkg_isomer//:SwiftUI",
)

# The headless host (HeadlessHost.swift; RemoteSession.swift its remote
# session): a module of its own over the SwiftUI above, reaching the
# runtime's `package` plumbing as a module of Isomer's package. It defines
# `iso_process_host_run`, so a binary that links it is run headless
# (shared/swift_ui_core/App.swift). Its protocols are //shared/wire's.
swift_library(
    name = "host",
    package_name = "isomer",
    srcs = [
        "HeadlessHost.swift",
        "RemoteSession.swift",
    ],
    alwayslink = True,
    module_name = "IsomerHeadlessHost",
    deps = [
        ":swift_ui",
        "//shared/isomer_swift_ui",
        "//shared/wire/swift",
        "@swiftpkg_swift_protobuf//:SwiftProtobuf",
    ],
)

swift_library(
    name = "isomer",
    package_name = "isomer",
    srcs = [
        "//shared/isomer:Bridge.swift",
        "//shared/isomer:Exports.swift",
        "//shared/swift_ui_extensions:srcs",
    ],
    module_name = "Isomer",
    deps = [
        ":swift_ui",
        "//swift_ffi/swift_ffi",
        "//shared/isomer_swift_ui",
    ],
)

one_configuration(
    name = "photos_ui",
    actual = "@swiftpkg_isomer//:PhotosUI",
)

# What an app builds against headless. On a Mac, the system's
# UniformTypeIdentifiers and CoreTransferable serve (Isomer's are for the
# platforms without Apple's), and there is no PhotosUI: Apple's would bring
# Apple's SwiftUI beside this one.
swift_library_group(
    name = "sdk",
    deps = [
        ":host",
        ":isomer",
        ":swift_ui",
    ] + select({
        "@platforms//os:macos": [],
        "//conditions:default": [
            ":photos_ui",
            "//frameworks/uniform_type_identifiers",
        ],
    }),
)
