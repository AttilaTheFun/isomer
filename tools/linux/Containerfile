# Building Isomer from a Mac in a Linux container (tools/linux/build.sh):
# Ubuntu 24.04 with what the Linux targets link (SDL2, SDL2_ttf, libcurl,
# OpenGL and EGL through libglvnd; GTK 3 and WebKitGTK for the web view),
# clang and Bazel; Android's x86_64 tools under Rosetta; the Apple targets
# with rules_applecross. The Swift
# toolchain is Bazel's (MODULE.bazel's swift.org ubuntu24.04 toolchains, x86_64
# and aarch64, with the wasm SDK for the wasm cell's reactor); the image's own
# 6.3.2 brings the system libraries it runs on.
FROM docker.io/library/swift:6.3.2-noble
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang lld curl ca-certificates git python3 unzip zip pkg-config \
        libsdl2-dev libsdl2-ttf-dev libcurl4-openssl-dev libgl-dev libegl-dev libglvnd-dev libsqlite3-dev \
        libgtk-3-dev libwebkit2gtk-4.1-dev \
    && rm -rf /var/lib/apt/lists/*
# On arm64, x86_64 glibc beside the system's own: Google's Linux Android SDK
# and NDK tools are x86_64 programs, run under Rosetta (build.sh runs the
# container with it), as in Visor's agent image.
RUN if [ "$(uname -m)" = aarch64 ]; then \
      dpkg --add-architecture amd64 \
   && sed -i 's/^Types: deb$/Types: deb\nArchitectures: arm64/' /etc/apt/sources.list.d/ubuntu.sources \
   && printf '%s\n' 'Types: deb' 'URIs: http://archive.ubuntu.com/ubuntu/' 'Suites: noble noble-updates' 'Components: main' 'Architectures: amd64' 'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' '' \
        'Types: deb' 'URIs: http://security.ubuntu.com/ubuntu/' 'Suites: noble-security' 'Components: main' 'Architectures: amd64' 'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' > /etc/apt/sources.list.d/ubuntu-amd64.sources \
   && apt-get update \
   && apt-get install -y --no-install-recommends libc6:amd64 libstdc++6:amd64 zlib1g:amd64 \
   && rm -rf /var/lib/apt/lists/*; \
    fi
RUN arch="$(uname -m)"; case "$arch" in aarch64) arch=arm64;; x86_64) arch=x86_64;; *) exit 1;; esac; \
    curl -fsSL "https://releases.bazel.build/9.1.1/release/bazel-9.1.1-linux-$arch" -o /usr/local/bin/bazel && chmod +x /usr/local/bin/bazel
ENV CC=clang CXX=clang++
WORKDIR /workspace
