+    # inputs, rather than by an absolute path into the host toolchain that
+    # Bazel's inclusion check rejects.
+    args = [
+        "-resource-dir",
+        _RESOURCE_DIR + "/clang",
+    ],
+)
+
+cc_args(
     name = "cc_link_args_wasm32",
     actions = [
         "@rules_cc//cc/toolchains/actions:link_actions",
@@ -136,6 +152,7 @@
     name = "cc_toolchain_wasm32",
