+++ b/swift/internal/extensions/wasmsdk.BUILD
@@ -113,6 +113,22 @@
 )
 
 cc_args(
+    name = "cc_compile_args_wasm32",
+    actions = [
+        "@rules_cc//cc/toolchains/actions:compile_actions",
+    ],
+    # The Swift SDK's clang resource directory for compiles too: its
+    # include/ has clang's own headers (<stdarg.h>, <stddef.h>), which C
