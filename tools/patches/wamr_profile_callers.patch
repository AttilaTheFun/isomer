         /* parent function */
         if (prev_frame && prev_frame->function)
             prev_frame->function->children_exec_time += time_elapsed;
+
+        if (frame->function == wasm_perf_traced_function)
+            wasm_perf_note_traced_call(prev_frame, time_elapsed);
     }
 #endif
