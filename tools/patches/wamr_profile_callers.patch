+
+/* Who calls one function: with `ISO_WAMR_CALLERS=<its name>` in the
+   environment, each call's time between two dumps of the profile, by the
+   chain of functions it was called through, printed after the second. The
+   first dump finds the function (from then on FREE_FRAME reports its
+   calls) and starts the count afresh. */
+#define CALLER_DEPTH 12
+#define CALLER_SLOTS 8192
+
+typedef struct CallerChain {
+    WASMFunctionInstance *chain[CALLER_DEPTH];
+    uint64 time;
+    uint32 count;
+} CallerChain;
+
+WASMFunctionInstance *wasm_perf_traced_function = NULL;
+static CallerChain caller_chains[CALLER_SLOTS];
+
+void
+wasm_perf_note_traced_call(const WASMInterpFrame *caller, uint64 elapsed)
+{
+    WASMFunctionInstance *chain[CALLER_DEPTH] = { 0 };
+    uint32 n = 0, hash = 2166136261u, i;
+
+    for (; caller && n < CALLER_DEPTH; caller = caller->prev_frame) {
+        if (!caller->function)
+            continue;
+        chain[n++] = caller->function;
+        hash = (hash ^ (uint32)(uintptr_t)caller->function) * 16777619u;
+    }
+    for (i = 0; i < CALLER_SLOTS; i++) {
+        CallerChain *slot = &caller_chains[(hash + i) & (CALLER_SLOTS - 1)];
+        if (slot->count == 0)
+            memcpy(slot->chain, chain, sizeof(chain));
+        else if (memcmp(slot->chain, chain, sizeof(chain)) != 0)
+            continue;
+        slot->count++;
+        slot->time += elapsed;
+        return;
+    }
+}
+
+static int
+compare_caller_chains(const void *a, const void *b)
+{
+    uint64 x = (*(const CallerChain *const *)a)->time;
+    uint64 y = (*(const CallerChain *const *)b)->time;
+    return x < y ? 1 : x > y ? -1 : 0;
+}
+
+static void
+dump_traced_callers(const WASMModuleInstance *module_inst)
+{
+    const char *traced = getenv("ISO_WAMR_CALLERS");
+    CallerChain *sorted[CALLER_SLOTS];
+    uint32 count = 0, i, j;
+
+    if (!traced)
+        return;
+    if (wasm_perf_traced_function) {
+        for (i = 0; i < CALLER_SLOTS; i++) {
+            if (caller_chains[i].count)
+                sorted[count++] = &caller_chains[i];
+        }
+        qsort(sorted, count, sizeof(sorted[0]), compare_caller_chains);
+        for (i = 0; i < count && i < 80; i++) {
+            os_printf("[wamr-callers] %.3f ms, %" PRIu32 " calls", sorted[i]->time / 1000.0, sorted[i]->count);
+            for (j = 0; j < CALLER_DEPTH && sorted[i]->chain[j]; j++) {
+                char *name = get_func_name_from_index(
+                    module_inst,
+                    (uint32)(sorted[i]->chain[j] - module_inst->e->functions));
+                os_printf(" <- %s", name ? name : "?");
+            }
+            os_printf("\n");
+        }
+        os_printf("[wamr-callers] end\n");
+    }
+    memset(caller_chains, 0, sizeof(caller_chains));
+    for (i = 0; i < module_inst->e->function_count; i++) {
+        char *name = get_func_name_from_index(module_inst, i);
+        if (name && strcmp(name, traced) == 0) {
+            wasm_perf_traced_function = module_inst->e->functions + i;
+            break;
+        }
+    }
 }
 
