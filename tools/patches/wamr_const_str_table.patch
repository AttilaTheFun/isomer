The wasm loader keeps the module's strings (import, export and function
names) in a list it searches before adding one, which made loading a name
section quadratic: wamrc spent ~30 s reading the function names of Visor's
reactor. A hash table beside the list finds them; the list and the strings
are unchanged. Worth offering upstream.

diff --git a/core/iwasm/interpreter/wasm.h b/core/iwasm/interpreter/wasm.h
index c60349d..d3ed1b7 100644
--- a/core/iwasm/interpreter/wasm.h
+++ b/core/iwasm/interpreter/wasm.h
@@ -1004,6 +1004,12 @@ struct WASMModule {
     bool possible_memory_grow;
 
     StringList const_str_list;
+    /* const_str_list by content: an open-addressing table of its nodes (its
+       size a power of two, at most half full). Searched by walking the list,
+       a name section of a hundred thousand functions took minutes to load. */
+    StringNode **const_str_table;
+    uint32 const_str_table_size;
+    uint32 const_str_count;
 #if WASM_ENABLE_FAST_INTERP == 0
     bh_list br_table_cache_list_head;
     bh_list *br_table_cache_list;
diff --git a/core/iwasm/interpreter/wasm_loader.c b/core/iwasm/interpreter/wasm_loader.c
index 0900223..f5316de 100644
--- a/core/iwasm/interpreter/wasm_loader.c
+++ b/core/iwasm/interpreter/wasm_loader.c
@@ -7478,6 +7478,10 @@ wasm_loader_unload(WASMModule *module)
         }
     }
 
+    if (module->const_str_table) {
+        wasm_runtime_free(module->const_str_table);
+    }
+
 #if WASM_ENABLE_STRINGREF != 0
     if (module->string_literal_ptrs) {
