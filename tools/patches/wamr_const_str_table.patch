diff --git a/core/iwasm/interpreter/wasm_runtime.c b/core/iwasm/interpreter/wasm_runtime.c
index 879df37..ffa8209 100644
--- a/core/iwasm/interpreter/wasm_runtime.c
+++ b/core/iwasm/interpreter/wasm_runtime.c
@@ -5101,12 +5101,63 @@ wasm_check_utf8_str(const uint8 *str, uint32 len)
     return (p == p_end);
 }
 
+static uint32
+const_str_hash(const uint8 *str, uint32 len)
+{
+    /* FNV-1a */
+    uint32 hash = 2166136261u, i;
+    for (i = 0; i < len; i++) {
+        hash ^= str[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+/* The table's slot holding the string, or the empty slot where it would go. */
+static StringNode **
+const_str_slot(StringNode **table, uint32 size, const uint8 *str, uint32 len)
+{
+    uint32 mask = size - 1;
+    uint32 i = const_str_hash(str, len) & mask;
+    while (table[i]
+           && !(strlen(table[i]->str) == len
+                && !memcmp(table[i]->str, str, len)))
+        i = (i + 1) & mask;
+    return &table[i];
+}
+
+/* Makes room in the table for one more string. */
+static bool
+const_str_table_reserve(WASMModule *module, char *error_buf,
+                        uint32 error_buf_size)
+{
+    uint32 old_size = module->const_str_table_size, size, i;
+    StringNode **old = module->const_str_table, **table;
+
+    if ((uint64)(module->const_str_count + 1) * 2 <= old_size)
+        return true;
+    size = old_size ? old_size * 2 : 256;
+    if (!(table = runtime_malloc(sizeof(StringNode *) * (uint64)size,
+                                 error_buf, error_buf_size)))
+        return false;
+    for (i = 0; i < old_size; i++) {
+        if (old[i])
+            *const_str_slot(table, size, (const uint8 *)old[i]->str,
+                            (uint32)strlen(old[i]->str)) = old[i];
+    }
+    if (old)
+        wasm_runtime_free(old);
+    module->const_str_table = table;
+    module->const_str_table_size = size;
+    return true;
+}
+
