<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by isomer_android_app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{PACKAGE}"{VERSION_ATTRS}>

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />{EXTRA_PERMISSIONS}

    <application
        android:label="{LABEL}"
        android:extractNativeLibs="true"{APPLICATION_ATTRS}
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <profileable
            android:enabled="true"
            android:shell="true" />
        <!-- adjustResize: with the keyboard up the window ends at its top
             edge, and the SwiftUI layout (a bottom-pinned composer among
             it) fits above it, as on iOS, rather than the window being
             panned by just enough to show the caret. -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>{EXTRA_INTENT_FILTERS}
        </activity>{EXTRA_APPLICATION}
    </application>
</manifest>
