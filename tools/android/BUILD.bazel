load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# Android's macros and rules are the isomer_android module's since 0.59
# (android/module: @isomer_android//:defs.bzl; defs.bzl here only says so).
# What they use that loads no Android rules stays here: the templates, the
# debug keystore, the AAR's assembly, the tools' extension, the emulator
# runner and the flags (`--@isomer//tools/android:shared_platform`).

exports_files([
    "aar_manifest.xml.tpl",
    "debug.keystore",
    "defs.bzl",
    "extensions.bzl",
    "main_activity.kt.tpl",
    "webview_activity.kt.tpl",
    "manifest.xml.tpl",
])

# An app's Swift linked against Isomer's shared platform library
# (libisomer_platform.so: the Swift runtime, Foundation and Isomer), which
# the app ships beside it, rather than whole (@isomer_android//:defs.bzl's
# isomer_android_library; README, "One platform library for several apps").
bool_flag(
    name = "shared_platform",
    build_setting_default = False,
)

config_setting(
    name = "shared_platform_on",
    flag_values = {":shared_platform": "True"},
)

# An AAR's jni/<abi>/ with the NDK's libc++_shared.so in it beside the
# app's library, when that library needs it
# (--@isomer//swift_ffi/rules:libcxx=shared). Off by default: the host app
# supplies its own, the one its other C++ libraries use (@isomer_android//:defs.bzl's
# isomer_android_aar; README, "One C++ runtime with other libraries").
bool_flag(
    name = "aar_libcxx_shared",
    build_setting_default = False,
)

config_setting(
    name = "aar_libcxx_shared_on",
    flag_values = {
        ":aar_libcxx_shared": "True",
        "//swift_ffi/rules:libcxx": "shared",
    },
)

# isomer_android_aar's assembly (@isomer_android//:defs.bzl): the classes, the libraries, the
# manifest and the consumer rules zipped as an AAR.
sh_binary(
    name = "assemble_aar",
    srcs = ["assemble_aar.sh"],
)

# The Maven artifacts an app's own Kotlin compiles against are Isomer's
# set, @isomer//android/maven:androidx (or the app's, through that flag):
# not one artifact at a time, so an app's set replaces all of Isomer's.

