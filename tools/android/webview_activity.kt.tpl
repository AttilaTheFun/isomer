import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import dev.isomer.runtime.IsomerWebViewApp

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        val extras = intent.extras
        val environment = extras?.keySet().orEmpty()
            .filter { it.startsWith("ISO_") }
            .associateWith { extras?.get(it)?.toString() ?: "" }
        val pageQuery = listOfNotNull(intent.getStringExtra("reactorCache")?.let { "reactorCache" to it }).toMap()
