package {PACKAGE}

// GENERATED by isomer_android_app — the Level 4 ("your whole app is
// SwiftUI") Android entry point. The Swift `@main App` owns the UI; this
// activity hosts the chosen renderer and proxies the platform into SwiftUI:
// lifecycle -> @Environment(\.scenePhase), VIEW intents -> .onOpenURL,
// system back -> navigation pop / sheet dismissal, platformCommand ->
// window/status-bar configuration.

import android.content.Intent
import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.enableEdgeToEdge
import androidx.activity.compose.setContent
import dev.isomer.runtime.ComposeTreeState
import dev.isomer.runtime.ContentFrame
import dev.isomer.runtime.IsoTree
import dev.isomer.runtime.IsomerRuntime
import dev.isomer.runtime.IsomerView

class MainActivity : ComponentActivity() {
    override fun onConfigurationChanged(newConfig: android.content.res.Configuration) {
        super.onConfigurationChanged(newConfig)
        IsomerRuntime.setColorScheme(newConfig)
    }

    override fun dispatchTouchEvent(ev: android.view.MotionEvent): Boolean {
        dev.isomer.runtime.TapProbe.onTouch(this, ev)
        return super.dispatchTouchEvent(ev)
    }

    private var surface: IsomerView? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        // Launch hooks: the intent's ISO_ string extras are environment
        // variables (`am start … --es ISO_OPEN_APP todo`), as a native host's
        // process environment has them, set before any Swift reads them.
        intent.extras?.keySet()?.filter { it.startsWith("ISO_") }?.forEach { key ->
            intent.getStringExtra(key)?.let { android.system.Os.setenv(key, it, true) }
        }
        // Before any Swift runs (the services installer's included): the
        // app's directories where Foundation's FileManager finds them, and
        // Foundation's networking.
        IsomerRuntime.prepare(this)
        // The image chooser (the ImagePickerService platform service) needs
        // its activity-result launcher registered before the activity starts.
        dev.isomer.runtime.ImagePickerHost.attach(this)
        // SwiftUI's .fileImporter / .photosPicker / .cameraCapture.
        dev.isomer.runtime.MediaPickerHost.attach(this)
        // App-owned dependency injection (may be empty): installs the app's
        // services into the swift_ffi dependency dictionary before the
        // runtime starts.
        {INSTALL_SERVICES}
        IsomerRuntime.attach(this, embedded = false)
        // The launch's own choice (`--es renderer openGL`), else the app's
        // (an app that offers one keeps it in SharedPreferences "isomer",
        // "renderer", applied at the next launch), else the build's default.
        val renderer = intent.getStringExtra("renderer")
            ?: getSharedPreferences("isomer", MODE_PRIVATE).getString("renderer", null)
            ?: "{DEFAULT_RENDERER}"
        when (renderer) {
            "jetpackCompose" -> {
                // Edge to edge: the app's chrome takes the system bars' room
                // (a navigation bar's frost under the status bar, a composer on
                // the navigation bar or keyboard), as an iPhone app's does.
                enableEdgeToEdge()
                IsomerRuntime.startCompose(this, embedded = false)
                setContent { IsoTree() }
                // Uniform benchmark content signal: the first draw that
                // includes the decoded tree (the GL path logs
                // [gpu-first-frame] instead; see docs/benchmarks.md).
                ContentFrame.install(window.decorView) { ComposeTreeState.tree.value != null }
                dev.isomer.runtime.TapProbe.install(this)
            }
            else -> {
                surface = IsomerView(this).also { setContentView(it) }
            }
        }
        IsomerRuntime.openURL(intent?.data)
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        IsomerRuntime.openURL(intent.data)
    }

    override fun onResume() {
        super.onResume()
        surface?.onResume()
        IsomerRuntime.setScenePhase("active")
    }

    override fun onPause() {
        IsomerRuntime.setScenePhase("inactive")
        surface?.onPause()
        super.onPause()
    }

    override fun onStop() {
        IsomerRuntime.setScenePhase("background")
        super.onStop()
    }

    @Deprecated("Deprecated in Java")
    override fun onBackPressed() {
        // GL path: let the runtime pop navigation / dismiss a sheet first.
        // (The Compose path handles back via BackHandler inside IsoTree.)
        val view = surface
        if (view != null) {
            view.handleBack { @Suppress("DEPRECATION") super.onBackPressed() }
        } else {
            @Suppress("DEPRECATION") super.onBackPressed()
        }
    }
}
