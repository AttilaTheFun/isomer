<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by isomer_android_aar: an Isomer app as a library, for a host
     app to embed (README, "Embedding an Isomer app in an Android app"). The
     host's own manifest merges this one: its entry activity, and the
     permissions Foundation's URLSession needs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{PACKAGE}">

    <uses-sdk android:minSdkVersion="{MIN_SDK}" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- The app's entry: the host starts it with an explicit intent
             (Intent(context, {PACKAGE}.MainActivity::class.java)); not
             exported, no launcher entry of its own.{PROCESS_NOTE} -->
        <activity
            android:name="{PACKAGE}.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"{PROCESS_ATTR} />
    </application>
</manifest>
