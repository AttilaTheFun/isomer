load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

# The SDK link smoke test's driver (docs/hermetic_toolchains.md, "The SDKs'
# checks"): it sets tests/sdk_consumer's cell (isomer, Isomer's Swift SDKs,
# the NDK's API level), builds the consumer there, runs its WASI command
# under WasmKit and its APK on an emulator.
#   bazel run //tools/ci/sdk_smoke -- --help
swift_binary(
    name = "sdk_smoke",
    srcs = glob(["*.swift"]),
    module_name = "SDKSmoke",
    deps = ["@swift_argument_parser//:ArgumentParser"],
)
