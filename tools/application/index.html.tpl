<!doctype html>
<!-- GENERATED by isomer_application (tools/application/defs.bzl): the app's
     page on the web, its Swift as wasm drawn by the DOM renderer (or, with
     ?renderer=webGPU, the GPU renderer). An app with a page of its own
     (platform services injected, icons) passes it as `web_index`. -->
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{TITLE}</title>
  <style>
    :root { color-scheme: light dark; }
    /* Matches Color.windowBackground until the guest's first setColorScheme
       report takes over (which also honours in-app scheme overrides). */
    html, body { margin: 0; height: 100%; background: light-dark(#fff, rgb(18, 18, 20)); }
    #canvas { width: 100%; height: 100%; display: block; touch-action: none; }
    #error { font: 14px monospace; color: #b00; padding: 16px; white-space: pre-wrap; }
  </style>
</head>
<body>
  <canvas id="canvas"></canvas>
  <script type="module">
    import { boot } from "./runtime/boot.js";

    const params = new URLSearchParams(location.search);
    boot({
      canvas: document.getElementById("canvas"),
      wasmURL: "./app.wasm",
      rendererName: params.get("renderer") || "dom",
      // The app's files on the web are kept under its identity (the
      // origin's IndexedDB), and Bundle.main.bundleIdentifier is this.
      bundleIdentifier: "{BUNDLE_ID}",
    }).catch((error) => {
      console.error(error);
      const pre = document.createElement("pre");
      pre.id = "error";
      pre.textContent = String(error.stack || error);
      document.body.replaceChildren(pre);
    });
  </script>
</body>
</html>
