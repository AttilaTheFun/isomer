load("@rules_swift//swift:swift.bzl", "swift_binary")

# A module's ICU data, trimmed, as an object (defs.bzl's icu_data_library):
# run by every web app with the full Foundation.
swift_binary(
    name = "icu_data",
    package_name = "isomer",
    srcs = ["main.swift"],
    visibility = ["//visibility:public"],
    deps = ["//tools/wasm/tool_support"],
)
