load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# Runs a WASI command module (a compiler, a linker) under WAMR: arguments,
# environment, preopened directories, redirected stdout/stderr. The Android
# Playground compiles with it (swift-frontend.wasm + wasm-ld.wasm, the
# browser's toolchain, ahead-of-time compiled with `--define wamr_aot=1`).
cc_library(
    name = "wasi_command",
    srcs = ["wasi_command.c"],
    hdrs = ["wasi_command.h"],
    deps = ["//swift_ffi/runtime/wamr"],
)

# The same from a shell, for trying a module on a device:
#   bazel build --platforms=//tools/platforms:android_arm64 --define wamr_aot=1 //tools/wasm/wasi_command:iwasm
cc_binary(
    name = "iwasm",
    srcs = ["iwasm_main.c"],
    deps = [":wasi_command"],
)
