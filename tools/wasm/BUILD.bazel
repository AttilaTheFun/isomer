load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "serve.py",
    "site_imports_test.py",
])

# `-c opt`: the web app's reactor is shipped without its function names.
config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

# The exports a program linked from a wasm_sdk_bundle needs (its hosts'
# entries, from the archives' symbol indexes): written into the manifest.
py_binary(
    name = "sdk_exports",
    srcs = ["sdk_exports.py"],
    visibility = ["//visibility:public"],
)

# A module's ICU data, trimmed, as an object (defs.bzl's icu_data_library).
py_binary(
    name = "icu_data",
    srcs = ["icu_data.py"],
)

# The React 18 UMD runtime files, re-exported so CONSUMER workspaces (the
# Playground's web-run site) can bundle them without declaring the
# @react_umd repos themselves.
filegroup(
    name = "react_umd_js",
    srcs = ["@react_umd//:umd/react.production.min.js"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "react_dom_umd_js",
    srcs = ["@react_dom_umd//:umd/react-dom.production.min.js"],
    visibility = ["//visibility:public"],
)
