load(":defs.bzl", "wasm_toolchain_files")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

# `-c opt`: the web app's reactor is shipped without its function names.
config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

# The web build's tools, Swift since 0.54 (they were Python, and rules_python
# a dependency of every app on Isomer), each in a package of its own; their
# old names here kept for whoever names them:
#   sdk_exports         a wasm_sdk_bundle's manifest, its hosts' entries added
#   icu_data            a module's ICU data, trimmed, as an object
#   serve               the `bazel run` of a web app (web_server)
#   site_imports_check  site_imports_test's check
alias(
    name = "sdk_exports",
    actual = "//tools/wasm/sdk_exports",
)

alias(
    name = "icu_data",
    actual = "//tools/wasm/icu_data",
)

# The Swift and C toolchains' files for the platform a dependent builds for:
# wasm_sdk_bundle reaches it built for wasm32, for the Swift SDK's
# Foundation family (defs.bzl), and so does its check (sdk_bundle_test).
wasm_toolchain_files(
    name = "wasm_toolchain_files",
    tags = ["manual"],
)
