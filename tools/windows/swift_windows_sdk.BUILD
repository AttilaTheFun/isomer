# Generated by @isomer//tools/windows:defs.bzl's swift_windows_sdk_repository:
# Swift and C/C++ for Windows (arm64 and x64), built on Linux.
load("@rules_cc//cc/private/toolchain:windows_cc_toolchain_config.bzl", "cc_toolchain_config")
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_swift//swift/toolchains:swift_toolchain.bzl", "swift_toolchain")
load("@rules_swift//swift/toolchains:swift_tools.bzl", "swift_tools")

package(default_visibility = ["//visibility:public"])

_REPO = "{execroot_repo}"

_SDK = _REPO + "/swift-windows-sdk/Windows.platform/Developer/SDKs/Windows.sdk"

_MSVC = _REPO + "/winsysroot/VC/Tools/MSVC/{msvc}"

_KITS = _REPO + "/winsysroot/Windows Kits/10"

_ARCHS = {
    # Bazel's cpu: (Windows' name, rules_cc's cpu)
    "aarch64": ("arm64", "arm64_windows"),
    "x86_64": ("x64", "x64_windows"),
}

filegroup(
    name = "sdk_files",
    srcs = glob(["swift-windows-sdk/Windows.platform/**"]) + glob(["resource/**"]),
)

filegroup(
    name = "msvc_files",
    srcs = glob(["winsysroot/**"]),
)

# What an app needs beside its .exe: the Swift runtime's DLLs. An
# architecture's may be missing (6.4's arm64 installer carries arm64's
# alone): its group is then empty.
[
    filegroup(
        name = "runtime_" + cpu,
        srcs = glob(["swift-windows-sdk/runtime/" + cpu + "/*.dll"], allow_empty = True),
    )
    for cpu in _ARCHS
]

swift_tools(
    name = "tools",
    additional_inputs = [
        ":sdk_files",
        ":msvc_files",
        "@{toolchain_repo}//:swift_sdk_compiler_inputs",
    ],
    swift_autolink_extract = "@{toolchain_repo}//:usr/bin/swift-autolink-extract",
    swift_driver = "@{toolchain_repo}//:usr/bin/swiftc",
    swift_symbolgraph_extract = "@{toolchain_repo}//:usr/bin/swift-symbolgraph-extract",
)

[
    swift_toolchain(
        name = "swift_toolchain_" + cpu,
        arch = cpu,
        copts = [
            "-resource-dir",
            _REPO + "/resource",
            "-visualc-tools-root",
            _MSVC,
            "-windows-sdk-root",
            _KITS,
            "-windows-sdk-version",
            "{sdk_version}",
        ],
        # rules_swift puts XCTest's DLLs on a Windows test's Path, which it
        # takes from here (a host's; on Linux nothing reads it).
        env = {"Path": "/usr/bin:/bin"},
        features = [
            "swift.module_map_no_private_headers",
            # No -add_ast_path: a Darwin linker's, which lld-link ignores with a warning.
            "swift.no_embed_debug_module",
        ],
        linker_inputs = [
            ":sdk_files",
            ":msvc_files",
        ],
        os = "windows",
        parsed_version = "{swift_version}",
        sdkroot = _SDK,
        swift_tools = ":tools",
        version_file = ".swift-version",
        xctest_version = "{swift_version}",
    )
    for cpu in _ARCHS
]

filegroup(
    name = "cc_files",
    srcs = [
        "bin/clang-cl",
        "bin/lld-link",
        "bin/llvm-lib",
        ":msvc_files",
        # Swift's runtime objects and import libraries, which the link of an
        # app with Swift in it names (rules_swift's -LIBPATH and swiftrt.obj).
        ":sdk_files",
        "@{toolchain_repo}//:swift_sdk_linker_inputs",
    ],
)

[
    cc_toolchain_config(
        name = "cc_config_" + cpu,
        abi_libc_version = "local",
        abi_version = "local",
        archiver_flags = ["/MACHINE:" + machine.upper()],
        compiler = "clang-cl",
        cpu = bazel_cpu,
        cxx_builtin_include_directories = [
            _MSVC + "/include",
            _KITS + "/Include/{sdk_version}/ucrt",
            _KITS + "/Include/{sdk_version}/um",
            _KITS + "/Include/{sdk_version}/shared",
            _KITS + "/Include/{sdk_version}/winrt",
            "{toolchain_root}/lib/clang",
        ],
        dbg_mode_debug_flag = "/DEBUG:FULL",
        default_compile_flags = ["--target=" + cpu + "-pc-windows-msvc"],
        default_link_flags = ["/MACHINE:" + machine.upper()],
        fastbuild_mode_debug_flag = "/DEBUG:FASTLINK",
        host_system_name = "local",
        msvc_cl_path = "bin/clang-cl",
        msvc_env_include = ";".join([
            _MSVC + "/include",
            _KITS + "/Include/{sdk_version}/ucrt",
            _KITS + "/Include/{sdk_version}/um",
            _KITS + "/Include/{sdk_version}/shared",
            _KITS + "/Include/{sdk_version}/winrt",
        ]),
        msvc_env_lib = ";".join([
            _MSVC + "/lib/" + machine,
            _KITS + "/Lib/{sdk_version}/ucrt/" + machine,
            _KITS + "/Lib/{sdk_version}/um/" + machine,
        ]),
        msvc_env_path = "/usr/bin:/bin",
        msvc_env_tmp = "/tmp",
        msvc_lib_path = "bin/llvm-lib",
        msvc_link_path = "bin/lld-link",
        msvc_ml_path = "bin/clang-cl",
        supports_parse_showincludes = False,
        target_libc = "ucrt",
        target_system_name = cpu + "-unknown-windows-msvc",
        tool_paths = {
            "ar": "bin/llvm-lib",
            "cpp": "bin/clang-cl",
            "gcc": "bin/clang-cl",
            "gcov": "/bin/false",
            "ld": "bin/lld-link",
            "ml": "bin/clang-cl",
            "nm": "/bin/false",
            "objcopy": "/bin/false",
            "objdump": "/bin/false",
            "strip": "/bin/false",
        },
        toolchain_identifier = "clang_cl_linux_" + cpu,
    )
    for cpu, (machine, bazel_cpu) in _ARCHS.items()
]

[
    cc_toolchain(
        name = "cc_" + cpu,
        all_files = ":cc_files",
        ar_files = ":cc_files",
        compiler_files = ":cc_files",
        dwp_files = ":cc_files",
        linker_files = ":cc_files",
        objcopy_files = ":cc_files",
        strip_files = ":cc_files",
        supports_param_files = 1,
        toolchain_config = ":cc_config_" + cpu,
    )
    for cpu in _ARCHS
]

[
    toolchain(
        name = "swift_toolchain_windows_" + cpu,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:{exec_cpu}",
        ],
        target_compatible_with = [
            "@platforms//os:windows",
            "@platforms//cpu:" + cpu,
        ],
        toolchain = ":swift_toolchain_" + cpu,
        toolchain_type = "@rules_swift//toolchains:toolchain_type",
    )
    for cpu in _ARCHS
]

[
    toolchain(
        name = "cc_toolchain_windows_" + cpu,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:{exec_cpu}",
        ],
        target_compatible_with = [
            "@platforms//os:windows",
            "@platforms//cpu:" + cpu,
        ],
        toolchain = ":cc_" + cpu,
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    )
    for cpu in _ARCHS
]
