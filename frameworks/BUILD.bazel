# The other Apple frameworks SwiftUI's interface names, for the platforms
# without Apple's (docs/isomer_031_plan.md): CoreTransferable,
# UniformTypeIdentifiers and PhotosUI under Apple's names, and Combine
# (since 0.42, beneath Foundation: code from before Observation compiles
# unchanged). Each platform's SwiftUI depends on them; its PhotosUI (over
# that SwiftUI) is built beside it. Not UIKit or Dispatch; Isomer's own apps
# use Observation and Swift concurrency.

load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")

# What a module compiled from Isomer's SwiftUI core depends on (the core's
# Frameworks.swift imports these): on Apple platforms (Isomer's core hosted
# there: the Apple GPU path, the tests) the Apple-named ones are Apple's own.
swift_library_group(
    name = "for_core",
    visibility = ["//visibility:public"],
    deps = select({
        "@platforms//os:macos": [],
        "@platforms//os:ios": [],
        "@platforms//os:tvos": [],
        "@platforms//os:watchos": [],
        "@platforms//os:visionos": [],
        "//conditions:default": [
            # The Swift SDK's on wasm and Android (nothing to link); on Linux
            # and Windows Isomer's, beside the toolchain's Foundation
            # (core_graphics/BUILD.bazel).
            "//:core_graphics",
            "//frameworks/core_transferable",
            "//frameworks/uniform_type_identifiers",
        ],
    }) + select({
        # Combine: on wasm and Android the Swift SDK's (Isomer's Foundation
        # re-exports it); on Linux and Windows the toolchain's Foundation has
        # none, so Isomer's.
        "@platforms//os:linux": ["//frameworks/combine"],
        "@platforms//os:windows": ["//frameworks/combine"],
        "//conditions:default": [],
    }),
)
