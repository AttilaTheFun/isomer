load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift.bzl", "swift_binary")
load("//tools/platforms:transition.bzl", "transition_binary")

swift_binary(
    name = "os_log_check",
    package_name = "isomer",
    srcs = [
        "OSCheck.swift",
        "OSLogCheck.swift",
    ],
    deps = [
        "//frameworks/os_log",
        "//frameworks/os_log/os",
    ],
    tags = ["manual"],
)

transition_binary(
    name = "os_log_check_wasm",
    binary = ":os_log_check",
    platform = "//tools/platforms:wasm32",
)

# The messages as written, formats applied (privacy accepted, not acted on).
sh_test(
    name = "os_log_test",
    size = "small",
    srcs = ["os_log_test.sh"],
    args = [
        "$(rootpath //tools/wasm/wasi_run)",
        "$(rootpath :os_log_check_wasm)",
    ],
    data = [
        ":os_log_check_wasm",
        "//tools/wasm/wasi_run",
    ],
)

# Built for Android too (logcat through liblog): linked, not run here.
transition_binary(
    name = "os_log_check_android",
    binary = ":os_log_check",
    platform = "//tools/platforms:android_arm64",
)
