load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift.bzl", "swift_binary")
load("//tools/platforms:transition.bzl", "transition_binary")

# Isomer's Combine, built for wasm and run in headless Chrome
# (//tools/wasm/wasi_run_browser; CombineCheck.swift says what it covers). Combine alone: no
# Foundation, as Combine sits beneath it.
swift_binary(
    name = "combine_check",
    package_name = "isomer",
    srcs = ["CombineCheck.swift"],
    module_name = "CombineCheck",
    deps = ["//frameworks/combine"],
    tags = ["manual"],
)

transition_binary(
    name = "combine_check_wasm",
    binary = ":combine_check",
    platform = "//tools/platforms:wasm32",
)

# Foundation's runner: fails on any "FAIL" line or a missing "ok".
sh_test(
    name = "combine_test",
    size = "small",
    srcs = ["//foundation/tests:run_foundation_check.sh"],
    args = [
        "$(rootpath //tools/wasm/wasi_run_browser)",
        "$(rootpath :combine_check_wasm)",
    ],
    data = [
        ":combine_check_wasm",
        "//tools/wasm/wasi_run_browser",
    ],
)

# A link check on Android.
transition_binary(
    name = "combine_check_android",
    binary = ":combine_check",
    platform = "//tools/platforms:android_arm64",
    tags = ["manual"],
)
