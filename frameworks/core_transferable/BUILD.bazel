load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# The sources, for a feature compiled against Isomer's frameworks on an Apple
# platform (//apple/libraries/compiled_swift_ui:core_transferable).
filegroup(
    name = "srcs",
    srcs = glob(["*.swift"]),
)

# CoreTransferable's Transferable, as SwiftUI's pickers and drops take it.
one_configuration(
    name = "core_transferable",
    actual = "@swiftpkg_isomer//:CoreTransferable",
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "@platforms//os:ios": ["@platforms//:incompatible"],
        "@platforms//os:tvos": ["@platforms//:incompatible"],
        "@platforms//os:watchos": ["@platforms//:incompatible"],
        "@platforms//os:visionos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
