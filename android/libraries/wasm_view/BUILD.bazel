load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//swift_ffi/rules:kt_swift_library.bzl", "kt_swift_library")

package(default_visibility = ["//visibility:public"])

# The engine: WasmKit under the shared feature runtime, as a Swift library
# of its own (libwasm_engine_bindings.so) with a generated Kotlin bridge
# (WasmEngineBridge, :wasm_engine_bindings) whose `wasmKit*` functions
# kotlin/.../WasmKitRuntime.kt calls. An app that runs reactors depends on
# both (the Kotlin bindings, and :engine_native for the .so). A process runs
# reactors or the app's compiled Swift, not both: each library carries its
# own Swift runtime and libdispatch (the Playground's builds run in a process
# of their own).
swift_library(
    name = "engine",
    package_name = "isomer",
    srcs = ["engine/WasmKitEngine.swift"],
    copts = [
        # @_extern for libdispatch's main-queue hooks.
        "-enable-experimental-feature",
        "Extern",
    ],
    module_name = "WasmEngine",
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "//shared/wasm_host",
        "//shared/wasm_host:wasmkit_runtime",
        "//swift_ffi/runtime/swift_wasm_host",
        "//swift_ffi/swift_ffi",
    ],
)

kt_swift_library(
    name = "wasm_engine_bindings",
    java_package = "dev.isomer.runtime",
    swift = ":engine",
    tags = ["manual"],
)

cc_library(
    name = "engine_native",
    srcs = [":libwasm_engine_bindings.so"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:android"],
)

filegroup(
    name = "runtime_kotlin",
    srcs = glob(["kotlin/**/*.kt"], allow_empty = True),
)

# The engine's Kotlin alone (WasmKitRuntime over the generated bridge): for
# an app that drives a reactor without WasmView.

filegroup(
    name = "engine_kotlin",
    srcs = [
        "kotlin/dev/isomer/runtime/WasmEngine.kt",
        "kotlin/dev/isomer/runtime/WasmKitRuntime.kt",
    ],
)
