load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The engine: WasmKit under the shared feature runtime, as a Swift library
# of its own (libwasm_engine_bindings.so) with a generated Kotlin bridge
# (WasmEngineBridge, @isomer_android//wasm_view:wasm_engine_bindings) whose
# `wasmKit*` functions kotlin/.../WasmKitRuntime.kt calls. An app that runs
# reactors depends on both (the Kotlin bindings, and
# @isomer_android//wasm_view:engine_native for the .so): the isomer_android
# module's, as they load rules_kotlin (docs/platform_modules.md). A compiled
# app binds it in its own library instead (`isomer_android_app(wasm_view =
# True)`, kt_swift_library's `bound_libraries`), sharing that library's Swift
# runtime and libdispatch: two libraries of Swift in one process would each
# carry their own.
swift_library(
    name = "engine",
    package_name = "isomer",
    srcs = ["engine/WasmKitEngine.swift"],
    copts = [
        # @_extern for libdispatch's main-queue hooks.
        "-enable-experimental-feature",
        "Extern",
    ],
    module_name = "WasmEngine",
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "//shared/wasm_host",
        "//shared/wasm_host:wasmkit_runtime",
        "//swift_ffi/runtime/swift_wasm_host",
        "//swift_ffi/swift_ffi",
    ],
)

filegroup(
    name = "runtime_kotlin",
    srcs = glob(["kotlin/**/*.kt"], allow_empty = True),
)

# The engine's Kotlin alone (WasmKitRuntime over the generated bridge): for
# an app that drives a reactor without WasmView.

filegroup(
    name = "engine_kotlin",
    srcs = [
        "kotlin/dev/isomer/runtime/WasmEngine.kt",
        "kotlin/dev/isomer/runtime/WasmKitRuntime.kt",
    ],
)
