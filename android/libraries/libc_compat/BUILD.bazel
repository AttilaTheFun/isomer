load("@rules_cc//cc:cc_library.bzl", "cc_library")

# What the Swift Android SDK's prebuilt libraries (built at API 28) need of
# bionic that an older API level lacks, for an app below API 28 (README,
# "Android below API 28"): linked into every Android Swift binary of
# Isomer's; each file is empty at the API level that has its functions.
cc_library(
    name = "libc_compat",
    srcs = [
        "fortify.c",
        "strto_l.c",
    ],
    alwayslink = True,
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
)
