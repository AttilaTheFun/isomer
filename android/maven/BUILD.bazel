package(default_visibility = ["//visibility:public"])

# The Maven artifacts Isomer's Android runtime compiles and links against,
# behind flags (docs/android_maven.md). By default Isomer's own set, the
# isomer_android_maven module's (android/maven_module, pinned by its lock
# file), through @isomer_android_maven_set (extensions.bzl here): a build
# without that module that uses the defaults fails there, saying what to do.
# An app with AndroidX of its own points the flags at its own instead, so
# one copy of AndroidX goes into its APK and Isomer's Maven is never
# evaluated:
#
#   build --@isomer//android/maven:androidx=//third_party:androidx_for_isomer
#   build --@isomer//android/maven:compose_compiler=@maven//:org_jetbrains_kotlin_kotlin_compose_compiler_plugin_embeddable
#
# The whole set is one flag: artifacts of one Maven repository depend on
# each other, so a set mixed from two repositories would carry two copies
# of what they share. A flag's default is not a dependency of anything
# unless the flag is left at it, so an app that sets both never loads
# @isomer_android_maven_set either.
label_flag(
    name = "androidx",
    build_setting_default = "@isomer_android_maven_set//:androidx",
)

# The Compose compiler plugin: the one matching the app's kotlinc (its
# rules_kotlin's), which an app on another Kotlin release gives here.
label_flag(
    name = "compose_compiler",
    build_setting_default = "@isomer_android_maven_set//:compose_compiler",
)
