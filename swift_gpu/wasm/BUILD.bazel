load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The SwiftGPU module for the web: the shared API plus the Metal backend's
# device (swift_gpu/metal) over Isomer's Metal, whose executor runs it on
# the browser's WebGPU, with a canvas surface (MetalWebSurface).
swift_library(
    name = "swift_gpu",
    srcs = [
        "MetalWebSurface.swift",
        "//swift_gpu/core:srcs",
        "//swift_gpu/metal:srcs",
    ],
    module_name = "SwiftGPU",
    deps = [
        "//metal/metal",
        "//metal/web",
    ],
)
