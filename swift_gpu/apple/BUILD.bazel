load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# For consumers' single-module binary distributions (apple_xcframework
# forbids transitive swift_library deps): compile these together with the
# consumer's sources — their `import SwiftGPU` lines are canImport-guarded.
filegroup(
    name = "srcs",
    srcs = [
        "MetalSurface.swift",
        "//swift_gpu/metal:srcs",
    ],
)

# The SwiftGPU module for Apple platforms: the shared API plus the Metal
# backend (the portable device, the on-screen MTKView surface, offscreen
# render-to-bytes).
swift_library(
    name = "swift_gpu",
    srcs = [
        "MetalSurface.swift",
        "//swift_gpu/core:srcs",
        "//swift_gpu/metal:srcs",
    ],
    module_name = "SwiftGPU",
)
