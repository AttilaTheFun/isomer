load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Marks the repository root as a Bazel package. rules_jvm_external reads the
# Maven lock file via its label (`//:rules_android_maven_install.json`, isomer's
# own builds and the examples'; see MODULE.bazel), which requires the root to
# be a loadable package. (Isomer's AndroidX lock file is android/maven_module's.)

# The reimplementation's `SwiftUI` module for the current platform — ONE
# label a SwiftPM package's generated target (rules_swift_package_manager
# `target_deps`) can depend on: the per-platform SDK group (SwiftUI and the
# Isomer module) on wasm, Linux, Windows and Android; nothing on Apple, where
# the system SwiftUI is implicit.
alias(
    name = "swift_ui",
    actual = select({
        # The headless host on the building machine (--@isomer//headless).
        "//headless:on": "//headless/libraries/swift_ui:sdk",
        # A feature compiled into an Apple app against Isomer's frameworks
        # (apple/compiled): Isomer's SwiftUI on Apple platforms too.
        "//apple/compiled:feature_on": "//apple/libraries/compiled_swift_ui:sdk",
        "@platforms//os:wasi": "//wasm/libraries/swift_ui:sdk",
        "@platforms//os:linux": "//linux/libraries/swift_ui:sdk",
        "@platforms//os:windows": "//windows/libraries/swift_ui:sdk",
        "@platforms//os:android": "//android/libraries/swift_ui:sdk",
        "//conditions:default": ":system_swift_ui",
    }),
    visibility = ["//visibility:public"],
)

# The Isomer module for the current platform: Isomer's additions over
# Apple's frameworks (docs/isomer_031_plan.md), on Apple platforms too.
alias(
    name = "isomer",
    actual = select({
        "//headless:on": "//headless/libraries/swift_ui:isomer",
        "//apple/compiled:feature_on": "//apple/libraries/compiled_swift_ui:isomer",
        "@platforms//os:wasi": "//wasm/libraries/swift_ui:isomer",
        "@platforms//os:linux": "//linux/libraries/swift_ui:isomer",
        "@platforms//os:windows": "//windows/libraries/swift_ui:isomer",
        "@platforms//os:android": "//android/libraries/swift_ui:isomer",
        "//conditions:default": "//apple/libraries/swift_ui:isomer",
    }),
    visibility = ["//visibility:public"],
)

# Where `import Foundation` and `import CoreGraphics` come from: the Swift
# SDK's, so nothing to link. Apple's on Apple platforms; Isomer's on Android
# and the web, whose Swift SDKs (Isomer's, since 0.56: README, "Upgrading
# isomer") carry Isomer's Foundation; on Linux and Windows still the
# toolchain's corelibs Foundation (with Isomer's CoreGraphics beside it,
# :core_graphics). No library needs to depend on this any more: it stays, an
# empty dependency, for the BUILD files and `target_deps` that name it, and
# on Android and the web it carries the check that
# --@isomer//foundation:internationalization's SDK is the -i18n one
# (foundation/BUILD.bazel).
alias(
    name = "foundation",
    actual = select({
        # A compiled feature (apple/compiled): Apple's Foundation with
        # Isomer's Observation and Synchronization.
        "//apple/compiled:feature_on": "//apple/libraries/compiled_swift_ui:foundation",
        "@platforms//os:wasi": "//foundation:from_sdk",
        "@platforms//os:android": "//foundation:from_sdk",
        "//conditions:default": ":system_framework",
    }),
    visibility = ["//visibility:public"],
)

# What a host installs beneath Isomer's Foundation (URLSession's transports,
# UserDefaults' store): IsomerFoundation, a module of Isomer's Swift SDKs on
# Android and the web (since 0.56), so nothing to link; nothing on other
# platforms, where it has no place (code that builds for both guards with
# `#if canImport(IsomerFoundation)`). An empty dependency, for the BUILD
# files that name it.
alias(
    name = "isomer_foundation",
    actual = ":system_framework",
    visibility = ["//visibility:public"],
)

# OSLog's Logger: Apple's on Apple platforms (nothing to link), Isomer's
# elsewhere (frameworks/os_log): to logcat on Android, standard error
# beyond. Both modules, OSLog and `os` (which re-exports it, as Apple's
# does). Also in each platform's SDK group (@isomer//:swift_ui).
alias(
    name = "os_log",
    actual = select({
        "@platforms//os:macos": ":system_framework",
        "@platforms//os:ios": ":system_framework",
        "@platforms//os:tvos": ":system_framework",
        "@platforms//os:watchos": ":system_framework",
        "@platforms//os:visionos": ":system_framework",
        "//conditions:default": "//frameworks/os_log:os_log_and_os",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "core_graphics",
    actual = select({
        # Apple's on Apple platforms, the Swift SDK's on Android and the web
        # (Isomer's SDKs carry Isomer's CoreGraphics): nothing to link. On
        # Linux and Windows Isomer's, built here, beside the toolchain's
        # Foundation there: what it lacks
        # (CGAffineTransform, CGPath, CGColor...; core_graphics/BUILD.bazel).
        "@platforms//os:linux": "//core_graphics:for_dependents",
        "@platforms//os:windows": "//core_graphics:for_dependents",
        "//conditions:default": ":system_framework",
    }),
    visibility = ["//visibility:public"],
)

# Apple: a system framework (an empty dependency).
cc_library(
    name = "system_framework",
    visibility = ["//visibility:public"],
)

# Apple: the system SwiftUI (an empty dependency).
cc_library(
    name = "system_swift_ui",
    visibility = ["//visibility:public"],
)

# How a whole app's Swift runs (docs/modes.md, "The setting"):
# `--@isomer//:mode=compiled|webview|remote`, read by isomer_application
# (tools/application/defs.bzl), whose platform targets build the mode it
# names:
#
#   compiled  the app's Swift compiled into each platform's app (the default:
#             what isomer_android_app, isomer_web_app and rules_apple's
#             applications build)
#   webview   the app's Swift as wasm, in a web view the app keeps out of
#             sight, drawn by a head over the session protocol (the iPhone
#             and the Mac; Android's WebView transport isn't built yet)
#   remote    the app elsewhere (built headless, serving itself), the app
#             only a head over its session
#
# The web is wasm in every mode. A mode is a whole build's: every app the
# build makes takes it.
string_flag(
    name = "mode",
    build_setting_default = "compiled",
    values = [
        "compiled",
        "remote",
        "webview",
    ],
    visibility = ["//visibility:public"],
)

[
    config_setting(
        name = "mode_" + mode,
        flag_values = {":mode": mode},
        visibility = ["//visibility:public"],
    )
    for mode in [
        "compiled",
        "remote",
        "webview",
    ]
]

# Isomer's modules built resilient (docs/library_evolution.md):
# `--@isomer//:library_evolution` compiles every module of Isomer's that an
# Android or web app links with `-enable-library-evolution`, so that a
# library of the app's own built with library evolution (rules_swift's
# `library_evolution = True`, `swift.enable_library_evolution`) imports
# Foundation, SwiftUI, os and the rest without "module 'SwiftUI' was not
# compiled with library evolution support": a warning, or an error for a
# library built for distribution (Swift 6's InternalImportsByDefault and
# `-library-level api`), which no diagnostic group names. Off by default:
# it makes the app's library about 2.7% larger and its build slower, for a
# guarantee nothing off Apple uses (Isomer's modules are linked into each
# app, never swapped beneath it); the Storybook's frames on Android were
# the same either way (the doc's measurements). Two halves carry it, both
# in tools/library_evolution/defs.bzl: the Bazel modules' copts select on
# `:library_evolution_on`, and the Swift package's modules (Foundation,
# SwiftUI, ..., built under `one_configuration`) take it through
# rules_swift's per-module copts, which one_configuration's transition sets.
bool_flag(
    name = "library_evolution",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "library_evolution_on",
    flag_values = {":library_evolution": "true"},
    visibility = ["//visibility:public"],
)
