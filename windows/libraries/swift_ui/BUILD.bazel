load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//swift_ui_macros:defs.bzl", "SWIFT_UI_MACROS_PLUGINS")

package(default_visibility = ["//visibility:public"])

# Native Windows host + Direct2D/DirectWrite/WIC renderer. Exposes a flat C API
# (renderer.h) that the Swift host bridge calls; built with the MSVC C++
# toolchain when the app target transitions to //tools/platforms:windows_x86_64.
cc_library(
    name = "renderer",
    srcs = ["renderer.cpp"],
    hdrs = ["renderer.h"],
    linkopts = [
        "d2d1.lib",
        "dxguid.lib",  # CLSID_D2D1Shadow and other D2D effect GUIDs
        "dwrite.lib",
        "windowscodecs.lib",
        "ole32.lib",
        "oleaut32.lib",  # SysAllocString / VariantInit (WebView navigation)
        "uuid.lib",  # CLSID_WebBrowser, IID_IWebBrowser2 and OLE site IIDs
        "advapi32.lib",  # registry (FEATURE_BROWSER_EMULATION for the WebView)
        "comctl32.lib",  # SysDateTimePick32 (DatePicker) + common-control init
        "user32.lib",
        "gdi32.lib",
        "shell32.lib",
        "winhttp.lib",
        "dbghelp.lib",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)

# The bridging header is imported so the Swift host can call the C renderer API.
# `-disable-bridging-pch` parses the header directly instead of precompiling it;
# the bridging-header PCH otherwise embeds an absolute module-cache path that the
# worker can invalidate between actions on Windows ("precompiled file ... was
# compiled with module cache path ...").
_WINDOWS_COPTS = [
    "-import-objc-header",
    "$(location renderer.h)",
    "-disable-bridging-pch",
]

# The SwiftUI reimplementation for Windows: the shared core plus the Direct2D
# host bridge, compiled as a module named `SwiftUI` (see the wasm/Android
# counterparts) so application code can `import SwiftUI` unchanged.

swift_library(
    name = "core",
    package_name = "isomer",
    srcs = [
        "//shared/renderers:srcs",
        "//shared/swift_ui_core:srcs",
        # FileDocument's FileWrapper, which the toolchain's Foundation lacks.
        "//foundation:FileWrapper.swift",
    ],
    module_name = "SwiftUI",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//windows/libraries/image_io",
        "//shared/isomer_swift_ui",
        "@flatbuffers//swift",
        # Lights up canImport(SwiftGPU): the shared SwiftGPURenderer becomes
        # the self-drawing renderer, drawing through swift_gpu's D3D11 backend.
        "//swift_gpu/windows:swift_gpu",
        "//frameworks:for_core",
    ] + [
        # `Map` engine injection point: defaults to an empty stub; a consumer
        # with its own swift_map dep points the flag at the real engine to
        # light up canImport(SwiftMap). See //shared/BUILD.bazel.
        "//shared:map_engine_windows",
    ],
    plugins = SWIFT_UI_MACROS_PLUGINS,
)

# Windows' host (WindowsHost.swift, over the C++ renderer's window): a module
# of its own over the SwiftUI above, reaching the runtime's `package`
# plumbing as a module of Isomer's package. It defines
# `iso_process_host_run` (shared/swift_ui_core/App.swift); the wasm cell
# (//windows/libraries/swift_ui_wasm) runs its window through it too.
swift_library(
    name = "host",
    package_name = "isomer",
    srcs = ["WindowsHost.swift"],
    alwayslink = True,
    copts = _WINDOWS_COPTS,
    module_name = "IsomerWindowsHost",
    swiftc_inputs = ["renderer.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":core",
        ":renderer",
        "//windows/libraries/image_io",
        "//shared/isomer_swift_ui",
        "//swift_gpu/windows:swift_gpu",
        "//shared:map_engine_windows",
        "@flatbuffers//swift",
    ],
)

# SwiftUI with Windows' host: what Windows' apps and the modules over SwiftUI
# here depend on.
swift_library_group(
    name = "swift_ui",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":core",
        ":host",
    ],
)

# The wasm delivery cell (//windows/libraries/swift_ui_wasm) builds
# `WindowsWasmHost.swift` over this package's SwiftUI and host, calling the
# C++ renderer too.
exports_files([
    "WindowsWasmHost.swift",
    "renderer.h",
])

# Core native-bridging API (logging, clock, URLs), Windows implementation.
# What Isomer provides beyond Apple's SwiftUI API (see
# //shared/swift_ui_extensions).
swift_library(
    name = "isomer",
    package_name = "isomer",
    srcs = [
        "IsomerBridge.swift",
        "//shared/isomer:Exports.swift",
        "//shared/swift_ui_extensions:srcs",
    ],
    copts = _WINDOWS_COPTS,
    module_name = "Isomer",
    swiftc_inputs = ["renderer.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":host",
        ":renderer",
        ":swift_ui",
        "//swift_ffi/swift_ffi",
        "//shared/isomer_swift_ui",
    ],
)

# PhotosUI's SwiftUI photo picker, over this SwiftUI (//frameworks), as on
# the web and Android. Its picker is a request to the host, which this
# self-drawing renderer doesn't run yet: here it picks nothing, as
# `fileImporter` doesn't.
swift_library(
    name = "photos_ui",
    package_name = "isomer",
    srcs = ["//frameworks/photos_ui:srcs"],
    copts = _WINDOWS_COPTS,
    module_name = "PhotosUI",
    swiftc_inputs = ["renderer.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":swift_ui",
        "//frameworks/core_transferable",
        "//frameworks/uniform_type_identifiers",
    ],
)

# What an application builds against (@isomer//:swift_ui): SwiftUI, the
# other Apple frameworks it may import beside it (PhotosUI,
# UniformTypeIdentifiers), and the Isomer module (Isomer's additions: `#if
# canImport(Isomer) import Isomer` in code that also builds against Apple's
# frameworks), as on the web and Android. A Swift package configured over @isomer//:swift_ui sees both.
swift_library_group(
    name = "sdk",
    deps = [
        ":isomer",
        ":photos_ui",
        ":swift_ui",
        "//frameworks/uniform_type_identifiers",
        "//windows/libraries/image_io",
    ],
)
