load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The native Windows **wasm delivery cell** (IsomerWindowsWasmCell):
# `WindowsWasmHost.swift` and the engine (WasmKit, under the shared feature
# runtime) over //windows/libraries/swift_ui's SwiftUI and host, so the wasm
# example .exe can drive an `example_full.wasm` reactor and draw its decoded
# tree through the same SwiftGPU/D3D11 renderer. The compiled `swift_ui` never
# links an interpreter.
_WINDOWS_COPTS = [
    "-import-objc-header",
    "$(location //windows/libraries/swift_ui:renderer.h)",
    "-disable-bridging-pch",
]

swift_library(
    name = "swift_ui_wasm",
    package_name = "isomer",
    srcs = [
        "//windows/libraries/swift_ui:WindowsWasmHost.swift",
    ],
    copts = _WINDOWS_COPTS,
    module_name = "IsomerWindowsWasmCell",
    swiftc_inputs = ["//windows/libraries/swift_ui:renderer.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//windows/libraries/swift_ui:core",
        "//windows/libraries/swift_ui:host",
        "//windows/libraries/image_io",
        "//shared/isomer_swift_ui",
        "//frameworks:for_core",
        "//windows/libraries/swift_ui:renderer",
        # The engine: WasmKit under the shared feature runtime.
        "//shared/wasm_host",
        "//shared/wasm_host:wasmkit_runtime",
        # Foundation's networking for the reactor (URLSession over
        # FoundationNetworking), beneath the host's own dependencies.
        "//shared/isomer_network_host/urlsession",
        "//swift_ffi/runtime/swift_wasm_host",
        "@flatbuffers//swift",
        "//swift_gpu/windows:swift_gpu",
    ] + [
        # `Map` engine injection point: defaults to an empty stub; a consumer
        # with its own swift_map dep points the flag at the real engine to
        # light up canImport(SwiftMap). See //shared/BUILD.bazel.
        "//shared:map_engine_windows",
    ],
)

# IsomerDesktopWasmHost: the cell's public entry (WindowsWasmApp) for a host program,
# over the cell above, whose loop is package.
swift_library(
    name = "host",
    package_name = "isomer",
    srcs = ["WindowsWasmApp.swift"],
    module_name = "IsomerDesktopWasmHost",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":swift_ui_wasm",
        "//shared/platform_services:native_dependencies",
        "//swift_ffi/runtime/swift_wasm_host",
    ],
)
