load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# --@isomer//drive:headful (--config=cli): apps built with it carry a driver
# they dial out to be driven by (ISO_DRIVER; docs/drive_plan.md); an app on
# Apple's SwiftUI launched without ISO_DRIVER listens for the iso CLI instead
# (ws://127.0.0.1:7700). Off by default, and never in a release: an app with
# it obeys whoever its launch names (an Android intent's extras become its
# environment) or reaches it.
bool_flag(
    name = "headful",
    build_setting_default = False,
)

config_setting(
    name = "headful_on",
    flag_values = {":headful": "True"},
)

# What a host links for `iso_drive_attach`: the driver, or nothing.
alias(
    name = "headful_driver",
    actual = select({
        ":headful_on": "//drive/headful",
        "//conditions:default": "//drive/headful:none",
    }),
)

# What an app on Apple's SwiftUI links (@isomer//apple/libraries/swift_ui):
# the accessibility driver, or nothing.
alias(
    name = "headful_apple_driver",
    actual = select({
        ":headful_on": "//drive/apple",
        "//conditions:default": "//drive/apple:none",
    }),
)
