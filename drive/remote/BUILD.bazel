load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# IsomerRemote (isomer's Swift package, Package.swift; docs/drive_plan.md): A client by URL (grpc, grpcs, ws, unix, exec).
one_configuration(
    name = "remote",
    actual = "@swiftpkg_isomer//:IsomerRemote",
)

# The same, in the configuration of a build whose SwiftUI isn't the package's
# (Apple's tree renderer beside Apple's SwiftUI:
# //shared/isomer_swift_ui:beside_own_swift_ui), so SwiftProtobuf is built
# once there (apple/libraries/remote_head).
one_configuration(
    name = "beside_own_swift_ui",
    actual = "@swiftpkg_isomer//:IsomerRemote",
    configuration = "own_swift_ui",
)
