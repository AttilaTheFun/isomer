load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The headful driver (HeadfulDriver.swift): an app dialling out to be driven
# (ISO_DRIVER), linked into the web's and Android's hosts with
# --@isomer//drive:headful (//drive:headful_driver picks it).
swift_library(
    name = "headful",
    package_name = "isomer",
    srcs = ["HeadfulDriver.swift"],
    alwayslink = True,
    module_name = "IsomerHeadfulDriver",
    deps = [
        "//:foundation",
        "//drive/driver",
        "//drive/serving",
    ],
)

# Its absence: `iso_drive_attach` a no-op.
swift_library(
    name = "none",
    srcs = ["NoDriver.swift"],
    alwayslink = True,
    module_name = "IsomerNoDriver",
)
