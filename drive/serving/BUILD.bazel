load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# IsomerServing (isomer's Swift package, Package.swift; docs/drive_plan.md): The services apart from any transport: the IsomerServer protocol, its calls and tokens, the in-process connection, the URLSession WebSocket client.
one_configuration(
    name = "serving",
    actual = "@swiftpkg_isomer//:IsomerServing",
)

# The same, in the configuration of a build whose SwiftUI isn't the package's
# (Apple's tree renderer beside Apple's SwiftUI:
# //shared/isomer_swift_ui:beside_own_swift_ui), so SwiftProtobuf is built
# once there (apple/libraries/remote_head).
one_configuration(
    name = "beside_own_swift_ui",
    actual = "@swiftpkg_isomer//:IsomerServing",
    configuration = "own_swift_ui",
)
