"""isomer_apple: Isomer's iPhone and Mac apps, as a module of its own
(isomer's docs/platform_modules.md).

isomer itself asks for no Apple rules: an app on Android and the web alone
resolves rules_apple only at the version rules_swift_package_manager asks
for, and no rules_applecross, llvm, rules_python or xctestrunner. An app
with iPhone or Mac apps depends on this module, at isomer's version:

    bazel_dep(name = "isomer_apple", version = "<isomer's version>")

and names the iPhone and the Mac among isomer_application's platforms:

    load("@isomer//tools/application:defs.bzl", "WEB", "isomer_application")
    load("@isomer_apple//:defs.bzl", "IOS", "MACOS")

Released with isomer, from isomer's tag (this directory of it): the
registry's entry asks for the same release of isomer. Its version moves
with isomer's MODULE.bazel (tools/released_pins.sh checks it).
"""

module(
    name = "isomer_apple",
    version = "0.59.0",
)

# Declared before anything that brings rules_cc, as isomer's own
# apple_support is: apple_support's Apple C toolchain then ranks above
# rules_cc's local darwin one (which lacks CC_TARGET_TRIPLE and breaks the
# Xcode Swift toolchain). The BCR's 2.11.0, which rules_applecross asks for.
bazel_dep(name = "apple_support", version = "2.11.0")

# rules_apple at rules_applecross's version, from the project's registry:
# 5.3.1.applecross.6 is rules_apple 5.3.1 with rules_applecross's patches
# (bundling and signing on Linux), asking for rules_applecross 0.0.3.382f8c3,
# which asks for it back (a preset pair: no override, and no copies of the
# patches, in any root). Named build_bazel_rules_apple, as isomer's Apple
# BUILD files have always named it.
bazel_dep(name = "rules_apple", version = "5.3.1.applecross.6", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_applecross", version = "0.0.3.382f8c3")

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_swift", version = "4.3.0.isomer.2")

# The isomer whose isomer_application declares these platforms (and the
# heads the shells link), the same release.
bazel_dep(name = "isomer", version = "0.59.0")
