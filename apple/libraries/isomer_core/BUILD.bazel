load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The SwiftUI reimplementation core compiled NATIVELY for Apple under its own
# module name, so it can coexist with the real SwiftUI in one binary — the
# compiled engine behind `IsomerView` (apple/libraries/isomer_view).
# Same source set as the wasm reactors' slim module
# (//wasm/libraries/hot_swift_ui): core + component-system renderers (no GPU),
# so `SwiftUIRenderer` serializes tree.fbs Patches exactly like a reactor
# does — the host applies them with `FlatPatchTree` and renders real SwiftUI.
#
# Feature code written against `import SwiftUI` compiles against this module
# via `-module-alias SwiftUI=IsomerCore` on the feature library (the
# same trick as the compiled benchmark cells' IsoSwiftUIUIKit).
swift_library(
    name = "isomer_core",
    package_name = "isomer",
    srcs = [
        "//shared/renderers:srcs_no_gpu",
        "//shared/swift_ui_core:srcs",
    ],
    # The shared core spells its own types `SwiftUI.X` where a generic
    # parameter shadows the name (`Button where Label == SwiftUI.Label<…>`),
    # as Apple's interface does; this module is that SwiftUI under another name.
    copts = ["-module-alias", "SwiftUI=IsomerCore"],
    module_name = "IsomerCore",
    deps = [
        "//shared/isomer_swift_ui",
        "@flatbuffers//swift",
        "//frameworks:for_core",
    ],
)
