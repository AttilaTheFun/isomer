# The Foundation-backed platform services (shared/platform_services/native)
# conformed to the interfaces, for hosts that run the app in process (a
# compiled macOS/iOS app): `installNativePlatformServices(namespace:)` at
# launch, then PlatformDependencies.* in app code.

load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "platform_services_native",
    package_name = "isomer",
    srcs = [
        "NativePlatformServicesInstall.swift",
        "//shared/platform_services:native_srcs",
    ],
    module_name = "PlatformServicesNative",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:ios": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//shared/platform_services",
        "//swift_ffi/swift_ffi",
    ],
)
