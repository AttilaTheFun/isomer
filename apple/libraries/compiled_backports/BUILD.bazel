load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Standard library types newer than the OS a compiled feature runs on, for
# Isomer's compiled SwiftUI to stand on there (RangeSet.swift: TextSelection's
# ranges). Its own module name, beside the standard library's names: a
# feature's sources do not import it.
swift_library(
    name = "backports",
    srcs = glob(["*.swift"]),
    module_name = "IsomerCompiledBackports",
    target_compatible_with = select({
        "//apple/compiled:feature_on": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
