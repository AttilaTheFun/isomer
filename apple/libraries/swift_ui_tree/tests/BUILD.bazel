load("@rules_swift//swift:swift.bzl", "swift_test")

# IsomerTreeView's sibling identities (siblingIDs is `package`, hence the
# package name), built for the Mac like the rest of the tree library.
swift_test(
    name = "sibling_id_tests",
    package_name = "isomer",
    srcs = ["SiblingIDTests.swift"],
    # The xctest bundle resolves XCTest dylibs through the
    # /var/db/xcode_select_link symlink, which not every machine has; point
    # rpath at the standard Xcode install (as swift_gpu's tests do).
    linkopts = [
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/usr/lib",
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/Frameworks",
        "-Wl,-rpath,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/Library/PrivateFrameworks",
    ],
    deps = ["//apple/libraries/swift_ui_tree"],
)
