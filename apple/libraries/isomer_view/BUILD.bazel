load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# `IsomerView` — the single Apple embedding point for a Isomer
# feature, with two interchangeable engines behind one SwiftUI view:
# `.compiled` (the feature built natively against IsomerCore, running
# in-process) and `.wasm` (the same source as a `iso_hot` reactor bundle).
# Both emit the same tree.fbs Patch stream into the same `IsomerTreeView`,
# so a host ships compiled by default and can override with a wasm bundle —
# dev hot-reload or a dynamically delivered hotfix — without the app noticing.
swift_library(
    name = "isomer_view",
    package_name = "isomer",
    srcs = [
        "CompiledFeatureModel.swift",
        "IsomerView.swift",
    ],
    module_name = "IsomerView",
    deps = [
        "//apple/libraries/swift_ui_tree",
        "//apple/libraries/isomer_core",
        "//apple/libraries/wasm_view",
    ],
)
