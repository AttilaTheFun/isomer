"""The Playground: write SwiftUI on the device, build it there, run it there.

One app on iOS (//apple/playground_ios_application), the web
(//web/playground_web_application, with the site's front page beside it in
//web/splash_web_application) and Android
(//android/playground_android_application). Each carries a Swift compiler
that targets WebAssembly and runs what it builds on Isomer's SwiftUI.

A STANDALONE Bazel module inside the isomer repository (`playground/`, which
the root module's .bazelignore hides), consuming isomer the way an
application does, as `examples/` does: `bazel_dep` + an override, here
`local_path_override` on the parent checkout. It was part of isomer's
examples until 0.15, then a repository of its own that pinned isomer by
commit, and came back at 0.35 as a demo of what Isomer can do. bzlmod
honours `git_override` / `single_version_override` only from the root
module, so everything below the isomer dep repeats isomer's root-only
overrides; examples/MODULE.bazel is the reference: keep the two in step.

    cd playground && bazel build //... && bazel test //...
"""

module(
    name = "isomer_playground",
    version = "0.1.0",
)

# --- isomer itself ------------------------------------------------------
# The parent checkout. Outside this repository an application replaces
# local_path_override with:
#   git_override(module_name = "isomer",
#                remote = "https://github.com/AttilaTheFun/isomer.git",
#                commit = "<commit>")
bazel_dep(name = "isomer", version = "0.38.0")
local_path_override(
    module_name = "isomer",
    path = "..",
)

# --- What isomer needs from its consumer -------------------------------

# rules_swift and swift-foundation: isomer's forks come from the project's
# registry by version (.bazelrc lists it before the BCR), patches and all:
# rules_swift 3.6.1.isomer.1 sorts above every release a module asks for,
# and swift-foundation 6.3.2.isomer.1 comes with isomer. Nothing to override.
bazel_dep(name = "rules_swift", version = "3.6.1.isomer.1")

# swift_ffi, swift_gpu and swift_map are part of the isomer module
# (`@isomer//swift_ffi/...`, `@isomer//swift_gpu/...`, `@isomer//swift_map/...`):
# nothing to pin for them beyond isomer itself. .bazelrc points isomer's
# map-engine label flags at `@isomer//swift_map/...` so `Map` in a project
# draws real OpenStreetMap tiles.

# flatbuffers: the render-tree wire format. The release's swift BUILD glob
# misses Sources/FlatBuffers/Vectors/ (fixed on upstream master) and WASI
# needs a Foundation shim — both patched. bzlmod only applies override patches
# from the MAIN repository, so these are vendored copies of isomer's
# tools/patches files (every consumer must carry them until a flatbuffers
# release includes the fixes).
bazel_dep(name = "flatbuffers", version = "25.12.19")
single_version_override(
    module_name = "flatbuffers",
    patch_strip = 1,
    patches = [
        "//tools/patches:flatbuffers_foundation_wasi.patch",
        "//tools/patches:flatbuffers_swift_vectors.patch",
    ],
    version = "25.12.19",
)

# flatbuffers -> grpc -> rules_foreign_cc 0.10.1 fails to even load under this
# Bazel; force a compatible release (nothing of it is built here).
single_version_override(
    module_name = "rules_foreign_cc",
    version = "0.15.1",
)

# --- Toolchains (tags are read from the root module) --------------------------

# The swift.org host toolchain + wasm/Android Swift SDK cross toolchains.
swift = use_extension("@rules_swift//swift:extensions.bzl", "swift")
swift.toolchain(
    name = "swift_toolchain",
    swift_version = "6.3.2",
)
# The single-threaded wasm SDK only: what the Playground builds (its web app,
# the SDK its projects compile against) is single-threaded. The examples
# declare a wasi-threads SDK beside it for their threaded reactors.
swift.wasm_sdk()
swift.android_sdk()
use_repo(
    swift,
    "swift_toolchain",
    "swift_toolchain_xcode",
)

register_toolchains(
    "@swift_toolchain//:cc_toolchain_wasm32_xcode",
    "@swift_toolchain//:swift_toolchain_wasm32_xcode",
    "@swift_toolchain//:swift_toolchain_android_aarch64_xcode",
    "@swift_toolchain//:swift_toolchain_android_x86_64_xcode",
)

register_toolchains(
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04",
    # arm64 Linux (and the podman machine isomer's tools/linux/build.sh uses
    # on a Mac).
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04-aarch64",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04-aarch64",
)

# The hermetic Android NDK/SDK (the extension requires root-module tags even
# for Apple-only builds; accept the licenses in .bazelrc).
bazel_dep(name = "hermetic_android_toolchains", version = "0.1.1")
android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android")
android.sdk(
    build_tools_version = "35.0.0",
    version = "35",
)
android.ndk(
    api_level = 28,
    version = "r27c",
)
use_repo(android, "androidndk", "androidsdk")

bazel_dep(name = "rules_android", version = "0.7.3")

# Point rules_android at the hermetic @androidsdk (instead of $ANDROID_HOME).
rules_android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
override_repo(rules_android_sdk, "androidsdk")

register_toolchains(
    "@androidndk//:all",
    "@androidsdk//:all",
)

# --- Signing -------------------------------------------------------------------
# The builder's own Apple team for the iPhone build, from ISOMER_TEAM_ID in an
# untracked .bazelrc.user (`common --repo_env=ISOMER_TEAM_ID=<team>`,
# tools/signing, as the examples'); simulator builds need nothing.
signing = use_extension("//tools/signing:extension.bzl", "signing")
use_repo(signing, "isomer_signing")

# --- The Playground's own dependencies ----------------------------------------

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "apple_support", version = "2.6.1")

# Declared after apple_support so apple_support's apple cc toolchain keeps
# resolution priority over rules_cc's local_config_cc darwin toolchain.
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Xcode project generation for the Apple example apps
# (`bazel run //apple/<app>:<app>_project`).
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

# SwiftPM packages via rules_swift_package_manager (the graph in
# //third_party/swift_packages): AgentUI for the agent chat page, and
# OpenRouterKit, which the Playground's own OpenRouter loop is to move onto.
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")

# The generated SwiftPM package repositories load these by their apparent
# names, which they take from the module that owns their extension — this one,
# since //third_party/swift_packages:extensions.bzl re-exports it.
bazel_dep(name = "rules_license", version = "1.0.0")

# Forward-pin: the transitively-resolved rules_go is too old for Bazel 9 /
# builds gazelle's repo tools against the host Go (same fix as swift_interop).
bazel_dep(name = "rules_go", version = "0.61.1")

swift_deps = use_extension(
    "//third_party/swift_packages:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//third_party/swift_packages:Package.resolved",
    swift = "//third_party/swift_packages:Package.swift",
)

# AgentUI imports SwiftUI and Foundation. On Apple those are the system's;
# on the web and Android isomer's `SwiftUI` and `Foundation` modules, each
# reached through one label that resolves per platform (and to nothing on
# Apple). The canonical repository names: the generated package repos
# cannot see this module's apparent names.
swift_deps.configure_package(
    name = "agent_ui",
    target_deps = {
        "AgentUI": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
        "InboxUI": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
        "MarkdownViews": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
        "MessagesCore": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
        "MessagesUI": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
        "NavigationUI": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
    },
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_agent_ui",
    "swiftpkg_open_router_cli",
)

inject_repo(
    swift_deps,
    build_bazel_rules_swift = "rules_swift",
)

bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_kotlin", version = "2.2.2")
bazel_dep(name = "rules_python", version = "2.0.2")

# isomer's Android emulator/platform-tools bundle, which the `bazel run`
# helper drives.
android_tools = use_extension("@isomer//tools/android:extensions.bzl", "android_tools")
use_repo(
    android_tools,
    "android_build_tools",
    "android_emulator",
    "android_platform_jar",
    "android_platform_tools",
    "android_system_image",
    "hermetic_jdk",
    "kotlin_compiler",
)

# rules_android's Maven graph + the Compose artifacts the Android app uses. Declared from THIS root (bzlmod's rules_jvm_external cannot read a
# lock file from a non-root module), merging isomer's contribution; the
# lock is a vendored copy of isomer's.
#   REPIN=1 bazel run @rules_android_maven//:pin
bazel_dep(name = "rules_jvm_external", version = "7.1")
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "rules_android_maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    known_contributing_modules = [
        "rules_android",
        "isomer",
    ],
    lock_file = "//:rules_android_maven_install.json",
    version_conflict_policy = "pinned",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "rules_android_maven")

# Hermetic Go >= 1.24 for gazelle's repo tooling (rules_android's `ak` Go
# tools request it; the host Go is not consulted).
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.12")

