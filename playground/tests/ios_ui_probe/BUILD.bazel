load("@build_bazel_rules_apple//apple:ios.bzl", "ios_ui_test")
load("@rules_swift//swift:swift.bzl", "swift_library")

# Simulator UI probe for the Playground's Pokédex project: the ONLY way to drive
# taps on a simulator from this machine (no Simulator.app; simctl injects env,
# not touches). Opens the Pokédex project full screen (builds it in-app), taps the first row
# and writes the detail page screenshot + accessibility dump to
# /private/tmp/iso_ui_probe (run with --spawn_strategy=local so the sandbox
# allows the write). Manual: `bazel test //tests/ios_ui_probe:pokedex_detail
# --ios_multi_cpus=sim_arm64 --define iso_playground_embedded=1
# --test_arg=--destination=platform=ios_simulator,id=<simulator udid> --spawn_strategy=local --test_output=all`
# (always target one simulator by id, booted first; the device/version flags
# boot a NEW simulator per run and leak it).

swift_library(
    name = "probe_lib",
    testonly = True,
    srcs = ["PokedexDetailProbe.swift"],
    module_name = "PokedexDetailProbe",
    tags = ["manual"],
)

ios_ui_test(
    name = "pokedex_detail",
    minimum_os_version = "17.0",
    tags = ["manual"],
    test_host = "//apple/playground_ios_application:playground_ios_application",
    deps = [":probe_lib"],
)
