# The Playground's screens, written once in SwiftUI and compiled by BOTH
# Playgrounds: the iOS app against Apple's SwiftUI, the web app against
# Isomer's (docs/playground_web.md, "One Playground"). Anything
# platform-bound stays in the apps and is injected: the code editor view,
# the run surface (WasmView / the page's run overlay), the agent session.
# The agent chat page itself (transcript + composer) is AgentUI's AgentView,
# from the agent_ui SwiftPM package (@swiftpkg_agent_ui//:AgentUI).

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.swift"]))

filegroup(
    name = "srcs",
    srcs = glob(["*.swift"]),
)
