load("@rules_swift//swift:swift.bzl", "swift_library")
load("@isomer//swift_ffi/rules:swift_wasm_reactor.bzl", "swift_wasm_reactor")
load("@isomer//tools/wasm:defs.bzl", "ISOMER_HOST_ENTRIES")

package(default_visibility = ["//visibility:public"])

# The Gallery (@isomer//gallery) as an `iso_hot` reactor, gallery.wasm: what
# the Isomer app runs for "Run as wasm" on every platform (a WasmView on
# iOS, macOS and Android, the page's runner on the web, the WasmKit loader's
# window on Linux and Windows), beside the Gallery its own renderer draws.

swift_library(
    name = "gallery_main",
    srcs = ["GalleryMain.swift"],
    # The synthesized @main is reached only through the reactor's
    # `__main_argc_argv` trampoline, which links after this archive.
    alwayslink = True,
    copts = ["-parse-as-library"],
    module_name = "GalleryReactor",
    tags = ["manual"],
    deps = [
        "@isomer//gallery",
        "@isomer//shared/platform_services",
        "@isomer//wasm/libraries/swift_ui",
        "@isomer//wasm/libraries/swift_ui:hot_bridge",
        "@isomer//wasm/libraries/swift_ui:isomer",
    ],
)

# Shipped as an app's own reactor is: exporting only what its hosts call
# (swift_ffi's entries and the iso_hot bridge's), read from a link that
# exports everything, so the rest of the program is dead-stripped.
swift_wasm_reactor(
    name = "gallery",
    exports = "host",
    export_entries = ISOMER_HOST_ENTRIES,
    linkopts = [
        # Swift's deeply recursive view-tree / generic-metadata
        # instantiation overflows wasm-ld's default 1 MiB stack.
        "-Xlinker",
        "-z",
        "-Xlinker",
        "stack-size=16777216",
    ] + select({
        "@isomer//tools/wasm:opt": ["-Xlinker", "--strip-all"],
        "//conditions:default": [],
    }),
    swift = ":gallery_main",
)
