diff -ruN a/swift/toolchains/wasm/BUILD b/swift/toolchains/wasm/BUILD
--- a/swift/toolchains/wasm/BUILD
+++ b/swift/toolchains/wasm/BUILD
@@ -0,0 +1,20 @@
+# Which WebAssembly Swift SDK a wasm platform builds with when a module
+# declares two (`swift.wasm_sdk()` and `swift.wasm_sdk(threads = True, ...)`):
+# a platform that says nothing is `single_threaded`; one with `threaded`
+# targets wasm32-unknown-wasip1-threads.
+package(default_visibility = ["//visibility:public"])
+
+constraint_setting(
+    name = "threads",
+    default_constraint_value = ":single_threaded",
+)
+
+constraint_value(
+    name = "single_threaded",
+    constraint_setting = ":threads",
+)
+
+constraint_value(
+    name = "threaded",
+    constraint_setting = ":threads",
+)
