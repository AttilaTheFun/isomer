# "This website": the splash page with the example screens it embeds (as
# web/splash_web_application:splash_lib compiles it), one file like the
# others. The page declares its own `@main` App.
playground_sample(
    name = "splash_sample",
    out = "Splash.swift",
    title = "This website",
    srcs = [
        "//web/splash_web_application:Splash.swift",
        "//shared/sample_sources:Availability.swift",
        "//shared/sample_sources:Counter.swift",
        "//shared/sample_sources:Game2048.swift",
        "//shared/sample_sources:Pokedex.swift",
        "//shared/sample_sources:URLEncoding.swift",
    ],
    services = True,
)

apple_resource_group(
    name = "sample_data",
    structured_resources = [
        ":counter_sample",
        ":game2048_sample",
        ":hackernews_sample",
        ":wikipedia_sample",
        ":meme_sample",
        ":pokedex_sample",
    ],
)

apple_resource_group(
    name = "embedded_toolchain_data",
    structured_resources = glob(
        ["embedded_toolchain/data/**"],
        allow_empty = True,
    ),
)

swift_library(
    name = "playground_lib",
    srcs = [
        "Agent.swift",
        "Auth.swift",
        "ChatView.swift",
        "CodeEditor.swift",
        "CrashRecorder.swift",
        "EmbeddedCompiler.swift",
        "HeadlessRun.swift",
        "HostServices.swift",
        "HotReload.swift",
        "LLMClient.swift",
        "PlaygroundApp.swift",
        "PlaygroundStore.swift",
        "PreviewPane.swift",
        "Projects.swift",
        "Templates.swift",
        "RunMonitor.swift",
        "Spawn.swift",
        "ToolchainCompiler.swift",
        "WebTools.swift",
        "WebRunServer.swift",
        "//shared/playground_ui:srcs",
    ],
    module_name = "PlaygroundApp",
    tags = ["manual"],
    defines = select({
        ":embedded_toolchain_enabled": ["ISO_PLAYGROUND_EMBEDDED"],
        "//conditions:default": [],
    }),
    deps = [
        "//apple/platform_services_host",
        "@isomer//shared/platform_services",
        "@isomer//swift_ffi/runtime/swift_wasm_host",
        "@swiftpkg_agent_ui//:AgentUI",
        "@isomer//apple/libraries/wasm_view",
    ] + select({
        ":embedded_toolchain_enabled": [":embedded_toolchain_libs"],
        "//conditions:default": [],
    }),
)

# Device signing: the builder's team's Xcode-managed wildcard development
# profile (a year long with a paid team, listing the team's registered
# devices; tools/playground_toolchain/mint_profile makes it on a new Mac).
# The team is TEAM_ID, from ISOMER_TEAM_ID in the untracked .bazelrc.user
# (tools/signing). Simulator builds ignore it.
local_provisioning_profile(
    name = "_xcode_managed_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = TEAM_ID,
)

ios_application(
    name = "playground_ios_application",
    app_icons = ["//artwork/playground_icon:app_icon"],
    bundle_id = "com.LoganShire.Isomer",
    # The app is Isomer (Isomer.app, "Isomer" under its icon); the project is the Playground.
    bundle_name = "Isomer",
    # Its own app ID and keychain group: a wildcard profile's entitlements
    # would otherwise be copied as-is (application-identifier TEAM.*).
    entitlements = "Playground.entitlements",
    provisioning_profile = ":_xcode_managed_profile",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "18.0",
    resources = [
        ":playground_sdk",
        ":playground_site",
        ":sample_data",
    ] + select({
        ":embedded_toolchain_enabled": [":embedded_toolchain_data"],
        "//conditions:default": [],
    }),
    deps = [":playground_lib"],
)

# One command: build for the simulator, boot, install, and launch with the
# host SwiftWasm toolchain paths injected (SIMCTL_CHILD_*), so Compile works
# out of the box. `bazel run //apple/playground_ios_application:run`
sh_binary(
    name = "run",
    srcs = ["run_playground.sh"],
)
