package(default_visibility = ["//visibility:public"])

# Playground: a Swift Playgrounds-style example app. A file browser + text
# editor over .swift files; "Run" compiles them AGAINST THE BUNDLED WASM SDK
# into a `iso_hot` feature reactor and either runs it in-process under
# WasmView (the native SwiftUI renderer) or serves it to Safari
# (SFSafariViewController + the react renderer via the generic hot_host.js).
#
# The compiler backend is a seam (ToolchainCompiler): on the simulator the
# app posix_spawns the host SwiftWasm toolchain (paths injected by :run via
# SIMCTL_CHILD_*); the on-device backend links swift-frontend + lld as
# static libraries (in progress — same seam, no UI change).

# The compile-against/link-with SDK: the slim `SwiftUI` module + the iso_hot
# bridge and their transitive wasm32 archives, bundled with a manifest.
wasm_sdk_bundle(
    name = "playground_sdk",
    platform = "@isomer//swift_ffi/rules:wasm32-wasip1",
    deps = [
        "@isomer//shared/platform_services",
        "@isomer//:foundation",
        "@isomer//wasm/libraries/hot_swift_ui:hot_bridge_network",
        "@isomer//wasm/libraries/hot_swift_ui:isomer",
        "@isomer//wasm/libraries/hot_swift_ui:swift_ui_extensions",
    ],
)

# The web-run site: index.html + the react renderer + the generic iso_hot
# host. `app.wasm` is NOT here — the in-app HTTP server serves the latest
# user build at /app.wasm. swift_ffi_runtime.js (the WASI shim hot_host.js
# imports) is the shared, app-independent runtime file; borrowed from the
# full web example's compiled output.
assemble_directory(
    name = "playground_site",
    spec = {
        "web/index.html": "index.html",
        "@isomer//wasm/libraries/swift_ui:runtime/hot_host.js": "hot_host.js",
        "//web/playground_web_application:swift_ffi_runtime_js": "swift_ffi_runtime.js",
        "//web/playground_web_application:app_bridge_js_files": "app_bridge.js",
        "@isomer//wasm/libraries/swift_ui:runtime/react_renderer.js": "runtime/react_renderer.js",
        "@isomer//wasm/libraries/swift_ui:runtime/flat_tree.js": "runtime/flat_tree.js",
        # The renderer's symbol table: a module it imports, so the page is
        # blank without it.
        "@isomer//wasm/libraries/swift_ui:runtime/symbols.js": "runtime/symbols.js",
        "@isomer//wasm/libraries/swift_ui:runtime/imported_files.js": "runtime/imported_files.js",
        "@isomer//wasm/libraries/swift_ui:runtime/file_system.js": "runtime/file_system.js",
        "@isomer//wasm/libraries/swift_ui:runtime/network.js": "runtime/network.js",
        # Image sources the renderer resolves (decoded images, isomer 0.19).
        "@isomer//wasm/libraries/swift_ui:runtime/raster.js": "runtime/raster.js",
        "@isomer//tools/wasm:react_umd_js": "runtime/react.production.min.js",
        "@isomer//tools/wasm:react_dom_umd_js": "runtime/react-dom.production.min.js",
    },
)

# Every module the page imports is in the site (it is blank otherwise, as it
# was when the renderer gained symbols.js, then imported_files.js, then
# raster.js).
site_imports_test(
    name = "playground_site_imports_test",
    site = ":playground_site",
)

# The EMBEDDED toolchain (`--define iso_playground_embedded=1`): the Swift
# compiler + lld linked INTO the app as static libraries, staged by
# build_embedded_toolchain.sh into the gitignored embedded_toolchain/ (one
# lib set per platform + shared wasm SDK data). This is the DEVICE backend —
# compilation is two in-process calls, no subprocess — and the simulator
# runs it identically.
config_setting(
    name = "embedded_toolchain_enabled",
    values = {"define": "iso_playground_embedded=1"},
)

# The syntax-enabled frontend dynamically links the compiler's SwiftSyntax
# libraries. They ship as EMBEDDED FRAMEWORKS (host/frameworks/*.framework,
# made by frameworkize_host.sh) together with the in-process plugin server
# and the prebuilt macro plugins (libSwiftMacros/libObservationMacros):
# rules_apple copies them into Frameworks/ and signs them — iOS refuses to
# load unsigned dylibs, even from inside the app bundle. The frontend
# dlopens the server + plugins from Frameworks/ (EmbeddedCompiler.swift) —
# macro expansion with no subprocess.
# One import target per framework (the rule accepts a single bundle each);
# names come from the staged Info.plists so a re-staging needs no BUILD edit.
_HOST_FRAMEWORKS = {
    platform: [
        plist.split("/")[-2][:-len(".framework")]
        for plist in glob(
            ["embedded_toolchain/%s/host/frameworks/*.framework/Info.plist" % platform],
            allow_empty = True,
        )
    ]
    for platform in ["iphoneos", "iphonesimulator"]
}

[
    apple_dynamic_framework_import(
        name = "embedded_fw_%s_%s" % (platform, name),
        # Macro plugins (lib<Name>.dylib.framework) are dlopen'd by the
        # frontend, not linked: bundle + sign only.
        bundle_only = name.endswith(".dylib"),
        framework_imports = glob(["embedded_toolchain/%s/host/frameworks/%s.framework/**" % (platform, name)]),
        tags = ["manual"],
    )
    for platform in _HOST_FRAMEWORKS
    for name in _HOST_FRAMEWORKS[platform]
]

cc_library(
    name = "embedded_toolchain_libs",
    srcs = select({
        "@apple_support//constraints:simulator": glob(
            [
                "embedded_toolchain/iphonesimulator/lib/*.a",
                "embedded_toolchain/iphonesimulator/obj/*.o",
            ],
            allow_empty = True,
        ),
        "//conditions:default": glob(
            [
                "embedded_toolchain/iphoneos/lib/*.a",
                "embedded_toolchain/iphoneos/obj/*.o",
            ],
            allow_empty = True,
        ),
    }),
    linkopts = [
        "-lm",
        "-lobjc",
        "-lc++",
    ],
    tags = ["manual"],
    deps = select({
        "@apple_support//constraints:simulator": [
            ":embedded_fw_iphonesimulator_" + name
            for name in _HOST_FRAMEWORKS["iphonesimulator"]
        ],
        "//conditions:default": [
            ":embedded_fw_iphoneos_" + name
            for name in _HOST_FRAMEWORKS["iphoneos"]
        ],
    }),
)

# The project templates (and the out-of-the-box projects): the SAME sources
# the example apps ship, each assembled with a @main wrapper into one file
# that compiles against the Playground SDK (see samples.bzl).
playground_sample(
    name = "counter_sample",
    out = "Counter.swift",
    title = "Counter",
    app = [
        "struct CounterApp: App {",
        "    var body: some Scene { WindowGroup { NavigationStack { CounterScreen() } } }",
        "}",
    ],
    srcs = ["//shared/sample_sources:Counter.swift"],
)

playground_sample(
    name = "game2048_sample",
    out = "Game2048.swift",
    title = "2048",
    app = [
        "struct Game2048App: App {",
        "    var body: some Scene {",
        "        // The cream board is a light design: keep the bar and status text dark.",
        "        WindowGroup { NavigationStack { Game2048Screen() }.preferredColorScheme(.light) }",
        "    }",
        "}",
    ],
    srcs = [
        "//shared/sample_sources:Availability.swift",
        "//shared/sample_sources:Game2048.swift",
    ],
)

playground_sample(
