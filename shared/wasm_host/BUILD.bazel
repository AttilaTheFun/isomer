load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The native wasm-host platforms, every one on WasmKit since 0.38: macOS + iOS
# (Apple's `WasmView`), Android (android/libraries/wasm_view's engine, under
# its Kotlin host), and the Linux and Windows hosts.
_NATIVE_WASM_HOSTS = select({
    "@platforms//os:macos": [],
    "@platforms//os:ios": [],
    "@platforms//os:android": [],
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# The engine seam, engine-free: the `WasmRuntime` protocol + `WasmHostImports` +
# `WasmScalar`. Split out of the host so the concrete engine (`WasmKitRuntime`)
# and the driver (`WasmFeatureRuntime`) share one small protocol module with no
# interpreter dependency. Deps are only the swift_ffi scalar + the swift_ffi DI.
swift_library(
    name = "wasm_runtime",
    package_name = "isomer",
    srcs = [
        "TypingSignposts.swift",
        "WasmRuntime.swift",
    ],
    module_name = "IsomerWasmRuntime",
    target_compatible_with = _NATIVE_WASM_HOSTS,
    deps = [
        "//swift_ffi/runtime/swift_wasm_host",
    ],
)

# `WasmKitRuntime` — the engine on every native host (WAMR's place until 0.38),
# on WasmKit (the Swift interpreter; MODULE.bazel's `wasmkit`): WASI, the
# render callbacks and the swift_ffi transport in Swift, and WASI Threads for
# a reactor built for wasm32-unknown-wasip1-threads where WasmKit can make a
# shared memory. Apple's WasmView registers it as the default
# (WasmRuntimeRegistry.registerDefault); the Linux and Windows hosts make it
# directly.
swift_library(
    name = "wasmkit_runtime",
    package_name = "isomer",
    srcs = ["WasmKitRuntime.swift"],
    # Optimized in every build, as WasmKit is: its host imports run per
    # guest call.
    copts = ["-O"],
    module_name = "IsomerWasmKitRuntime",
    target_compatible_with = _NATIVE_WASM_HOSTS,
    deps = [
        ":wasm_runtime",
        "//swift_ffi/runtime/swift_wasm_host",
        "@wasmkit//:WasmKit",
        "@wasmkit//:WasmKitWASI",
        "@wasmkit//:WasmKitWASIThreads",
    ],
)

# `JSCRuntime` — the EXPERIMENTAL JavaScriptCore engine: the reactor runs on
# JSC's own WebAssembly implementation inside a JSContext (JIT wasm tiers on
# macOS; interpreter-only on iOS devices, where 3rd-party processes get no
# JIT pages). Proves the engine seam with a JS runtime AS the wasm runtime.
swift_library(
    name = "jsc_runtime",
    package_name = "isomer",
    srcs = ["JSCRuntime.swift"],
    module_name = "IsomerJSCRuntime",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:ios": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":wasm_runtime",
        "//swift_ffi/runtime/swift_wasm_host",
    ],
)

# `WasmEdgeRuntime` — the EXPERIMENTAL WasmEdge engine (interpreter,
# built-in WASI) over the prebuilt C API SDK. macOS-only, dev-only.
swift_library(
    name = "wasmedge_runtime",
    package_name = "isomer",
    srcs = ["WasmEdgeRuntime.swift"],
    module_name = "IsomerWasmEdgeRuntime",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":wasm_runtime",
        "//shared/wasm_host/engine_shims:cwasmedge",
        "//swift_ffi/runtime/swift_wasm_host",
    ],
)

# The cross-platform native wasm-host runtime: it runs one wasm feature reactor
# (a swift_ui_core UI compiled to a `iso_hot` reactor) under the REGISTERED
# engine (WasmRuntimeRegistry — WasmKit, or a consumer's own), in-process,
# republishes the render tree, and injects native dependencies through the
# swift_ffi dependency transport. UI-framework-free (no SwiftUI / Compose), so
# every native host builds on it — Apple's `WasmView` (//apple/libraries/
# wasm_view) and the Linux/Windows hosts. Bundle DELIVERY is platform-specific
# and lives outside this lib. See docs/wasm_view_architecture.md.
swift_library(
    name = "wasm_host",
    package_name = "isomer",
    srcs = [
        "WasmFeatureRuntime.swift",
        "WasmServiceBundle.swift",
    ],
    module_name = "IsomerWasmHost",
    target_compatible_with = _NATIVE_WASM_HOSTS,
    deps = [
        ":wasm_runtime",
        "//swift_ffi/runtime/swift_wasm_host",
    ],
)
