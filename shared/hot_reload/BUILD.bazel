load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

_MACOS_OR_LINUX = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# The hot-reload server, for any workspace that depends on isomer: `bazel run
# @isomer//shared/hot_reload:hot_reload_server -- --target=//app:feature.wasm
# --watch=app` builds the target on each edit under the watched directory and
# serves `/version` and `/wasm`, which every host's hot-reload source polls
# (an iPhone simulator, an Android emulator, the desktop wasm hosts). Plain
# Foundation + BSD sockets, on macOS and Linux (Windows' WinSock branches are
# there, not yet exercised). See HotReloadServer.swift for its options.
swift_binary(
    name = "hot_reload_server_bin",
    package_name = "isomer",
    srcs = ["HotReloadServer.swift"],
    copts = ["-parse-as-library"],
    target_compatible_with = _MACOS_OR_LINUX,
)

# `bazel run //shared/hot_reload:hot_reload_server` starts the server; the
# wrapper points LD_LIBRARY_PATH at the swift.org runtime (whose runfiles-
# relative RUNPATH doesn't resolve under `bazel run`) and execs the real binary.
sh_binary(
    name = "hot_reload_server",
    srcs = ["run_hot_reload.sh"],
    data = [":hot_reload_server_bin"],
    target_compatible_with = _MACOS_OR_LINUX,
)
