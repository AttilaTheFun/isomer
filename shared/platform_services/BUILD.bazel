# The platform services an app's Swift code reads through PlatformDependencies
# and every host injects — the keychain, OAuth, timers, analytics,
# configuration, the image picker, device motion — as swift_ffi
# @ExportedInterfaces implemented by each host (Security and AppKit/UIKit on
# Apple, Kotlin on Android, the browser on the web, the WAMR C host on
# Linux/Windows). Networking, files and preferences are Foundation's
# (URLSession, FileManager, UserDefaults), not services, since 0.31.
# The C ABI is macro-expanded into :platform_services (swift_ffi v3), so
# there is no glue module; reactors and compiled apps link the annotated
# library directly.
#
#   :platform_services        — the annotated module (guest / compiled app)
#   :platform_services_host   — native swift-host-wasm bindings (WasmView hosts)
#   :platform_services_c_host — native c-host-wasm bindings (the WAMR C host)
#   //apple/libraries/platform_services_native — the Foundation implementations
#   conformed to these protocols for in-process Apple hosts; the browser's
#   implementations ship in the runtime (runtime/platform_services.js).

load("@rules_swift//swift:swift.bzl", "swift_library")
load("//swift_ffi/rules:c_host_library.bzl", "c_host_library")
load("//swift_ffi/rules:swift_wasm_library.bzl", "swift_wasm_library")

package(default_visibility = ["//visibility:public"])

# Foundation-backed implementations Swift hosts share (compiled apps, the
# Apple WasmView hosts, the Playground); each adds its own conformances.
filegroup(
    name = "native_srcs",
    srcs = [
        "native/NativeDeviceMotion.swift",
        "native/NativeImagePicker.swift",
        "native/NativePlatformServices.swift",
    ],
)

swift_library(
    name = "platform_services",
    package_name = "isomer",
    srcs = ["PlatformServices.swift"],
    module_name = "PlatformServices",
    tags = ["manual"],
    deps = ["//swift_ffi/swift_ffi"],
)

swift_wasm_library(
    name = "platform_services_host",
    host_module_name = "PlatformServicesHost",
    module_name = "PlatformServices",
    swift = ":platform_services",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:ios": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

c_host_library(
    name = "platform_services_c_host",
    module_name = "PlatformServices",
    swift = ":platform_services",
)
