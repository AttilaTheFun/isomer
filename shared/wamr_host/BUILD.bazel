load("@rules_swift//swift:swift.bzl", "swift_interop_hint")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# The C host that runs one Isomer `iso_hot` wasm reactor under the WAMR
# (wasm-micro-runtime) interpreter. This is the Android "wasm" delivery engine:
# because WAMR is C (not Swift, unlike WasmKit), the wasm feature ships with NO
# compiled Swift in the app. WAMR replaced wasm3, whose module LOAD was
# pathologically slow on Android (~61s vs WAMR's sub-second load for the 9.5MB
# reactor). The WAMR runtime itself is vendored once in swift_ffi and consumed via
# //swift_ffi/runtime/wamr:wamr (fast interpreter; a config-gated AOT
# loader kicks in under --define wamr_aot=1) — isomer declares no @wamr.
# Platform-neutral — a JNI shim drives it on Android
# (//android/libraries/wasm_view), and the smoke test drives it on the host.
# See docs/wasm_view_architecture.md.

# `--define wamr_profile=1`: WAMR's per-function profiler is compiled in
# (MODULE.bazel), and iso_wamr_dump_profile prints it.
config_setting(
    name = "wamr_profile",
    define_values = {"wamr_profile": "1"},
)

cc_library(
    name = "iso_wamr",
    srcs = ["iso_wamr.c"],
    hdrs = ["iso_wamr.h"],
    local_defines = select({
        ":wamr_profile": ["ISO_WAMR_PROFILE"],
        "//conditions:default": [],
    }),
    # Exposes iso_wamr.h to Swift as the `CIsoWamr` module so the Apple
    # `WamrRuntime` (//shared/wasm_host:wamr_runtime) can drive it as a
    # `WasmRuntime` engine. Harmless for the Android/JNI C consumers.
    aspect_hints = [":iso_wamr_swift"],
    # On Windows @wamr links as a static archive with plainly-named symbols, but
    # wasm_export.h decorates its API with __declspec(dllimport) by default (→
    # __imp_ references that no static archive supplies). Defining
    # COMPILING_WASM_RUNTIME_API here flips the decl to dllexport, so the
    # references stay plain and resolve against wamr.lib. Same define @wamr builds
    # with; a no-op on the GCC/Clang visibility path.
    copts = select({
        "@platforms//os:windows": ["-DCOMPILING_WASM_RUNTIME_API"],
        "//conditions:default": [],
    }),
    includes = ["."],
    deps = [
        # The vendored WAMR, re-exported from swift_ffi so the whole stack shares
        # ONE runtime (main-pinned, with the SwiftWasm interp flags + config-gated
        # AOT loader). isomer no longer declares its own @wamr.
        "//swift_ffi/runtime/wamr:wamr",
        # The generated swift_ffi C host (dependency DI) + its C runtime. This
        # is the transport for flag/track; iso_wamr.c supplies only the WAMR
        # SwiftFFIEngine + a generic raw trampoline + the app's native service impls.
        "//swift_ffi/runtime/c_host:swift_ffi_host",
    ],
)

swift_interop_hint(
    name = "iso_wamr_swift",
    module_name = "CIsoWamr",
)

# XIP smoke: runs a `wamrc --xip` image IN PLACE from a read-only+exec mapping
# — the shape of the embedded iOS AOT tier. Build with --define=wamr_aot=1.
cc_binary(
    name = "iso_wamr_xip_smoke",
    srcs = ["iso_wamr_xip_smoke.c"],
    tags = ["manual"],
    deps = [":iso_wamr"],
)
