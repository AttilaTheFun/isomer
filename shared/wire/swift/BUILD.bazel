load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

exports_files([
    "headless.pb.swift",
    "session.pb.swift",
])

# IsomerWire (isomer's Swift package): the remote session's messages
# (../session.proto) and the driver's (../headless.proto), generated by
# protoc-gen-swift and checked in (//shared/wire's diff tests keep them
# current), so a consumer builds them without protoc; and WireDelimited, their
# framing in a stream of bytes (Delimited.swift).
one_configuration(
    name = "swift",
    actual = "@swiftpkg_isomer//:IsomerWire",
)

# SwiftProtobuf in the configuration the package's modules are built in
# (IsomerSwiftUI and IsomerWire depend on it there): reached directly, it
# would be built a second time beside them, and a binary with both (the
# headless host's) fails to link on Linux on duplicate symbols.
one_configuration(
    name = "swift_protobuf",
    actual = "@swiftpkg_swift_protobuf//:SwiftProtobuf",
)
