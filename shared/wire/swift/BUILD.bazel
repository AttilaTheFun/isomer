load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# IsomerWire (isomer's Swift package): the remote session's messages
# (../session.proto) and the driver's (../headless.proto), generated as it
# builds (//shared/wire:wire_messages under Bazel); and WireDelimited, their
# framing in a stream of bytes (Delimited.swift).
one_configuration(
    name = "swift",
    actual = "@swiftpkg_isomer//:IsomerWire",
)

# SwiftProtobuf in the configuration the package's modules are built in
# (IsomerSwiftUI and IsomerWire depend on it there): reached directly, it
# would be built a second time beside them, and a binary with both (the
# headless host's) fails to link on Linux on duplicate symbols.
one_configuration(
    name = "swift_protobuf",
    actual = "//:swift_protobuf",
)

# The same, in the configuration of a build whose SwiftUI isn't the package's
# (Apple's tree renderer beside Apple's SwiftUI:
# //shared/isomer_swift_ui:beside_own_swift_ui), so SwiftProtobuf is built
# once there (apple/libraries/remote_head).
one_configuration(
    name = "beside_own_swift_ui",
    actual = "@swiftpkg_isomer//:IsomerWire",
    configuration = "own_swift_ui",
)
