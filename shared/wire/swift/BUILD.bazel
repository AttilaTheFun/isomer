load("@rules_swift//swift:swift.bzl", "swift_library")
load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

exports_files([
    "headless.pb.swift",
    "session.pb.swift",
])

# IsomerWire: the remote session's messages (../session.proto) and the
# headless driver's (../headless.proto), generated by protoc-gen-swift and
# checked in (//shared/wire's diff tests keep them current), so a consumer
# builds them without protoc; and WireDelimited, their framing in a stream
# of bytes (Delimited.swift).
swift_library(
    name = "swift",
    srcs = [
        "Delimited.swift",
        "headless.pb.swift",
        "session.pb.swift",
    ],
    module_name = "IsomerWire",
    deps = [
        ":swift_protobuf",
        "//:foundation",
    ],
)

# SwiftProtobuf in the configuration the package's modules are built in
# (IsomerSwiftUI depends on it there): reached directly, it would be built a
# second time beside them, and a binary with both (the headless host's)
# fails to link on Linux on duplicate symbols.
one_configuration(
    name = "swift_protobuf",
    actual = "@swiftpkg_swift_protobuf//:SwiftProtobuf",
)
