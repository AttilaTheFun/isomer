"""One generated Swift file of a swift_proto_library, for a diff test against the checked-in copy."""

load("@rules_swift//proto:proto.bzl", "SwiftProtoInfo")

def _swift_proto_source_impl(ctx):
    matches = [
        file
        for file in ctx.attr.library[SwiftProtoInfo].direct_pbswift_files
        if file.basename == ctx.attr.file
    ]
    if len(matches) != 1:
        fail("{} generates no {} (it generates {})".format(
            ctx.attr.library.label,
            ctx.attr.file,
            ", ".join([file.basename for file in ctx.attr.library[SwiftProtoInfo].direct_pbswift_files]),
        ))
    out = ctx.actions.declare_file(ctx.label.name + "/" + ctx.attr.file)
    ctx.actions.symlink(output = out, target_file = matches[0])
    return [DefaultInfo(files = depset([out]))]

swift_proto_source = rule(
    implementation = _swift_proto_source_impl,
    doc = "The file a swift_proto_library generated by that name (the library itself isn't compiled for it).",
    attrs = {
        "file": attr.string(mandatory = True, doc = "The generated file's name, e.g. tree.pb.swift."),
        "library": attr.label(mandatory = True, providers = [SwiftProtoInfo]),
    },
)
