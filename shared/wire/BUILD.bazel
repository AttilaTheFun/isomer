load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_swift//proto:proto.bzl", "swift_proto_compiler", "swift_proto_library")
load(":defs.bzl", "swift_proto_source")

# The render tree's wire format (tree.proto), the remote session's
# (session.proto), the headless driver's (headless.proto) and their services
# (session_service.proto). Their Swift is generated by swift_proto_library and
# checked in, so isomer's Swift package builds it without protoc:
# shared/isomer_swift_ui/tree.pb.swift (IsomerSwiftUI), ./swift's
# session.pb.swift and headless.pb.swift (IsomerWire) and
# drive/grpc/session_service.grpc.swift (IsomerGRPCTransport). The diff tests
# below keep each the generator's. The JavaScript and Kotlin readers are
# hand-written (wasm/libraries/swift_ui/runtime/flat_tree.js,
# android/…/FlatTree.kt).
#
# The libraries here are only the generators: tagged manual, and never
# compiled for the tests (they read the generated files alone). An app links
# the package's modules (//shared/wire/swift, //drive/grpc), never these.
exports_files([
    "headless.proto",
    "session.proto",
    "session_service.proto",
    "tree.proto",
])

# --- The protos: imported by their names alone (`import "session.proto"`) ---

[
    proto_library(
        name = name + "_proto",
        srcs = [name + ".proto"],
        strip_import_prefix = "/shared/wire",
    )
    for name in [
        "headless",
        "session",
        "tree",
    ]
]

proto_library(
    name = "session_service_proto",
    srcs = ["session_service.proto"],
    strip_import_prefix = "/shared/wire",
    deps = [
        ":headless_proto",
        ":session_proto",
    ],
)

# --- The compilers: protoc from the protobuf module, the plugins and the
# runtimes from isomer's SwiftPM graph (RSPM) ---

swift_proto_compiler(
    name = "swift_proto",
    plugin = "@swiftpkg_swift_protobuf//:protoc-gen-swift",
    plugin_name = "swift",
    plugin_option_allowlist = [
        "FileNaming",
        "Visibility",
    ],
    plugin_options = {"Visibility": "Public"},
    protoc = "@protobuf//:protoc",
    suffixes = [".pb.swift"],
    deps = ["@swiftpkg_swift_protobuf//:SwiftProtobuf"],
)

# gRPC Swift 2's client and server (protoc-gen-grpc-swift-2).
swift_proto_compiler(
    name = "grpc_swift_2",
    plugin = "@swiftpkg_grpc_swift_protobuf//:protoc-gen-grpc-swift-2",
    plugin_name = "grpc-swift",
    plugin_option_allowlist = [
        "Client",
        "ExtraModuleImports",
        "FileNaming",
        "Server",
        "Visibility",
    ],
    plugin_options = {
        "Client": "true",
        "Server": "true",
        "Visibility": "Public",
    },
    protoc = "@protobuf//:protoc",
    suffixes = [".grpc.swift"],
    deps = [
        "@swiftpkg_grpc_swift_2//:GRPCCore",
        "@swiftpkg_grpc_swift_protobuf//:GRPCProtobuf",
        "@swiftpkg_swift_protobuf//:SwiftProtobuf",
    ],
)

# --- The generators: the modules' names are the package's, so the generated
# code imports what the package builds (session_service.grpc.swift's
# `import IsomerWire`) ---

swift_proto_library(
    name = "tree_swift_proto",
    compilers = [":swift_proto"],
    module_name = "IsomerSwiftUI",
    protos = [":tree_proto"],
    tags = ["manual"],
)

swift_proto_library(
    name = "wire_swift_proto",
    compilers = [":swift_proto"],
    module_name = "IsomerWire",
    protos = [
        ":headless_proto",
        ":session_proto",
    ],
    tags = ["manual"],
)

swift_proto_library(
    name = "session_service_swift_grpc",
    compilers = [":grpc_swift_2"],
    module_name = "IsomerGRPCTransport",
    protos = [":session_service_proto"],
    tags = ["manual"],
    deps = [":wire_swift_proto"],
)

# --- The checked-in copies held to the generators' ---

[
    (
        swift_proto_source(
            name = name + "_generated",
            file = file,
            library = library,
        ),
        diff_test(
            name = name + "_test",
            failure_message = "Regenerate " + checked_in + ": bazel build //shared/wire:" + name + "_generated, and copy its output over it.",
            file1 = label,
            file2 = ":" + name + "_generated",
        ),
    )
    for name, file, library, label, checked_in in [
        ("tree_swift", "tree.pb.swift", ":tree_swift_proto", "//shared/isomer_swift_ui:tree.pb.swift", "shared/isomer_swift_ui/tree.pb.swift"),
        ("session_swift", "session.pb.swift", ":wire_swift_proto", "//shared/wire/swift:session.pb.swift", "shared/wire/swift/session.pb.swift"),
        ("headless_swift", "headless.pb.swift", ":wire_swift_proto", "//shared/wire/swift:headless.pb.swift", "shared/wire/swift/headless.pb.swift"),
        ("session_service_grpc_swift", "session_service.grpc.swift", ":session_service_swift_grpc", "//drive/grpc:session_service.grpc.swift", "drive/grpc/session_service.grpc.swift"),
    ]
]
