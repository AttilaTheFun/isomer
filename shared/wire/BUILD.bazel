load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_swift//proto:proto.bzl", "swift_proto_compiler", "swift_proto_library")

package(default_visibility = ["//visibility:public"])

# The render tree's wire format (tree.proto), the remote session's
# (session.proto), the headless driver's (headless.proto) and their services
# (session_service.proto, which IsomerGRPCTransport serves and calls by hand:
# its messages go through as bytes, so it needs no generated code).
#
# Their Swift is generated as they build, never checked in: by
# swift-protobuf's build plugin in a SwiftPM build (Package.swift, each
# target's swift-protobuf-config.json), and here, where
# rules_swift_package_manager runs no plugin, by swift_proto_library. The
# package's IsomerSwiftUI and IsomerWire take these modules
# (MODULE.bazel's configure_package target_deps) and re-export them, so
# `import IsomerWire` gives Wire_Command either way. The JavaScript and
# Kotlin readers of the tree are hand-written
# (wasm/libraries/swift_ui/runtime/flat_tree.js, android/…/FlatTree.kt).
exports_files([
    "headless.proto",
    "layout.proto",
    "session.proto",
    "session_service.proto",
    "tree.proto",
])

# --- The protos, imported by their names alone (`import "session.proto"`) --

[
    proto_library(
        name = name + "_proto",
        srcs = [name + ".proto"],
        strip_import_prefix = "/shared/wire",
    )
    for name in [
        "headless",
        "layout",
        "session",
        "tree",
    ]
]

# Compiled, and so checked, though nothing generates from it.
proto_library(
    name = "session_service_proto",
    srcs = ["session_service.proto"],
    strip_import_prefix = "/shared/wire",
    deps = [
        ":headless_proto",
        ":layout_proto",
        ":session_proto",
    ],
)

# --- Their Swift: protoc from the protobuf module, protoc-gen-swift and
# SwiftProtobuf from the SwiftPM graph (the package's own) ---

swift_proto_compiler(
    name = "swift_proto",
    plugin = "@swiftpkg_swift_protobuf//:protoc-gen-swift",
    plugin_name = "swift",
    plugin_option_allowlist = [
        "FileNaming",
        "Visibility",
    ],
    plugin_options = {"Visibility": "Public"},
    protoc = "@protobuf//:protoc",
    suffixes = [".pb.swift"],
    deps = ["@swiftpkg_swift_protobuf//:SwiftProtobuf"],
)

# The render tree's messages: IsomerSwiftUI's (it re-exports them).
swift_proto_library(
    name = "tree_messages",
    additional_compiler_deps = ["//:foundation"],
    compilers = [":swift_proto"],
    module_name = "IsomerTreeMessages",
    package_name = "isomer",
    protos = [":tree_proto"],
)

# The session's and the driver's messages: IsomerWire's (it re-exports them).
swift_proto_library(
    name = "wire_messages",
    additional_compiler_deps = ["//:foundation"],
    compilers = [":swift_proto"],
    module_name = "IsomerWireMessages",
    package_name = "isomer",
    protos = [
        ":headless_proto",
        ":layout_proto",
        ":session_proto",
    ],
)
