load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# IsomerSwiftUI, isomer's Swift package's (Package.swift): what a host reads
# of the runtime, and the render tree's wire format (shared/wire/tree.proto),
# generated as it builds (//shared/wire:tree_messages under Bazel).
one_configuration(
    name = "isomer_swift_ui",
    actual = "@swiftpkg_isomer//:IsomerSwiftUI",
)

# IsomerSwiftUI for a build whose SwiftUI isn't the package's (Apple's beside
# Isomer's tree views, or a core compiled in place): the package's modules
# built apart from the ones that build has, foundation/defs.bzl says why.
one_configuration(
    name = "beside_own_swift_ui",
    actual = "@swiftpkg_isomer//:IsomerSwiftUI",
    configuration = "own_swift_ui",
)

