load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# IsomerSwiftUI, isomer's Swift package's (Package.swift): what a host reads
# of the runtime. TreeGenerated.swift is flatc's Swift for the render tree's
# wire format (shared/renderers/tree.fbs), checked in so the package builds it
# without flatc; tree_generated_test keeps it flatc's.
one_configuration(
    name = "isomer_swift_ui",
    actual = "@swiftpkg_isomer//:IsomerSwiftUI",
)

# IsomerSwiftUI for a build whose SwiftUI isn't the package's (Apple's beside
# Isomer's tree views, or a core compiled in place): the package's modules
# built apart from the ones that build has, foundation/defs.bzl says why.
one_configuration(
    name = "beside_own_swift_ui",
    actual = "@swiftpkg_isomer//:IsomerSwiftUI",
    configuration = "own_swift_ui",
)

diff_test(
    name = "tree_generated_test",
    failure_message = "Regenerate shared/isomer_swift_ui/TreeGenerated.swift: bazel build //shared/renderers:tree_swift, and copy its output over it.",
    file1 = "TreeGenerated.swift",
    file2 = "//shared/renderers:tree_swift",
)
