load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")
load("@rules_cc//cc:defs.bzl", "cc_library")

load("//foundation:defs.bzl", "one_configuration")

package(default_visibility = ["//visibility:public"])

# Native Linux host + OpenGL renderer. Exposes a flat C API (renderer.h) that the
# Swift host bridge calls; built with the system C toolchain (gcc) when the app
# target resolves on a Linux host. Draws every UI primitive on the GPU with an
# SDF fragment shader (rounded rects / borders / gradients / soft shadows), text
# via SDL2_ttf, images via stb_image, and async HTTP via libcurl — all hosted in
# an SDL2 window. The shared libraries (SDL2, SDL2_ttf, libGL via libglvnd,
# libcurl) ship on essentially every desktop Linux / SteamOS install.
cc_library(
    name = "renderer",
    srcs = [
        "renderer.c",
        "stb_impl.c",
    ],
    hdrs = [
        "renderer.h",
        "stb/stb_image.h",
        "webview_linux.h",
    ],
    copts = [
        "-std=c11",
        "-D_REENTRANT",
        "-Wno-unused-parameter",
        "-Wno-format-truncation",
    ],
    linkopts = [
        "-lSDL2",
        "-lSDL2_ttf",
        "-lGL",
        "-lcurl",
        "-lpthread",
        "-lm",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":webview_gtk"],
)

# Embedded WebView (WebKitGTK in an X11 child window). Isolated in its own
# library so only this translation unit pulls in the GTK/WebKit headers. The
# include dirs are the (broken-on-SteamOS) `pkg-config --cflags webkit2gtk-4.1
# gtk+-3.0` set, hardcoded; the renderer falls back to a system-browser card at
# runtime when WebKitGTK is unavailable (Wayland / not installed). Built with the
# system C toolchain on a Linux host.
cc_library(
    name = "webview_gtk",
    srcs = ["webview_linux.c"],
    hdrs = ["webview_linux.h"],
    copts = [
        "-std=c11",
        "-D_REENTRANT",
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
        "-isystem",
        "/usr/include/webkitgtk-4.1",
        "-isystem",
        "/usr/include/gtk-3.0",
        "-isystem",
        "/usr/include/glib-2.0",
        "-isystem",
        "/usr/include/cairo",
        "-isystem",
        "/usr/include/pango-1.0",
        "-isystem",
        "/usr/include/harfbuzz",
        "-isystem",
        "/usr/include/gdk-pixbuf-2.0",
        "-isystem",
        "/usr/include/atk-1.0",
        "-isystem",
        "/usr/include/freetype2",
        "-isystem",
        "/usr/include/libpng16",
        "-isystem",
        "/usr/include/fribidi",
        "-isystem",
        "/usr/include/libsoup-3.0",
        "-isystem",
        "/usr/include/at-spi2-atk/2.0",
        "-isystem",
        "/usr/include/at-spi-2.0",
        # glibconfig.h (/usr/lib/glib-2.0/include) and dbus-arch-deps.h
        # (/usr/lib/dbus-1.0/include) come in via C_INCLUDE_PATH (see .bazelrc) —
        # Bazel rejects absolute -I paths outside /usr/include.
    ],
    linkopts = [
        "-lwebkit2gtk-4.1",
        "-lgtk-3",
        "-lgdk-3",
        "-lgobject-2.0",
        "-lglib-2.0",
        "-lgio-2.0",
        "-lX11",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

# The bridging header is imported so the Swift host can call the C renderer API.
_LINUX_COPTS = [
    "-import-objc-header",
    "$(location renderer.h)",
]

# The SwiftUI reimplementation for Linux: the shared core plus the SDL2/OpenGL
# host bridge, compiled as a module named `SwiftUI` (see the wasm/Android/Windows
# counterparts) so application code can `import SwiftUI` unchanged.

one_configuration(
    name = "core",
    actual = "@swiftpkg_isomer//:SwiftUI",
    target_compatible_with = ["@platforms//os:linux"],
)

# The GPU renderer (SwiftGPURenderer.swift, which draws everything through
# swift_gpu's OpenGL backend): a module of its own over the SwiftUI above, which
# the host plugs in. With a SwiftMap engine (the map engine flag:
# //shared/BUILD.bazel), `Map` draws real tiles.
swift_library(
    name = "gpu_renderer",
    package_name = "isomer",
    srcs = ["//shared/renderers:SwiftGPURenderer.swift"],
    copts = ["-DISOMER_GPU_RENDERER_MODULE"],
    module_name = "IsomerGPURenderer",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":core",
        "//shared/isomer_swift_ui",
        "//swift_gpu/linux:swift_gpu",
        "//shared:map_engine_linux",
    ],
)

# Linux's host (LinuxHost.swift, over the C renderer's SDL2 window): a module
# of its own over the SwiftUI above, reaching the runtime's `package` plumbing
# as a module of Isomer's package. It defines `iso_process_host_run`
# (shared/swift_ui_core/App.swift); the wasm cell
# (//linux/libraries/swift_ui_wasm) runs its window through it too.
swift_library(
    name = "host",
    package_name = "isomer",
    srcs = ["LinuxHost.swift"],
    alwayslink = True,
    copts = _LINUX_COPTS,
    module_name = "IsomerLinuxHost",
    swiftc_inputs = ["renderer.h"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":gpu_renderer",
        ":core",
        ":renderer",
        "//linux/libraries/image_io",
        "//shared/isomer_swift_ui",
        "//swift_gpu/linux:swift_gpu",
        "//shared:map_engine_linux",
    ],
)

# SwiftUI with Linux's host: what Linux's apps and the modules over SwiftUI
# here depend on.
swift_library_group(
    name = "swift_ui",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":core",
        ":host",
    ],
)

# The wasm delivery cell (//linux/libraries/swift_ui_wasm) builds
# `LinuxWasmHost.swift` over this package's SwiftUI and host, calling the C
# renderer too.
exports_files([
    "LinuxWasmHost.swift",
    "renderer.h",
])

# Core native-bridging API (logging, clock, URLs), Linux implementation.
# What Isomer provides beyond Apple's SwiftUI API (see
# //shared/swift_ui_extensions).
swift_library(
    name = "isomer",
    package_name = "isomer",
    srcs = [
        "//shared/isomer:Bridge.swift",
        "//shared/isomer:Exports.swift",
        "//shared/swift_ui_extensions:srcs",
    ],
    module_name = "Isomer",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":swift_ui",
        "//swift_ffi/swift_ffi",
        "//shared/isomer_swift_ui",
    ],
)

# PhotosUI's SwiftUI photo picker, over this SwiftUI (//frameworks), as on
# the web and Android. Its picker is a request to the host, which this
# self-drawing renderer doesn't run yet: here it picks nothing, as
# `fileImporter` doesn't.
one_configuration(
    name = "photos_ui",
    actual = "@swiftpkg_isomer//:PhotosUI",
    target_compatible_with = ["@platforms//os:linux"],
)

# What an application builds against (@isomer//:swift_ui): SwiftUI, the
# other Apple frameworks it may import beside it (PhotosUI,
# UniformTypeIdentifiers), and the Isomer module (Isomer's additions: `#if
# canImport(Isomer) import Isomer` in code that also builds against Apple's
# frameworks), as on the web and Android. A Swift package configured over @isomer//:swift_ui sees both.
swift_library_group(
    name = "sdk",
    deps = [
        ":isomer",
        ":photos_ui",
        ":swift_ui",
        "//frameworks/uniform_type_identifiers",
        "//linux/libraries/image_io",
    ],
)
