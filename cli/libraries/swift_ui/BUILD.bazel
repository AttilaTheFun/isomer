load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_swift//swift:swift_library_group.bzl", "swift_library_group")
load("//swift_ui_macros:defs.bzl", "SWIFT_UI_MACROS_PLUGINS")

package(default_visibility = ["//visibility:public"])

# The CLI platform module: the shared core + renderers compiled for the HOST
# (macOS / Linux) plus the TerminalRenderer and its keyboard run loop. Same
# `import SwiftUI` as every other platform; a CLI app is an `@main App`, whose
# `main()` runs the terminal.
#
# Its own package for the same reason as the other platform SwiftUI twins:
# the `SwiftUI.swiftmodule` output must not collide with another module of
# the same name in one build.
swift_library(
    name = "swift_ui",
    package_name = "isomer",
    srcs = [
        "//shared/renderers:srcs_no_gpu",
        "//shared/swift_ui_core:srcs",
    ],
    module_name = "SwiftUI",
    deps = [
        "//shared/isomer_swift_ui",
        "@flatbuffers//swift",
        "//frameworks:for_core",
    ],
    plugins = SWIFT_UI_MACROS_PLUGINS,
)

# The terminal host and its renderer (TerminalApp.swift, TerminalRenderer.swift):
# a module of its own over the SwiftUI above. It defines
# `iso_process_host_run`, so a binary that links it runs in the terminal
# (shared/swift_ui_core/App.swift).
swift_library(
    name = "host",
    package_name = "isomer",
    srcs = [
        "TerminalApp.swift",
        "TerminalRenderer.swift",
    ],
    alwayslink = True,
    module_name = "IsomerTerminalHost",
    deps = [
        ":swift_ui",
        "//shared/isomer_swift_ui",
        "@flatbuffers//swift",
    ],
)

# What a terminal app builds against: SwiftUI and its host.
swift_library_group(
    name = "sdk",
    deps = [
        ":host",
        ":swift_ui",
    ],
)
