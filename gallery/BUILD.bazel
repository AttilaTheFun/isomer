load("@rules_swift//swift:swift.bzl", "swift_library")

# The Gallery (gallery/Gallery.swift): Isomer's apps and components, the
# screens the Isomer app (playground/) lists as a section and its proof
# shows on every platform. One library for every platform: the root's
# aliases pick Apple's SwiftUI or Isomer's for the configuration it is
# built in (an app's platform, a wasm reactor's, a compiled feature's).
# It is an application's code: no `package_name`, nothing of Isomer's
# plumbing.

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "gallery",
    srcs = glob(["*.swift"]),
    module_name = "Gallery",
    deps = [
        "//:foundation",
        "//:isomer",
        "//:swift_ui",
        "//shared/platform_services",
    ],
)

# The images the Gallery's screens name. The same PNGs ship on every
# platform: the web site's assets/ and the APK's assets/ take the flat
# files; an Apple bundle takes the asset catalog (SwiftUI's Image(_:)
# reads it).
filegroup(
    name = "assets",
    srcs = glob(["assets/**/*.png"]),
)

filegroup(
    name = "xcassets",
    srcs = glob(["assets/Assets.xcassets/**"]),
)
